// Binary layout: struct → bytes → record round-trip.
//
// Run it:
//
//     xur run example/reflect/parse_bytes.xur
//
// Defines a packet header struct with layout attributes, constructs
// one, serializes it to bytes, then parses those bytes back and
// asserts the round-trip is correct.

use std::io;
use std::reflect;
use std::assert;

#[repr(packed)]
#[endian(Big)]
struct PacketHeader {
    version: u8
    kind: u8
    length: u16
    sequence: u32
    #[field(size = 4)] tag: bytes
    checksum: u16
}

fn main() -> Result<()> {
    let layout = reflect::layout::<PacketHeader>();
    io::println("Layout: {}", layout);
    io::println("Size:   {} bytes", layout.size());

    // Construct a header and serialize it.
    let header = PacketHeader {
        version: 1,
        kind: 0x10,
        length: 64,
        sequence: 1001,
        tag: b"PING",
        checksum: 0xabcd
    };
    let data = layout.to_bytes(header);
    io::println("Encoded: {}", data.to_hex());

    // Parse the bytes back and verify the round-trip.
    let parsed = layout.from_bytes(data);
    assert::is_eq(parsed.version, 1);
    assert::is_eq(parsed.kind, 0x10);
    assert::is_eq(parsed.length, 64);
    assert::is_eq(parsed.sequence, 1001);
    assert::is_eq(parsed.tag, b"PING");
    assert::is_eq(parsed.checksum, 0xabcd);
    io::println("Field assertions: ok");

    // Serialize the parsed record back and check the bytes match.
    let data2 = layout.to_bytes(parsed);
    assert::is_eq(data, data2);
    io::println("Byte-level round-trip: ok");

    // Parse the same bytes twice and compare the records directly.
    let a = layout.from_bytes(data);
    let b = layout.from_bytes(data2);
    assert::is_true(a == b);
    io::println("Record equality: ok");

    // Runtime-built layout with record literals.
    let pair_layout = reflect::Layout::new("Pair")
        .field("x", "i32")
        .field("y", "i32");

    let pair_bytes = pair_layout.to_bytes(@{ x: 42, y: -1 });
    let pair = pair_layout.from_bytes(pair_bytes);
    assert::is_eq(pair.x, 42);
    assert::is_eq(pair.y, -1);

    let pair_bytes2 = pair_layout.to_bytes(pair);
    assert::is_eq(pair_bytes, pair_bytes2);
    io::println("Pair round-trip: ok");

    Ok(())
}
