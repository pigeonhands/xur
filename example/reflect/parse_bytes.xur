// Binary layout: struct → bytes → record round-trip.
//
// Run it:
//
//     xur run example/reflect/parse_bytes.xur
//
// Defines a packet header struct with layout attributes, constructs
// one, serializes it to bytes, then parses those bytes back.

use std::io;
use std::reflect;

#[repr(packed)]
#[endian(Big)]
struct PacketHeader {
    version: u8
    kind: u8
    length: u16
    sequence: u32
    #[field(size = 4)] tag: bytes
    checksum: u16
}

fn main() -> Result<()> {
    let layout = reflect::layout::<PacketHeader>();
    io::println("Layout: {}", layout);
    io::println("Size:   {} bytes", layout.size());
    io::println("");

    for f in layout.fields() {
        io::println("  +{}  {}  {}", f.offset, f.name, f.ty);
    }
    io::println("");

    // Construct a header and serialize it.
    let header = PacketHeader {
        version: 1,
        kind: 0x10,
        length: 64,
        sequence: 1001,
        tag: b"PING",
        checksum: 0xabcd
    };
    let data = layout.to_bytes(header);
    io::println("Encoded: {}", data.to_hex());

    // Parse the bytes back into a record.
    let parsed = layout.from_bytes(data);
    io::println("Decoded:");
    io::println("  version  = {}", parsed.version);
    io::println("  kind     = {}", parsed.kind);
    io::println("  length   = {}", parsed.length);
    io::println("  sequence = {}", parsed.sequence);
    io::println("  tag      = {}", parsed.tag);
    io::println("  checksum = {}", parsed.checksum);
    io::println("");

    // Also works the other way: build a layout at runtime and write
    // a record literal into it.
    let runtime_layout = reflect::Layout::new("Pair")
        .field("x", "i32")
        .field("y", "i32");

    let pair_bytes = runtime_layout.to_bytes(@{ x: 42, y: -1 });
    io::println("Pair bytes: {}", pair_bytes.to_hex());

    let pair = runtime_layout.from_bytes(pair_bytes);
    io::println("Pair back:  x={}, y={}", pair.x, pair.y);

    Ok(())
}
