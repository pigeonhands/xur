// Function reflection with `std::reflect::func`: inspect the name,
// parameter count, names, types, and return type of any function
// at runtime.
//
//     xur run example/reflect/func.xur

use std::io;
use std::reflect::func;

fn add(x: u32, y: u32) -> u32 { x + y }

fn greet(name: str) -> str { "hello, " + name }

fn nothing() {}

fn show(f: _) {
    io::println("  name:        {}", func::name(f));
    io::println("  params:      {}", func::params(f));
    io::println("  param_names: {}", func::param_names(f));
    io::println("  param_types: {}", func::param_types(f));
    io::println("  return_type: {}", func::return_type(f));
}

fn main() -> Result<()> {
    io::println("--- add ---");
    show(add);

    io::println("\n--- greet ---");
    show(greet);

    io::println("\n--- nothing ---");
    show(nothing);

    // Closures carry reflection data too.
    let double = |n: i64| -> i64 { n * 2 };
    io::println("\n--- closure ---");
    show(double);

    // Type values from param_types can be compared.
    io::println("\n--- type comparison ---");
    let types = func::param_types(add);
    io::println("  add's first param is u32: {}", types[0] == u32);
    io::println("  add takes {} params", func::params(add));
    io::println("  nothing takes {} params", func::params(nothing));

    Ok(())
}
