// `std::re::AnyImage`: reading an executable by virtual address, the way it
// looks once a loader has mapped it, over either PE or ELF.
//
// Run it:
//
//     xur run example/re_image.xur
//
// It builds a tiny PE in memory (so the example needs no sample file), then
// loads it as an image and reads it purely by virtual address: the kind of
// thing a scanner walking a mapped binary does.

use std::io;
use std::re;
use std::re::pe;
use std::re::pe::ImageFileMachine;
use std::re::ExportLocation;

fn main() {
    // A 64-bit DLL exporting two functions, so there is something to find.
    let def = pe::ImageDef::new_dll(ImageFileMachine::Amd64);
    let flags = pe::section_flags(["CNT_CODE", "MEM_EXECUTE", "MEM_READ"]).unwrap();
    let answer = def.add_section(".text", flags, b"\xb8\x2a\x00\x00\x00\xc3"); // mov eax,42; ret
    let nop = def.add_section(".stub", flags, b"\x90\xc3");                    // nop; ret
    def.add_exports("demo.dll", [("answer", answer), ("stub", nop)]);
    let bytes = def.write().unwrap();

    // Load it as an image. `AnyImage` detects PE vs ELF; the same methods
    // work for both.
    let image = re::AnyImage::load(bytes).unwrap();
    io::println("format: {}, {}-bit, pointers {} bytes", image.format(), if image.is_64() { 64 } else { 32 }, image.pointer_size());
    io::println("machine: {}, base {}", image.machine(), image.image_base().unwrap().to_hex());

    // Walk the exports and read each function's first bytes by its virtual
    // address, following a forwarder if there is one.
    for export in image.exports().unwrap() {
        let name = export.name.unwrap();
        match export.location {
            ExportLocation::Address(vaddr) => {
                io::println("{} at {}: first byte {}", name, vaddr.to_hex(), image.u8(vaddr).unwrap().to_hex());
                io::println("  mapped? {}", image.is_mapped(vaddr));
            }
            ExportLocation::Forwarder(target) => io::println("{} -> {}", name, target),
        }
    }

    // `as_pe` gives the parsed PE back (with all its facet fields); `as_elf`
    // would give the ELF for an ELF image. They share the image's bytes.
    let pe = image.as_pe().unwrap();
    io::println("{} sections, entry at {}", pe.coff_header.number_of_sections, pe.entry_point().to_hex());
    io::println("is elf? {}", image.as_elf().is_some());
}
