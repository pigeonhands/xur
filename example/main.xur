#!/usr/bin/env -S cargo run --
use std::io;
use std::io::c;
use std::fs;
use std::cli;
use std::path;
use std::sync;
use std::thread;

fn run_example(p: str) -> Result<()> {
    let module = std::try_import(p)?;
    let main = module.get_method("main", fn() -> Result<()>)?;
    main()
}


fn all_examples() -> [str] {
    // Categories skipped: interactive input, network listeners,
    // or external targets (reverse-engineering tools).
    let skip = ["cli", "net", "re", "stub"];
    let entries = fs::read_dir("example").unwrap();
    let folders: [str] = entries.filter(|e| !e.ends_with(".xur"));
    let examples = [];
    for folder in folders {
        if skip.contains(folder) {
            continue;
        }
        let dir: str = path::join("example", folder);
        let files = fs::read_dir(dir).unwrap();
        for file in files.filter(|e| e.ends_with(".xur")) {
            examples.push(path::join(folder, file));
        }
    }
    examples
}

enum ExampleResult {
    Skipped(str, str)
    Passed(str)
    Failed(str, str)
}

fn fmt_name(name: str) -> str {
    let parts = name.split("/");
    if parts.len() == 2 {
        c::dim(parts[0] + "/") + c::bold(parts[1])
    } else {
        c::bold(name)
    }
}

fn folder_of(name: str) -> str {
    let parts = name.split("/");
    if parts.len() >= 2 { parts[0] } else { "" }
}

fn try_run(example: str) -> ExampleResult {
    let module = match std::try_import(example) {
        Ok(m) => m,
        Err(e) => return ExampleResult::Skipped(example, e.to_string()),
    };
    let main = match module.get_method("main", fn() -> Result<()>) {
        Ok(f) => f,
        Err(_) => return ExampleResult::Skipped(example, "no main() -> Result<()>"),
    };
    match main() {
        Ok(_) => ExampleResult::Passed(example),
        Err(e) => ExampleResult::Failed(example, e.to_string()),
    }
}

fn test_all() {
    let examples = all_examples();
    let (tx, rx) = sync::channel();
    let total = examples.len();

    for example in examples {
        let tx = tx;
        thread::spawn(|| {
            tx.send(try_run(example)).unwrap();
        });
    }

    let results = [];
    let total_passed = 0;
    let total_failed = 0;
    let total_skipped = 0;

    for _ in examples {
        let r = rx.recv().unwrap();
        results.push(r);
        match r {
            ExampleResult::Passed(_) => total_passed = total_passed + 1,
            ExampleResult::Failed(_, _) => total_failed = total_failed + 1,
            ExampleResult::Skipped(_, _) => total_skipped = total_skipped + 1,
        }
    }

    // Build per-folder rows and detail lines.
    let folders = #{};
    let failures = [];
    for r in results {
        let name = match r {
            ExampleResult::Passed(n) => n,
            ExampleResult::Failed(n, _) => n,
            ExampleResult::Skipped(n, _) => n,
        };
        let folder = folder_of(name);
        if !folders.contains_key(folder) {
            folders[folder] = #{ "pass": 0, "fail": 0, "skip": 0 };
        }
        let counts = folders[folder];
        match r {
            ExampleResult::Passed(_) => counts["pass"] = counts["pass"] + 1,
            ExampleResult::Failed(_, err) => {
                counts["fail"] = counts["fail"] + 1;
                failures.push(std::fmt::format("  {} {}: {}", c::red("FAIL"), fmt_name(name), err));
            }
            ExampleResult::Skipped(_, _) => counts["skip"] = counts["skip"] + 1,
        }
    }

    // Print failures first so the table is the last thing visible.
    for line in failures {
        io::println("{}", line);
    }
    if failures.len() > 0 {
        io::println("");
    }

    // Build table rows: one per folder.
    let rows = [];
    for entry in folders.entries() {
        let (folder, counts) = entry;
        let p = counts["pass"];
        let f = counts["fail"];
        let s = counts["skip"];
        let pass_str = if p > 0 { c::green(p.to_string()) } else { c::dim("0") };
        let fail_str = if f > 0 { c::red(f.to_string()) } else { c::dim("0") };
        let skip_str = if s > 0 { c::yellow(s.to_string()) } else { c::dim("0") };
        rows.push([c::bold(folder), pass_str, fail_str, skip_str]);
    }
    rows.push([
        c::bold("total"),
        c::green(total_passed.to_string()),
        if total_failed > 0 { c::red(total_failed.to_string()) } else { c::dim("0") },
        if total_skipped > 0 { c::yellow(total_skipped.to_string()) } else { c::dim("0") },
    ]);

    let summary = cli::table(
        ["", c::green("Pass"), c::red("Fail"), c::yellow("Skip")],
        rows,
    );
    io::println("{}", summary);

    if total_failed > 0 {
        std::panic("{} example(s) failed", total_failed);
    }
}

fn main() -> Result<()> {
    let args = std::argv();

    if args.len() == 2 && args[1] == "--test-all" {
        test_all();
        return Ok(());
    }

    if args.len() == 2 {
        let [_, example] = args;
        return run_example(example);
    }

    if args.len() > 2 {
        io::eprintln("usage: xur run example [<example>] [--test-all]");
        return Err("bad usage");
    }

    // Interactive mode: pick a category, then an example.
    let entries = fs::read_dir("example")?;
    let folders: [str] = entries.filter(|e| !e.ends_with(".xur"));

    let folder = cli::select("Pick a category:", folders);

    let dir: str = path::join("example", folder);
    let files = fs::read_dir(dir)?;
    let examples: [str] = files.filter(|e| e.ends_with(".xur"));

    let file = cli::select("Pick an example:", examples);

    run_example(path::join(folder, file))
}
