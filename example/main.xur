use std::io;
use std::fs;
use std::cli;
use std::path;
use std::sync;
use std::thread;

fn run_example(p: str) -> Result<()> {
    let module = std::try_import(p)?;
    let main = module.get_method("main", fn() -> Result<()>)?;
    main()
}

fn all_examples() -> [str] {
    // Categories skipped: interactive input, network listeners,
    // or external targets (reverse-engineering tools).
    let skip = ["cli", "net", "re", "stub"];
    let entries = fs::read_dir("example").unwrap();
    let folders = entries.filter(|e| !e.ends_with(".xur"));
    let examples = [];
    for folder in folders {
        if skip.contains(folder) {
            continue;
        }
        let dir = path::join("example", folder);
        let files = fs::read_dir(dir).unwrap();
        for file in files.filter(|e| e.ends_with(".xur")) {
            examples = examples + [path::join(folder, file)];
        }
    }
    examples
}

enum ExampleResult {
    Skipped(str, str)
    Passed(str)
    Failed(str, str)
}

fn fmt_name(name: str) -> str {
    let parts = name.split("/");
    if parts.len() == 2 {
        io::dim(parts[0] + "/") + io::bold(parts[1])
    } else {
        io::bold(name)
    }
}

fn test_all() {
    let examples = all_examples();
    let (tx, rx) = sync::channel();
    let total = examples.len();

    for example in examples {
        let tx = tx;
        thread::spawn(|| {
            match std::try_import(example) {
                Err(e) => {
                    tx.send(ExampleResult::Skipped(example, e.to_string())).unwrap();
                }
                Ok(module) => {
                    match module.get_method("main", fn() -> Result<()>) {
                        Err(_) => {
                            tx.send(ExampleResult::Skipped(example, "no main() -> Result<()>")).unwrap();
                        }
                        Ok(main) => {
                            match main() {
                                Ok(_) => tx.send(ExampleResult::Passed(example)).unwrap(),
                                Err(e) => tx.send(ExampleResult::Failed(example, e.to_string())).unwrap(),
                            }
                        }
                    }
                }
            }
        });
    }

    let passed = 0;
    let failed = 0;
    let skipped = 0;
    for _ in examples {
        match rx.recv().unwrap() {
            ExampleResult::Skipped(name, reason) => {
                io::println("  {} {}: {}", io::yellow("skip"), fmt_name(name), io::dim(reason));
                skipped = skipped + 1;
            }
            ExampleResult::Passed(name) => {
                io::println("  {}   {}", io::green("ok"), fmt_name(name));
                passed = passed + 1;
            }
            ExampleResult::Failed(name, err) => {
                io::println("  {} {}: {}", io::red("FAIL"), fmt_name(name), err);
                failed = failed + 1;
            }
        }
    }

    io::println("");
    let summary = cli::table(
        ["", "Count"],
        [
            [io::green("Passed"), passed.to_string()],
            [io::red("Failed"), failed.to_string()],
            [io::yellow("Skipped"), skipped.to_string()],
            [io::bold("Total"), total.to_string()],
        ],
    );
    io::println("{}", summary);

    if failed > 0 {
        std::panic("{} example(s) failed", failed);
    }
}

fn main() -> Result<()> {
    let args = std::argv();

    if args.len() == 2 && args[1] == "--test-all" {
        test_all();
        return Ok(());
    }

    if args.len() == 2 {
        let [_, example] = args;
        return run_example(example);
    }

    if args.len() > 2 {
        io::eprintln("usage: xur run example [<example>] [--test-all]");
        return Err("bad usage");
    }

    // Interactive mode: pick a category, then an example.
    let entries = fs::read_dir("example")?;
    let folders = entries.filter(|e| !e.ends_with(".xur"));

    let folder = cli::select("Pick a category:", folders);

    let files = fs::read_dir(path::join("example", folder))?;
    let examples = files.filter(|e| e.ends_with(".xur"));

    let file = cli::select("Pick an example:", examples);

    run_example(path::join(folder, file))
}
