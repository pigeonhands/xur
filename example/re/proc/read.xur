// Reading a process's memory by address.
//
//     xur run example/re/proc/read.xur

use std::io;
use std::re::proc;

fn main() -> Result<()> {
    let handle = proc::open_current()?;
    let base = handle.modules()?[0].base;
    io::println("bytes at {}: {}", base.to_hex(), handle.read(base, 4)?.to_hex());
    Ok(())
}
