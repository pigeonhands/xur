// Listing a process's loaded modules with `std::re::proc`.
//
//     xur run example/re/proc/modules.xur   (inspects this process)

use std::io;
use std::re::proc;

fn main() -> Result<(), str> {
    let handle = proc::open_current()?;
    let modules = handle.modules()?;
    io::println("{} modules; main = {}", modules.len(), modules[0].name);
    Ok(())
}
