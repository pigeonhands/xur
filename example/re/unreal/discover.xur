// Unreal Engine object discovery — run via LD_PRELOAD into a UE game.
//
// This script initialises the unrealkit SDK by AOB-scanning the game's
// main module, then dumps the first 50 UObjects and inspects one class.
//
// Usage (Linux/Proton):
//   LD_PRELOAD=target/release/libxur_stub.so %command%
//   (set as Steam launch options, with this script as the entry point)

use std::stub::unreal;
use std::io;
use std::re::proc;

fn main() {
    // Auto-discover GNames + GObjects by scanning the main module.
    // Change the version to 4 for UE4 games.
    let version = 5;
    let handle = proc::open_current().unwrap();
    let main_mod = handle.modules().unwrap()[0];
    let sdk = unreal::init(version, main_mod.base, main_mod.size).unwrap();
    io::println("SDK initialised");

    // Dump the first 50 objects.
    io::println("=== UObject dump (first 50) ===");
    let count = 0;
    for obj in unreal::objects() {
        io::println(obj.full_name());
        count = count + 1;
        if count >= 50 { break; }
    }
    io::println("{} objects listed", count);

    // Find a specific object by short name.
    let found = unreal::find_object("GameEngine");
    match found {
        Some(obj) => {
            io::println("found: {}", obj.full_name());
            let cls = obj.class();
            io::println("  class: {}", cls.name());
            io::println("  instance size: {} bytes", cls.instance_size());
            io::println("  hierarchy: {}", cls.hierarchy());
        }
        None => io::println("GameEngine not found"),
    }

    // Dump properties of a class.
    io::println("=== Properties ===");
    match found {
        Some(obj) => {
            let cls = obj.class();
            io::println("properties of {}:", cls.name());
            for p in cls.all_properties() {
                io::println("  {} : {} @ offset {}", p.name(), p.type_name(), p.offset());
            }

            // Read a property by name (shorthand).
            // let hp = obj.get("Health");
            // io::println("health = {}", hp);

            // Write a property by name.
            // obj.set("Health", 999.0);

            // Or via the property handle:
            // let prop = cls.property("Health").unwrap();
            // let val = prop.read(obj);
            // prop.write(obj, 999.0);
        }
        None => io::println("(skipped — no object found)"),
    }

    // Dump functions of a class.
    io::println("=== Functions ===");
    match found {
        Some(obj) => {
            let cls = obj.class();
            io::println("functions of {}:", cls.name());
            for f in cls.all_methods() {
                io::println("  {}", f.signature());
            }

            // Call a function via ProcessEvent:
            // unreal::set_process_event_vtable(68);  // discover from vtable
            // let func = cls.method("SomeFunction").unwrap();
            // let result = func.invoke(obj, arg1, arg2);

            // Hook a native UFunction (returns original fn pointer):
            // let orig = func.hook(my_detour_addr);
            // The hook is permanent — the detour runs instead of the original.
        }
        None => io::println("(skipped — no object found)"),
    }

    // List all actors (objects whose class inherits AActor).
    io::println("=== Actors ===");
    let actors = unreal::find_objects_by_class("Actor");
    for a in actors {
        io::println("  {}", a.full_name());
    }
}
