// Unreal Engine object discovery — run via LD_PRELOAD into a UE game.
//
// This script initialises the unrealkit SDK by AOB-scanning the game's
// .text section, then dumps the first 50 UObjects and inspects one class.
//
// Usage (Linux/Proton):
//   LD_PRELOAD=target/release/libxur_stub.so %command%
//   (set as Steam launch options, with this script as the entry point)

use std::stub::unreal;
use std::io;
use std::mem;

fn main() {
    // Auto-discover GNames + GObjects by scanning the .text section.
    // Change the version to 4 for UE4 games.
    let version = 5;
    let text = mem::find_module_section(".text");
    let sdk = unreal::init(version, text.base, text.size).unwrap();
    io::println("SDK initialised");

    // Dump the first 50 objects.
    io::println("=== UObject dump (first 50) ===");
    let count = 0;
    for obj in unreal::objects() {
        io::println(obj.full_name());
        count = count + 1;
        if count >= 50 { break; }
    }
    io::println("{} objects listed", count);

    // Find a specific object by short name.
    let found = unreal::find_object("GameEngine");
    match found {
        Some(obj) => {
            io::println("found: {}", obj.full_name());
            let cls = obj.class();
            io::println("  class: {}", cls.name());
            io::println("  instance size: {} bytes", cls.instance_size());
            io::println("  hierarchy: {}", cls.hierarchy());
        }
        None => io::println("GameEngine not found"),
    }

    // List all actors (objects whose class inherits AActor).
    io::println("=== Actors ===");
    let actors = unreal::find_objects_by_class("Actor");
    for a in actors {
        io::println("  {}", a.full_name());
    }
}
