use std::io;

fn main() -> Result<()> {
    // folder import: loads ./my_plugin/lib.xur
    let plugin = std::import("./my_plugin");

    // get_method: returns Ok(fn) or Err(message)
    io::println("--- get_method ---");
    let exec = plugin.get_method("exec")?;
    io::println("got exec: {}", exec);
    exec(42);

    // get_method with param count check
    let add = plugin.get_method("add", 2)?;
    io::println("add(3, 4) = {}", add(3, 4));

    // get_method with fn type signature check
    let add2 = plugin.get_method("add", fn(i32, i32) -> i32)?;
    io::println("add2(10, 20) = {}", add2(10, 20));

    // wrong fn type signature (right param count, wrong types)
    let bad_sig = plugin.get_method("add", fn(str, str) -> str);
    io::println("add with wrong sig: {}", bad_sig);

    // wildcard signature: match param count, ignore types
    let add3 = plugin.get_method("add", fn(_, _) -> _)?;
    io::println("add3(100, 200) = {}", add3(100, 200));

    // wrong param count
    let bad = plugin.get_method("add", 1);
    io::println("add with 1 param: {}", bad);

    // missing method
    let missing = plugin.get_method("nope");
    io::println("missing method: {}", missing);

    // get_attr: returns Ok(value) or Err(message)
    io::println("");
    io::println("--- get_attr ---");
    let attr = plugin.get_attr("my_attr")?;
    io::println("my_attr = {}", attr);

    // function is not an attr
    let bad_attr = plugin.get_attr("exec");
    io::println("exec as attr: {}", bad_attr);

    // missing attr
    let missing_attr = plugin.get_attr("nope");
    io::println("missing attr: {}", missing_attr);

    // try_import: returns Result instead of panicking
    io::println("");
    io::println("--- try_import ---");
    let good = std::try_import("./my_plugin");
    io::println("existing: {}", good.is_ok());
    let bad = std::try_import("./nonexistent");
    io::println("missing: {}", bad);

    Ok(())
}
