use std::io;
use std::env;
use std::assert;

fn main() -> Result<()> {
    // set and get an env var
    env::set("XUR_TEST_VAR", "hello");
    assert::is_eq(env::get("XUR_TEST_VAR"), Some("hello"));

    // update it
    env::set("XUR_TEST_VAR", "world");
    assert::is_eq(env::get("XUR_TEST_VAR"), Some("world"));

    // remove it
    env::remove("XUR_TEST_VAR");
    assert::is_eq(env::get("XUR_TEST_VAR"), None);

    // missing var returns None
    assert::is_eq(env::get("XUR_DOES_NOT_EXIST_12345"), None);

    // current_dir returns something
    let dir = env::current_dir()?;
    assert::is_true(dir.len() > 0);
    io::println("cwd: {}", dir);

    // exe_path returns something
    let exe = env::exe_path();
    assert::is_true(exe.is_some());
    io::println("exe: {}", exe.unwrap());

    // vars returns a list
    let all = env::vars();
    assert::is_true(all.len() > 0);
    io::println("env vars: {} total", all.len());

    io::println("env: all assertions passed");
    Ok(())
}
