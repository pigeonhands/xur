// Struct coercion with `as`: convert between struct types by field name.
// Missing fields with Option types are filled with None.
// #[coerce(strict)] requires all fields to be present.
//
//     xur run example/lang/coerce.xur

use std::io;
use std::any;

struct Data {
    a: str
    b: str
    c: Option<str>
}

#[coerce(strict)]
struct StrictData {
    a: str
    b: str
    c: Option<str>
}

struct SmallData {
    a: str
    b: str
}

fn main() {
    let small_data = SmallData {
        a: "this is a",
        b: "this is b",
    };

    // coerce ok — missing `c: Option<str>` is filled with None
    let data = small_data as Data;
    io::println("data: {}", data);

    // coerce between structs with matching fields
    let full_data = Data {
        a: "hello",
        b: "world",
        c: Some("!"),
    };
    let strict_data = full_data as StrictData;
    io::println("strict (from full): {}", strict_data);

    // strict coercion failure caught with try_cast
    let result = any::try_cast::<StrictData>(small_data);
    match result {
        Ok(v) => io::println("unexpected success: {}", v),
        Err(e) => io::println("strict coercion failed (expected): {}", e),
    }

    let Ok(truncated_data) = any::try_cast::<SmallData>(full_data)?;
    io::println("small (from full): {}", truncated_data);

    // convert to untyped record, then let the type annotation coerce it
    let small_from_record: SmallData = any::record(full_data);
    io::println("small (from record): {}", small_from_record);
}
