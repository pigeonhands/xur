use std::io;
use std::assert;

fn main() -> Result<()> {
    // -- sort / sort_by ------------------------------------------------------

    let nums = [3, 1, 4, 1, 5, 9, 2, 6];
    assert::is_eq(nums.sort(), [1, 1, 2, 3, 4, 5, 6, 9]);

    let words = ["banana", "apple", "cherry"];
    assert::is_eq(words.sort(), ["apple", "banana", "cherry"]);

    // sort_by: descending order
    let desc = nums.sort_by(|a, b| {
        if a > b { -1 }
        else if a < b { 1 }
        else { 0 }
    });
    assert::is_eq(desc, [9, 6, 5, 4, 3, 2, 1, 1]);

    // -- find / find_index ---------------------------------------------------

    let items = [10, 20, 30, 40, 50];
    assert::is_eq(items.find(|x| x > 25), Some(30));
    assert::is_eq(items.find(|x| x > 100), None);

    assert::is_eq(items.find_index(|x| x == 30), Some(2));
    assert::is_eq(items.find_index(|x| x == 99), None);

    // -- any / all -----------------------------------------------------------

    assert::is_eq([1, 2, 3].any(|x| x > 2), true);
    assert::is_eq([1, 2, 3].any(|x| x > 10), false);

    assert::is_eq([2, 4, 6].all(|x| x % 2 == 0), true);
    assert::is_eq([2, 4, 5].all(|x| x % 2 == 0), false);

    // -- reduce --------------------------------------------------------------

    let sum_via_reduce = [1, 2, 3, 4, 5].reduce(|acc, x| acc + x);
    assert::is_eq(sum_via_reduce, 15);

    // -- enumerate -----------------------------------------------------------

    let letters = ["a", "b", "c"];
    let pairs = letters.enumerate();
    assert::is_eq(pairs, [[0, "a"], [1, "b"], [2, "c"]]);

    // -- flatten / flat_map --------------------------------------------------

    let nested = [[1, 2], [3, 4], [5]];
    assert::is_eq(nested.flatten(), [1, 2, 3, 4, 5]);

    // flatten with mixed list / non-list items
    let mixed = [1, [2, 3], 4];
    assert::is_eq(mixed.flatten(), [1, 2, 3, 4]);

    // flat_map: split each string into individual characters... or just double
    let doubled = [1, 2, 3].flat_map(|x| [x, x * 10]);
    assert::is_eq(doubled, [1, 10, 2, 20, 3, 30]);

    // -- slice ---------------------------------------------------------------

    let xs = [10, 20, 30, 40, 50];
    assert::is_eq(xs.slice(1, 3), [20, 30]);
    assert::is_eq(xs.slice(0, 5), [10, 20, 30, 40, 50]);

    // negative indices (Python-style)
    assert::is_eq(xs.slice(-3, -1), [30, 40]);
    assert::is_eq(xs.slice(-2, 5), [40, 50]);

    // empty result when start >= end
    assert::is_eq(xs.slice(3, 1), []);

    // -- dedup ---------------------------------------------------------------

    assert::is_eq([1, 1, 2, 2, 3, 1, 1].dedup(), [1, 2, 3, 1]);
    assert::is_eq(["a", "a", "b"].dedup(), ["a", "b"]);

    // -- sum -----------------------------------------------------------------

    assert::is_eq([1, 2, 3, 4].sum(), 10);
    assert::is_eq([1.5, 2.5, 3.0].sum(), 7.0);

    // -- min / max -----------------------------------------------------------

    assert::is_eq([3, 1, 4, 1, 5].min(), Some(1));
    assert::is_eq([3, 1, 4, 1, 5].max(), Some(5));
    assert::is_eq(["cherry", "apple", "banana"].min(), Some("apple"));
    assert::is_eq(["cherry", "apple", "banana"].max(), Some("cherry"));

    // empty list returns None
    let empty = [];
    assert::is_eq(empty.min(), None);
    assert::is_eq(empty.max(), None);

    // -- zip -----------------------------------------------------------------

    let left = [1, 2, 3];
    let right = ["a", "b", "c"];
    assert::is_eq(left.zip(right), [[1, "a"], [2, "b"], [3, "c"]]);

    // zip with different lengths: truncates to shorter
    assert::is_eq([1, 2].zip(["x", "y", "z"]), [[1, "x"], [2, "y"]]);

    io::println("list_methods: all assertions passed");
    Ok(())
}
