// A simple stub script: runs when the stub is loaded into a process.
//
// Test with:
//     XUR_STUB_PATH=xur-stub/example/hello.xur LD_PRELOAD=target/debug/libxur_stub.so /bin/true

use std::io;
use std::re::proc;

fn main() -> Result<()> {
    let pid = proc::current_pid();
    io::println("[hello.xur] running inside pid {}", pid);

    Ok(())
}
