// Godot scene tree viewer — LD_PRELOAD overlay that shows the game's
// live node hierarchy in an egui window.
//
// Hooks SceneTree._Process from GodotSharp for the per-frame pump —
// works for any Godot game, no game-specific types needed.
//
//     cargo build --release -p xur-stub
//     # Steam > Game > Properties > Launch options:
//     XUR_STUB_PATH=xur-stub/example/godot_scene.xur \
//         LD_PRELOAD=target/release/libxur_stub.so %command%

use std::cell;
use std::fmt;
use std::gui;
use std::log;
use std::stub::coreclr;
use std::stub::godot;
use std::stub::overlay::egui;

// ---------------------------------------------------------------------------
// Scene tree snapshot — captured on the game thread, drawn on the render thread
// ---------------------------------------------------------------------------

pub struct TreeNode {
    name: str
    child_count: i32
    children: [TreeNode]
}

fn capture_node(node: coreclr::ManagedObject, depth: i32) -> TreeNode {
    let name = godot::node_name(node).unwrap_or("?");
    let count = godot::child_count(node).unwrap_or(0);

    let children = [];
    if depth < 6 {
        let i = 0;
        while i < count {
            match godot::child(node, i) {
                Ok(child) => children.push(capture_node(child, depth + 1)),
                Err(_) => {}
            }
            i = i + 1;
        }
    }

    TreeNode { name: name, child_count: count, children: children }
}

fn draw_node(ui: gui::Ui, node: TreeNode, depth: i32) {
    let indent = "";
    let d = 0;
    while d < depth {
        indent = indent + "  ";
        d = d + 1;
    }

    let label = if node.child_count > 0 {
        fmt::format("{}▸ {} ({})", indent, node.name, node.child_count)
    } else {
        fmt::format("{}  {}", indent, node.name)
    };
    ui.small(label);

    for child in node.children {
        draw_node(ui, child, depth + 1);
    }
}

// ---------------------------------------------------------------------------
// Entry points
// ---------------------------------------------------------------------------

fn ctor() {
    log::subscriber().to_file("/tmp/godot-scene.log").truncate().with_max_level(log::Level::Info).init();
    egui::init();
    egui::set_scale(0.75);
    godot::hook_scene_tree();
}

fn stub_main() {
    log::info("Scene tree viewer starting — waiting for CoreCLR...");

    let rt = match godot::init(9) {
        Ok(r) => r,
        Err(e) => {
            log::info(fmt::format("CLR init failed: {}", e));
            return;
        }
    };

    log::info("starting overlay");

    let snapshot: Option<TreeNode> = None;
    let frame_count = cell::new(0);

    // Capture scene tree on the game thread every 60 frames.
    // The bindings resolve lazily on first call (OnceLock) — this is
    // safe because on_process runs on the game thread where the CLR lives.
    godot::on_process(|| {
        let fc = frame_count.get() + 1;
        frame_count.set(fc);

        if snapshot.is_none() || fc % 60 == 0 {
            match godot::root() {
                Ok(root) => snapshot = Some(capture_node(root, 0)),
                Err(e) => {
                    if fc % 300 == 0 {
                        log::info(fmt::format("root() failed: {}", e));
                    }
                }
            }
        }
    });

    let visible = true;
    let f1_down = false;

    // Draw the last captured snapshot on the render thread.
    egui::run(|ctx| {
        let f1 = ctx.key("f1");
        if f1 && !f1_down {
            visible = !visible;
        }
        f1_down = f1;

        if !visible { return; }

        ctx.window_sized("Scene Tree", 450.0, |win| {
            match snapshot {
                Some(tree) => {
                    draw_node(win, tree, 0);
                }
                None => {
                    win.small("waiting for scene tree...");
                }
            }
        });
    });
}
