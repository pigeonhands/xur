// Megabonk — IL2CPP proxy structs and game runtime.

use std::bytes;
use std::cell;
use std::fmt;
use std::mem;
use std::ptr;
use std::stub::hooking;
use std::stub::il2cpp;
use std::stub::il2cpp::il2cpp_proxy;
use std::log;

// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------

pub struct HealthInfo {
    hp: i32
    max_hp: i32
    shield: f32
    max_shield: f32
}

pub struct EnumEntry {
    name: str
    value: i32
}

pub struct UiState {
    gold_amount: cell::Cell<i32>
    weapon_search: cell::Cell<str>
    tome_search: cell::Cell<str>
    item_search: cell::Cell<str>
    timer_value: cell::Cell<f32>
    silver_amount: cell::Cell<i32>
    tab: cell::Cell<i32>
}

impl UiState {
    pub fn new() -> UiState {
        UiState {
            gold_amount: cell::new(10000),
            weapon_search: cell::new(""),
            tome_search: cell::new(""),
            item_search: cell::new(""),
            timer_value: cell::new(0.0),
            silver_amount: cell::new(10000),
            tab: cell::new(0),
        }
    }
}

pub struct HookState {
    enabled: cell::Cell<bool>
}

impl HookState {
    #[default]
    fn default() -> HookState {
        HookState { enabled: cell::new(false) }
    }
}

// ---------------------------------------------------------------------------
// IL2CPP proxy structs
// ---------------------------------------------------------------------------

#[il2cpp_proxy(asm="Assembly-CSharp", ns="Assets.Scripts.Actors.Player", class="MyPlayer")]
struct PlayerProxy {
    #[il2cpp_field="Instance"]
    instance: il2cpp::Field
    #[il2cpp_field="inventory"]
    inventory: il2cpp::Field
}

#[il2cpp_proxy(asm="Assembly-CSharp", ns="Assets.Scripts.Inventory__Items__Pickups", class="PlayerHealth")]
struct HealthProxy {
    #[il2cpp_field="hp"]
    hp: il2cpp::Field
    #[il2cpp_field="maxHp"]
    max_hp: il2cpp::Field
    #[il2cpp_field="shield"]
    shield: il2cpp::Field
    #[il2cpp_field="maxShield"]
    max_shield: il2cpp::Field
    #[il2cpp_method(name="Damage", params=2)]
    damage: il2cpp::Method
    #[il2cpp_method(name="KillPlayer", params=0)]
    kill_player: il2cpp::Method
}

#[il2cpp_proxy]
impl HealthProxy {
    #[il2cpp_hook(method="damage")]
    fn on_damage(ctx: il2cpp::HookContext, state: HookState) -> Option<hooking::Skip> {
        if state.enabled.get() { Some(hooking::Skip()) } else { None }
    }

    #[il2cpp_hook(method="kill_player")]
    fn on_kill(ctx: il2cpp::HookContext, state: HookState) -> Option<hooking::Skip> {
        if state.enabled.get() { Some(hooking::Skip()) } else { None }
    }
}

