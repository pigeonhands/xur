}

#[il2cpp_proxy]
impl LoadingProxy {
    #[il2cpp_hook(method="load_async")]
    fn on_load(ctx: il2cpp::HookContext, state: HookState) -> Option<il2cpp::Object> {
        if state.enabled.get() {
            log::debug("skipping load animation");
            Some(il2cpp::null())
        } else {
            None
        }
    }
}

