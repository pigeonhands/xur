}

#[il2cpp_proxy(asm="Assembly-CSharp", ns="Assets.Scripts.Inventory__Items__Pickups", class="InventoryUtility")]
struct InvUtilProxy {
    #[il2cpp_method(name="GetWeaponMaxLevel", params=0)]
    get_weapon_max: il2cpp::Method
    #[il2cpp_method(name="GetTomeMaxLevel", params=0)]
    get_tome_max: il2cpp::Method
}

#[il2cpp_proxy]
impl InvUtilProxy {
    #[il2cpp_hook(method="get_weapon_max")]
    fn on_get_weapon_max(ctx: il2cpp::HookContext, state: HookState) -> Option<i32> {
        if state.enabled.get() { Some(999) } else { None }
    }

    #[il2cpp_hook(method="get_tome_max")]
    fn on_get_tome_max(ctx: il2cpp::HookContext, state: HookState) -> Option<i32> {
        if state.enabled.get() { Some(999) } else { None }
    }
}

fn write_f32_raw(addr: i64, value: f32) {
    let buf = bytes::zeroed(4);
    buf.write_f32_le(0, value);
    mem::write_bytes(ptr::from_int(addr), buf);
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

fn enum_entries(cls: il2cpp::Class) -> _ {
    let entries = [];
    for field in cls.fields() {
        if field.is_static() && field.name() != "value__" {
            entries.push(EnumEntry {
                name: field.name(),
                value: field.read_static(),
            });
        }
    }
    entries
}

// ---------------------------------------------------------------------------
// GameRuntime
// ---------------------------------------------------------------------------

pub struct GameRuntime {
    rt: il2cpp::Runtime
    player: PlayerProxy
    health: HealthProxy
    inventory: InventoryProxy
    item_inv: ItemInvProxy
    weapon_inv: WeaponInvProxy
    tome_inv: TomeInvProxy
    data: DataProxy
    gm: GameManagerProxy
    movement: MovementProxy
    camera: CameraProxy
    save: SaveProxy
    progression: ProgressionProxy
    loading: LoadingProxy
    levelup: LevelupProxy
    chest: ChestProxy
    encounter: EncounterProxy
    inv_util: InvUtilProxy
    enemy_collider_field: il2cpp::Field
    ignore_collision: il2cpp::Method
    push_apply_frames: cell::Cell<i32>
    // Hook state
    godmode: HookState
    skip_loading: HookState
    skip_offers: cell::Cell<bool>
    no_push: cell::Cell<bool>
    no_max_level: HookState
    detach_camera: HookState
    freeze_timer: cell::Cell<bool>
    noclip: cell::Cell<bool>
    extended_zoom: cell::Cell<bool>
    pc_offset3rd_z_off: i64
    // RemoveWeapon() takes 0 params — clears all weapons at once
    remove_all_weapons_method: Option<il2cpp::Method>
    // Enum entries
    weapons: [EnumEntry]
    items: [EnumEntry]
    tomes: [EnumEntry]
}

impl GameRuntime {
    pub fn init() -> Result<GameRuntime> {
        let rt = il2cpp::loaded()?;
        log::info("il2cpp runtime loaded");

        let health = HealthProxy::from_runtime(rt)?;
        let loading = LoadingProxy::from_runtime(rt)?;
        let movement = MovementProxy::from_runtime(rt)?;
        let camera = CameraProxy::from_runtime(rt)?;
        let weapon_inv = WeaponInvProxy::from_runtime(rt)?;
        let tome_inv = TomeInvProxy::from_runtime(rt)?;
        let inv_util = InvUtilProxy::from_runtime(rt)?;

        let pc_offset3rd_z_off = camera.offset_3rd.offset() + 8;

        let weapon_cls = rt.class("Assembly-CSharp", "Assets.Scripts.Inventory__Items__Pickups.Weapons", "WeaponInventory")?;
        let remove_all_weapons_method = match weapon_cls.method("RemoveWeapon", 0) {
            Ok(m) => { log::info("found RemoveWeapon(0)"); Some(m) }
            Err(_) => { log::info("no RemoveWeapon method"); None }
        };

        let levelup = LevelupProxy::from_runtime(rt)?;
        let chest = ChestProxy::from_runtime(rt)?;
        let encounter = EncounterProxy::from_runtime(rt)?;

        let physics = rt.class("UnityEngine.PhysicsModule", "UnityEngine", "Physics")?;
        let ignore_collision = physics.method("IgnoreCollision", 3)?;

        let enemy_class = rt.class("Assembly-CSharp", "Assets.Scripts.Actors.Enemies", "Enemy")?;
        let enemy_collider_field = enemy_class.field("collider")?;
        let enemy_init = enemy_class.method("InitEnemy", 7)?;
        let enemy_fixed = enemy_class.method("MyFixedUpdate", 0)?;
        let no_push = cell::new(false);
        let push_apply_frames = cell::new(0);
        let pm_instance = movement.instance;
        let pm_collider = movement.player_collider;
        enemy_init.hook(|ctx| {
            if no_push.get() {
                let pm = pm_instance.read_static();
                if !pm.is_null() {
                    let pc = pm_collider.read(pm);
                    let ec = enemy_collider_field.read(ctx.arg(0));
                    if !pc.is_null() && !ec.is_null() {
                        ignore_collision.invoke(il2cpp::null(), pc, ec, true);
                    }
                }
            }
            None
        });
        enemy_fixed.hook(|ctx| {
            let frames = push_apply_frames.get();
            if frames > 0 {
                push_apply_frames.set(frames - 1);
                let pm = pm_instance.read_static();
                if !pm.is_null() {
                    let pc = pm_collider.read(pm);
                    let ec = enemy_collider_field.read(ctx.arg(0));
                    if !pc.is_null() && !ec.is_null() {
                        ignore_collision.invoke(il2cpp::null(), pc, ec, no_push.get());
                    }
                }
            }
            None
        });

        let ew_class = rt.class("Assembly-CSharp", "Assets.Scripts.UI.InGame.Levelup", "EncounterWindows")?;
        let ew_reward_finished = ew_class.method("RewardFinished", 0)?;
        let ew_in_progress = ew_class.field("<encounterInProgress>k__BackingField")?;
        let ew_instance = cell::new(il2cpp::null());
        ew_class.method("Awake", 0)?.hook(|ctx| {
            ew_instance.set(ctx.arg(0));
            None
        });

        let no_max_level = HookState::default();
        let skip_offers = cell::new(false);
        let health_hooks = health.setup_hooks(None);
        let loading_hooks = loading.setup_hooks(None);
        let camera_hooks = camera.setup_hooks(None);
        weapon_inv.setup_hooks(Some(no_max_level));
        tome_inv.setup_hooks(Some(no_max_level));
        inv_util.setup_hooks(Some(no_max_level));

        levelup.show.hook(|ctx| {
            let ew = ew_instance.get();
            if skip_offers.get() && !ew.is_null() && ew_in_progress.read(ew) {
                ew_reward_finished.invoke(ew);
                Some(hooking::Skip())
            } else { None }
        });
        chest.open.hook(|ctx| {
            let ew = ew_instance.get();
            if skip_offers.get() && !ew.is_null() && ew_in_progress.read(ew) {
                ew_reward_finished.invoke(ew);
                Some(hooking::Skip())
            } else { None }
        });
        encounter.open.hook(|ctx| {
            let ew = ew_instance.get();
            if skip_offers.get() && !ew.is_null() && ew_in_progress.read(ew) {
                ew_reward_finished.invoke(ew);
                Some(hooking::Skip())
            } else { None }
        });
        log::info("all hooks installed");

        let asm = "Assembly-CSharp";
        let weapons = enum_entries(rt.class(asm, "", "EWeapon")?);
        let items = enum_entries(rt.class(asm, "Assets.Scripts.Inventory__Items__Pickups.Items", "EItem")?);
        let tomes = enum_entries(rt.class(asm, "Assets.Scripts._Data.Tomes", "ETome")?);
        log::info("discovered {} weapons, {} items, {} tomes",
            weapons.len(), items.len(), tomes.len());

        Ok(GameRuntime {
            rt,
            player: PlayerProxy::from_runtime(rt)?,
            health,
            inventory: InventoryProxy::from_runtime(rt)?,
            item_inv: ItemInvProxy::from_runtime(rt)?,
            weapon_inv,
            tome_inv,
            data: DataProxy::from_runtime(rt)?,
            gm: GameManagerProxy::from_runtime(rt)?,
            movement,
            camera,
            save: SaveProxy::from_runtime(rt)?,
            progression: ProgressionProxy::from_runtime(rt)?,
            loading,
            levelup,
            chest,
            encounter,
            inv_util,
            enemy_collider_field,
            ignore_collision,
            push_apply_frames,
            godmode: health_hooks.state,
            skip_loading: loading_hooks.state,
            skip_offers,
            no_push,
            no_max_level,
            detach_camera: camera_hooks.state,
            freeze_timer: cell::new(false),
            noclip: cell::new(false),
            extended_zoom: cell::new(false),
            pc_offset3rd_z_off,
            remove_all_weapons_method,
            weapons,
            items,
            tomes,
        })
    }

    fn player_obj(self) -> il2cpp::Object {
        self.player.instance.read_static()
    }

    fn in_game(self) -> bool {
        !self.player_obj().is_null()
    }

    fn inventory_obj(self) -> il2cpp::Object {
        let p = self.player_obj();
        if p.is_null() { return il2cpp::null(); }
        self.player.inventory.read(p)
    }

    fn health_obj(self) -> il2cpp::Object {
        let inv = self.inventory_obj();
        if inv.is_null() { return il2cpp::null(); }
        self.inventory.player_health.read(inv)
    }

    fn item_inv_obj(self) -> il2cpp::Object {
        let inv = self.inventory_obj();
        if inv.is_null() { return il2cpp::null(); }
        self.inventory.item_inv.read(inv)
    }

    fn weapon_inv_obj(self) -> il2cpp::Object {
        let inv = self.inventory_obj();
        if inv.is_null() { return il2cpp::null(); }
        self.inventory.weapon_inv.read(inv)
    }

    fn tome_inv_obj(self) -> il2cpp::Object {
        let inv = self.inventory_obj();
        if inv.is_null() { return il2cpp::null(); }
        self.inventory.tome_inv.read(inv)
    }

    fn data_manager(self) -> il2cpp::Object {
        self.data.instance.read_static()
    }

    fn game_manager(self) -> il2cpp::Object {
        self.gm.instance.read_static()
    }

    fn player_movement(self) -> il2cpp::Object {
        self.movement.instance.read_static()
    }

    fn player_camera(self) -> il2cpp::Object {
        self.camera.instance.read_static()
    }

    // --- Combat ---

    fn set_godmode(self, enabled: bool) {
        self.godmode.enabled.set(enabled);
    }

    fn is_godmode(self) -> bool {
        self.godmode.enabled.get()
    }

    fn read_health(self) -> Option<HealthInfo> {
        let h = self.health_obj();
        if h.is_null() { return None; }
        Some(HealthInfo {
            hp: self.health.hp.read(h),
            max_hp: self.health.max_hp.read(h),
            shield: self.health.shield.read(h),
            max_shield: self.health.max_shield.read(h),
        })
    }

    fn full_heal(self) {
        let h = self.health_obj();
        if h.is_null() { return; }
        let max = self.health.max_hp.read(h);
        self.health.hp.write(h, max);
    }

    fn max_shield(self) {
        let h = self.health_obj();
        if h.is_null() { return; }
        let max = self.health.max_shield.read(h);
        self.health.shield.write(h, max);
    }

    // --- Timer ---

    fn get_timer(self) -> f32 {
        let gm = self.game_manager();
        if gm.is_null() { return 0.0; }
        self.gm.timer.read(gm)
    }

    fn set_timer(self, value: f32) {
        let gm = self.game_manager();
        if gm.is_null() { return; }
        self.gm.timer.write(gm, value);
    }

    fn get_stage_time_max(self) -> f32 {
        let gm = self.game_manager();
        if gm.is_null() { return 0.0; }
        self.gm.stage_time.read(gm)
    }

    fn get_round_remaining(self) -> f32 {
        let max = self.get_stage_time_max();
        let current = self.get_timer();
        let rem = max - current;
        if rem < 0.0 { 0.0 } else { rem }
    }

    fn set_round_remaining(self, seconds: f32) {
        let gm = self.game_manager();
        if gm.is_null() { return; }
        let current = self.gm.timer.read(gm);
        let old_stage = self.gm.stage_time.read(gm);
        let new_stage = current + seconds;
        let delta = new_stage - old_stage;
        self.gm.stage_time.write(gm, new_stage);
        self.gm.next_stage_time.write(gm, current + 99999.0);
        let old_dungeon = self.gm.dungeon_time.read(gm);
        self.gm.dungeon_time.write(gm, old_dungeon + delta);
    }

    // --- Camera ---

    fn set_max_zoom(self, value: f32) {
        let pc = self.player_camera();
        if pc.is_null() { return; }
        self.camera.max_zoom.write(pc, value);
    }

    fn set_camera_z(self, value: f32) {
        let pc = self.player_camera();
        if pc.is_null() { return; }
        self.camera.current_z.write(pc, value);
        write_f32_raw(pc.address() + self.pc_offset3rd_z_off, value);
    }

    fn set_noclip(self, enabled: bool) {
        let pm = self.player_movement();
        if pm.is_null() { return; }
        self.movement.noclip.write(pm, enabled);
    }

    fn reset_camera(self) {
        self.noclip.set(false);
        self.set_noclip(false);
        self.detach_camera.enabled.set(false);
        self.extended_zoom.set(false);
        self.camera.zoom_block.set_blocked(false);
        self.set_max_zoom(0.0);
        let pc = self.player_camera();
        if !pc.is_null() {
            self.camera.camera_state.write(pc, 1);
        }
    }

    // --- Silver ---

    fn get_silver(self) -> i32 {
        let sm = self.save.instance.read_static();
        if sm.is_null() { return 0; }
        let prog = self.save.progression.read(sm);
        if prog.is_null() { return 0; }
        self.progression.silver.read(prog)
    }

    fn set_silver(self, value: i32) {
        let sm = self.save.instance.read_static();
        if sm.is_null() { return; }
        let prog = self.save.progression.read(sm);
        if prog.is_null() { return; }
        self.progression.silver.write(prog, value);
    }

    // --- Gold ---

    fn get_gold(self) -> i32 {
        let inv = self.inventory_obj();
        if inv.is_null() { return 0; }
        self.inventory.gold_int.read(inv)
    }

    fn set_gold(self, amount: i32) {
        let inv = self.inventory_obj();
        if inv.is_null() { return; }
        self.inventory.gold_int.write(inv, amount);
        self.inventory.gold_float.write(inv, amount);
    }

    // --- Items ---

    fn add_item(self, value: i32) {
        let ii = self.item_inv_obj();
        if ii.is_null() { return; }
        self.item_inv.add_item.invoke_on_main(ii, value);
    }

    fn add_item_n(self, value: i32, n: i32) {
        let ii = self.item_inv_obj();
        if ii.is_null() { return; }
        self.item_inv.add_item_n.invoke_on_main(ii, value, n);
    }

    fn remove_item(self, value: i32) {
        let ii = self.item_inv_obj();
        if ii.is_null() { return; }
        self.item_inv.remove_item.invoke_on_main(ii, value, false);
    }

    fn get_item_count(self, value: i32) -> i32 {
        let ii = self.item_inv_obj();
        if ii.is_null() { return 0; }
        self.item_inv.get_amount.invoke(ii, value)
    }

    fn remove_all_items(self) {
        for entry in self.items {
            let count = self.get_item_count(entry.value);
            let i = 0;
            while i < count {
                self.remove_item(entry.value);
                i = i + 1;
            }
        }
    }

    // --- Weapons ---

    fn unlock_weapon_cap(self) {
        let wi = self.weapon_inv_obj();
        if wi.is_null() { return; }
        self.weapon_inv.is_maxed.write(wi, false);
    }

    fn add_weapon_by_enum(self, value: i32) {
        let dm = self.data_manager();
        if dm.is_null() { return; }
        let weapon_data = self.data.get_weapon.invoke(dm, value);
        if weapon_data.is_null() { return; }
        let wi = self.weapon_inv_obj();
        if wi.is_null() { return; }
        self.weapon_inv.add_weapon.invoke_on_main(wi, weapon_data, il2cpp::null());
    }

    fn get_weapon_lvl(self, value: i32) -> i32 {
        let wi = self.weapon_inv_obj();
        if wi.is_null() { return 0; }
        self.weapon_inv.get_weapon_level.invoke(wi, value)
    }

    fn add_weapon_n(self, value: i32, n: i32) {
        let i = 0;
        while i < n {
            self.add_weapon_by_enum(value);
            i = i + 1;
        }
    }

    fn add_weapon_max(self, value: i32) {
        self.add_weapon_n(value, 100);
    }

    fn can_remove_all_weapons(self) -> bool {
        self.remove_all_weapons_method.is_some()
    }

    fn remove_all_weapons(self) {
        let wi = self.weapon_inv_obj();
        if wi.is_null() { return; }
        match self.remove_all_weapons_method {
            Some(m) => { m.invoke_on_main(wi); }
            None => {}
        }
    }

    // --- Tomes ---

    fn add_tome_by_enum(self, value: i32) {
        let dm = self.data_manager();
        if dm.is_null() { return; }
        let tome_data = self.data.get_tome.invoke(dm, value);
        if tome_data.is_null() { return; }
        let ti = self.tome_inv_obj();
        if ti.is_null() { return; }
        self.tome_inv.add_tome.invoke_on_main(ti, tome_data, il2cpp::null(), 0);
    }

    fn add_tome_n(self, value: i32, n: i32) {
        let i = 0;
        while i < n {
            self.add_tome_by_enum(value);
            i = i + 1;
        }
    }

    fn add_maxed_tome_by_enum(self, value: i32) {
        let dm = self.data_manager();
        if dm.is_null() { return; }
        let tome_data = self.data.get_tome.invoke(dm, value);
        if tome_data.is_null() { return; }
        let ti = self.tome_inv_obj();
        if ti.is_null() { return; }
        self.tome_inv.add_maxed_tome.invoke_on_main(ti, tome_data);
    }

    fn get_tome_lvl(self, value: i32) -> i32 {
        let ti = self.tome_inv_obj();
        if ti.is_null() { return 0; }
        self.tome_inv.get_tome_level.invoke(ti, value)
    }
}
