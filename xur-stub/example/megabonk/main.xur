// Megabonk trainer — Unity Il2Cpp game mod with egui overlay.
//
// Loads into the game via LD_PRELOAD. Press F1 to toggle the mod
// menu, which provides godmode, speed control, gold, silver,
// inventory management, timer control, no-push, camera zoom,
// noclip, and more.
//
//     cargo build --release -p xur-stub
//     # Steam > Megabonk > Properties > Launch options:
//     XUR_STUB_PATH=xur-stub/example/megabonk/main.xur \
//         LD_PRELOAD=target/release/libxur_stub.so %command%
//
//     # Or inject into the already-running game (needs ptrace, e.g.
//     # `sudo sysctl kernel.yama.ptrace_scope=0`):
//     xur stub inject xur-stub/example/megabonk/main.xur --name <game-process>

use std::gui;
use std::stub::unity::egui;
use std::log;

const proxies = std::import("./proxies.xur");
const draw = std::import("./ui.xur");
use proxies::{Tab, InvTab};

// ---------------------------------------------------------------------------
// Tab bar
// ---------------------------------------------------------------------------

fn tab_bar(ui: gui::Ui, state: proxies::UiState) {
    let tab = state.tab.get();
    ui.horizontal(|row| {
        if row.selectable(tab == Tab::Combat,    "Combat")    { state.tab.set(Tab::Combat); }
        if row.selectable(tab == Tab::Camera,    "Camera")    { state.tab.set(Tab::Camera); }
        if row.selectable(tab == Tab::Economy,   "Economy")   { state.tab.set(Tab::Economy); }
        if row.selectable(tab == Tab::Inventory, "Inventory") { state.tab.set(Tab::Inventory); }
    });
}

fn draw_inventory(ui: gui::Ui, game: proxies::GameRuntime, state: proxies::UiState) {
    let inv = state.inv_tab.get();
    ui.horizontal(|row| {
        if row.selectable(inv == InvTab::Weapons, "Weapons") { state.inv_tab.set(InvTab::Weapons); }
        if row.selectable(inv == InvTab::Tomes,   "Tomes")   { state.inv_tab.set(InvTab::Tomes); }
        if row.selectable(inv == InvTab::Items,   "Items")   { state.inv_tab.set(InvTab::Items); }
    });
    match state.inv_tab.get() {
        InvTab::Weapons => { draw::draw_weapons(ui, game, state); }
        InvTab::Tomes   => { draw::draw_tomes(ui, game, state); }
        InvTab::Items   => { draw::draw_items(ui, game, state); }
    }
}

// ---------------------------------------------------------------------------
// Entry points
// ---------------------------------------------------------------------------

fn ctor() {
    log::subscriber().to_file("/tmp/megabonk.log").truncate().with_max_level(log::Level::Debug).init();
    egui::init();
    egui::set_scale(0.75);
}

fn stub_main() {
    log::info("megabonk trainer starting");

    let visible = true;
    let f1_down = false;

    let state = proxies::UiState::new();

    let rt: Option<proxies::GameRuntime> = None;
    let rt_error: Option<str> = None;

    egui::run(|ctx| {
        let f1 = ctx.key("f1");
        if f1 && !f1_down {
            visible = !visible;
        }
        f1_down = f1;

        if !visible { return; }

        if rt.is_none() && rt_error.is_none() {
            match proxies::GameRuntime::init() {
                Ok(game) => { rt = Some(game); }
                Err(e) => {
                    log::info("init error: {}", e);
                    rt_error = Some(e);
                }
            }
        }

        ctx.window_sized("Megabonk Trainer", 380.0, |win| {
            match rt_error {
                Some(msg) => {
                    win.colored_label(255, 80, 80, "init error:");
                    win.small(msg);
                    return;
                }
                None => {}
            }

            let game = match rt {
                Some(g) => g,
                None => {
                    win.small("waiting for Il2Cpp runtime...");
                    return;
                }
            };

            game.load_icons_if_ready();

            if !game.in_game() {
                win.small("not in game (main menu)");
                win.separator();
                draw::draw_economy(win, game, state);
                return;
            }

            tab_bar(win, state);
            win.separator();

            match state.tab.get() {
                Tab::Combat    => { draw::draw_combat(win, game, state); }
                Tab::Camera    => { draw::draw_camera(win, game); }
                Tab::Economy   => { draw::draw_economy(win, game, state); }
                Tab::Inventory => { draw_inventory(win, game, state); }
            }
        });
    });
}
