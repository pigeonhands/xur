// Structured logging with std::log.
//
// Sets up a subscriber with file output, then emits log messages at
// various levels.
//
//     cargo build -p xur-stub
//     XUR_STUB_PATH=xur-stub/example/tracing.xur \
//         LD_PRELOAD=target/debug/libxur_stub.so /bin/true

use std::io;
use std::log;

fn ctor() {
    log::subscriber().with_max_level("debug").init();
}

fn main() -> Result<()> {
    log::info("application started");
    log::debug("debug details: x={}", 42);
    log::warn("something to watch");
    log::error("this would be an error");

    io::println("[tracing] log messages emitted — check stderr or log file");

    // To log to a file instead:
    //   log::subscriber().to_file("/tmp/game.log").with_max_level("debug").init();
    //
    // Other subscriber options:
    //   .with_target(false)       — hide module path
    //   .with_ansi(false)         — no ANSI colors
    //   .json()                   — JSON output format
    //   .compact()                — compact format
    //   .pretty()                 — pretty-printed format
    //   .with_filter("my_mod=debug")  — per-module filtering

    Ok(())
}
