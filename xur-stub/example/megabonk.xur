impl InvUtilProxy {
    #[il2cpp_hook(method="get_weapon_max")]
    fn on_get_weapon_max(ctx: il2cpp::HookContext, state: HookState) -> Option<i32> {
        if state.enabled.get() { Some(999) } else { None }
    }

    #[il2cpp_hook(method="get_tome_max")]
    fn on_get_tome_max(ctx: il2cpp::HookContext, state: HookState) -> Option<i32> {
        if state.enabled.get() { Some(999) } else { None }
    }
}

fn write_f32_raw(addr: i64, value: f32) {
    let buf = bytes::zeroed(4);
    buf.write_f32_le(0, value);
    mem::write_bytes(ptr::from_int(addr), buf);
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

fn enum_entries(cls: il2cpp::Class) -> _ {
    let entries = [];
    for field in cls.fields() {
        if field.is_static() && field.name() != "value__" {
            entries.push(EnumEntry {
                name: field.name(),
                value: field.read_static(),
            });
        }
    }
    entries
}

// ---------------------------------------------------------------------------
// GameRuntime
// ---------------------------------------------------------------------------

struct GameRuntime {
    rt: il2cpp::Runtime
    player: PlayerProxy
    health: HealthProxy
    inventory: InventoryProxy
    item_inv: ItemInvProxy
    weapon_inv: WeaponInvProxy
    tome_inv: TomeInvProxy
    data: DataProxy
    gm: GameManagerProxy
    movement: MovementProxy
    camera: CameraProxy
    save: SaveProxy
    progression: ProgressionProxy
    loading: LoadingProxy
    levelup: LevelupProxy
    chest: ChestProxy
    encounter: EncounterProxy
    inv_util: InvUtilProxy
    enemy_collider_field: il2cpp::Field
    ignore_collision: il2cpp::Method
    push_apply_frames: cell::Cell<i32>
    // Hook state
    godmode: HookState
    skip_loading: HookState
    skip_offers: cell::Cell<bool>
    no_push: cell::Cell<bool>
    no_max_level: HookState
    detach_camera: HookState
    freeze_timer: cell::Cell<bool>
    noclip: cell::Cell<bool>
    extended_zoom: cell::Cell<bool>
    pc_offset3rd_z_off: i64
    // Enum entries
    weapons: [EnumEntry]
    items: [EnumEntry]
    tomes: [EnumEntry]
}

impl GameRuntime {
    fn init() -> Result<GameRuntime> {
        let rt = il2cpp::loaded()?;
        log::info("il2cpp runtime loaded");

        let health = HealthProxy::from_runtime(rt)?;
        let loading = LoadingProxy::from_runtime(rt)?;
        let movement = MovementProxy::from_runtime(rt)?;
        let camera = CameraProxy::from_runtime(rt)?;
        let weapon_inv = WeaponInvProxy::from_runtime(rt)?;
        let tome_inv = TomeInvProxy::from_runtime(rt)?;
        let inv_util = InvUtilProxy::from_runtime(rt)?;

        let pc_offset3rd_z_off = camera.offset_3rd.offset() + 8;

        let levelup = LevelupProxy::from_runtime(rt)?;
        let chest = ChestProxy::from_runtime(rt)?;
        let encounter = EncounterProxy::from_runtime(rt)?;

        let physics = rt.class("UnityEngine.PhysicsModule", "UnityEngine", "Physics")?;
        let ignore_collision = physics.method("IgnoreCollision", 3)?;

        let enemy_class = rt.class("Assembly-CSharp", "Assets.Scripts.Actors.Enemies", "Enemy")?;
        let enemy_collider_field = enemy_class.field("collider")?;
        let enemy_init = enemy_class.method("InitEnemy", 7)?;
        let enemy_fixed = enemy_class.method("MyFixedUpdate", 0)?;
        let no_push = cell::new(false);
        let push_apply_frames = cell::new(0);
        let pm_instance = movement.instance;
        let pm_collider = movement.player_collider;
        enemy_init.hook(|ctx| {
            if no_push.get() {
                let pm = pm_instance.read_static();
                if !pm.is_null() {
                    let pc = pm_collider.read(pm);
                    let ec = enemy_collider_field.read(ctx.arg(0));
                    if !pc.is_null() && !ec.is_null() {
                        ignore_collision.invoke(il2cpp::null(), pc, ec, true);
                    }
                }
            }
            None
        });
        enemy_fixed.hook(|ctx| {
            let frames = push_apply_frames.get();
            if frames > 0 {
                push_apply_frames.set(frames - 1);
                let pm = pm_instance.read_static();
                if !pm.is_null() {
                    let pc = pm_collider.read(pm);
                    let ec = enemy_collider_field.read(ctx.arg(0));
                    if !pc.is_null() && !ec.is_null() {
                        ignore_collision.invoke(il2cpp::null(), pc, ec, no_push.get());
                    }
                }
            }
            None
        });

        let ew_class = rt.class("Assembly-CSharp", "Assets.Scripts.UI.InGame.Levelup", "EncounterWindows")?;
        let ew_reward_finished = ew_class.method("RewardFinished", 0)?;
        let ew_in_progress = ew_class.field("<encounterInProgress>k__BackingField")?;
        let ew_instance = cell::new(il2cpp::null());
        ew_class.method("Awake", 0)?.hook(|ctx| {
            ew_instance.set(ctx.arg(0));
            None
        });

        let no_max_level = HookState::default();
        let skip_offers = cell::new(false);
        let health_hooks = health.setup_hooks(None);
        let loading_hooks = loading.setup_hooks(None);
        let camera_hooks = camera.setup_hooks(None);
        weapon_inv.setup_hooks(Some(no_max_level));
        tome_inv.setup_hooks(Some(no_max_level));
        inv_util.setup_hooks(Some(no_max_level));

        levelup.show.hook(|ctx| {
            let ew = ew_instance.get();
            if skip_offers.get() && !ew.is_null() && ew_in_progress.read(ew) {
                ew_reward_finished.invoke(ew);
                Some(hooking::Skip())
            } else { None }
        });
        chest.open.hook(|ctx| {
            let ew = ew_instance.get();
            if skip_offers.get() && !ew.is_null() && ew_in_progress.read(ew) {
                ew_reward_finished.invoke(ew);
                Some(hooking::Skip())
            } else { None }
        });
        encounter.open.hook(|ctx| {
            let ew = ew_instance.get();
            if skip_offers.get() && !ew.is_null() && ew_in_progress.read(ew) {
                ew_reward_finished.invoke(ew);
                Some(hooking::Skip())
            } else { None }
        });
        log::info("all hooks installed");

        let asm = "Assembly-CSharp";
        let weapons = enum_entries(rt.class(asm, "", "EWeapon")?);
        let items = enum_entries(rt.class(asm, "Assets.Scripts.Inventory__Items__Pickups.Items", "EItem")?);
        let tomes = enum_entries(rt.class(asm, "Assets.Scripts._Data.Tomes", "ETome")?);
        log::info("discovered {} weapons, {} items, {} tomes",
            weapons.len(), items.len(), tomes.len());

        Ok(GameRuntime {
            rt,
            player: PlayerProxy::from_runtime(rt)?,
            health,
            inventory: InventoryProxy::from_runtime(rt)?,
            item_inv: ItemInvProxy::from_runtime(rt)?,
            weapon_inv,
            tome_inv,
            data: DataProxy::from_runtime(rt)?,
            gm: GameManagerProxy::from_runtime(rt)?,
            movement,
            camera,
            save: SaveProxy::from_runtime(rt)?,
            progression: ProgressionProxy::from_runtime(rt)?,
            loading,
            levelup,
            chest,
            encounter,
            inv_util,
            enemy_collider_field,
            ignore_collision,
            push_apply_frames,
            godmode: health_hooks.state,
            skip_loading: loading_hooks.state,
            skip_offers,
            no_push,
            no_max_level,
            detach_camera: camera_hooks.state,
            freeze_timer: cell::new(false),
            noclip: cell::new(false),
            extended_zoom: cell::new(false),
            pc_offset3rd_z_off,
            weapons,
            items,
            tomes,
        })
    }

    fn player_obj(self) -> il2cpp::Object {
        self.player.instance.read_static()
    }

    fn in_game(self) -> bool {
        !self.player_obj().is_null()
    }

    fn inventory_obj(self) -> il2cpp::Object {
        let p = self.player_obj();
        if p.is_null() { return il2cpp::null(); }
        self.player.inventory.read(p)
    }

    fn health_obj(self) -> il2cpp::Object {
        let inv = self.inventory_obj();
        if inv.is_null() { return il2cpp::null(); }
        self.inventory.player_health.read(inv)
    }

    fn item_inv_obj(self) -> il2cpp::Object {
        let inv = self.inventory_obj();
        if inv.is_null() { return il2cpp::null(); }
        self.inventory.item_inv.read(inv)
    }

    fn weapon_inv_obj(self) -> il2cpp::Object {
        let inv = self.inventory_obj();
        if inv.is_null() { return il2cpp::null(); }
        self.inventory.weapon_inv.read(inv)
    }

    fn tome_inv_obj(self) -> il2cpp::Object {
        let inv = self.inventory_obj();
        if inv.is_null() { return il2cpp::null(); }
        self.inventory.tome_inv.read(inv)
    }

    fn data_manager(self) -> il2cpp::Object {
        self.data.instance.read_static()
    }

    fn game_manager(self) -> il2cpp::Object {
        self.gm.instance.read_static()
    }

    fn player_movement(self) -> il2cpp::Object {
        self.movement.instance.read_static()
    }

    fn player_camera(self) -> il2cpp::Object {
        self.camera.instance.read_static()
    }

    // --- Combat ---

    fn set_godmode(self, enabled: bool) {
        self.godmode.enabled.set(enabled);
    }

    fn is_godmode(self) -> bool {
        self.godmode.enabled.get()
    }

    fn read_health(self) -> Option<HealthInfo> {
        let h = self.health_obj();
        if h.is_null() { return None; }
        Some(HealthInfo {
            hp: self.health.hp.read(h),
            max_hp: self.health.max_hp.read(h),
            shield: self.health.shield.read(h),
            max_shield: self.health.max_shield.read(h),
        })
    }

    fn full_heal(self) {
        let h = self.health_obj();
        if h.is_null() { return; }
        let max = self.health.max_hp.read(h);
        self.health.hp.write(h, max);
    }

    fn max_shield(self) {
        let h = self.health_obj();
        if h.is_null() { return; }
        let max = self.health.max_shield.read(h);
        self.health.shield.write(h, max);
    }

    // --- Timer ---

    fn get_timer(self) -> f32 {
        let gm = self.game_manager();
        if gm.is_null() { return 0.0; }
        self.gm.timer.read(gm)
    }

    fn set_timer(self, value: f32) {
        let gm = self.game_manager();
        if gm.is_null() { return; }
        self.gm.timer.write(gm, value);
    }

    fn get_stage_time_max(self) -> f32 {
        let gm = self.game_manager();
        if gm.is_null() { return 0.0; }
        self.gm.stage_time.read(gm)
    }

    fn get_round_remaining(self) -> f32 {
        let max = self.get_stage_time_max();
        let current = self.get_timer();
        let rem = max - current;
        if rem < 0.0 { 0.0 } else { rem }
    }

    fn set_round_remaining(self, seconds: f32) {
        let gm = self.game_manager();
        if gm.is_null() { return; }
        let current = self.gm.timer.read(gm);
        let old_stage = self.gm.stage_time.read(gm);
        let new_stage = current + seconds;
        let delta = new_stage - old_stage;
        self.gm.stage_time.write(gm, new_stage);
        self.gm.next_stage_time.write(gm, current + 99999.0);
        let old_dungeon = self.gm.dungeon_time.read(gm);
        self.gm.dungeon_time.write(gm, old_dungeon + delta);
    }

    // --- Camera ---

    fn set_max_zoom(self, value: f32) {
        let pc = self.player_camera();
        if pc.is_null() { return; }
        self.camera.max_zoom.write(pc, value);
    }

    fn set_camera_z(self, value: f32) {
        let pc = self.player_camera();
        if pc.is_null() { return; }
        self.camera.current_z.write(pc, value);
        write_f32_raw(pc.address() + self.pc_offset3rd_z_off, value);
    }

    fn set_noclip(self, enabled: bool) {
        let pm = self.player_movement();
        if pm.is_null() { return; }
        self.movement.noclip.write(pm, enabled);
    }

    fn reset_camera(self) {
        self.noclip.set(false);
        self.set_noclip(false);
        self.detach_camera.enabled.set(false);
        self.extended_zoom.set(false);
        self.camera.zoom_block.set_blocked(false);
        self.set_max_zoom(0.0);
        let pc = self.player_camera();
        if !pc.is_null() {
            self.camera.camera_state.write(pc, 1);
        }
    }

    // --- Silver ---

    fn get_silver(self) -> i32 {
        let sm = self.save.instance.read_static();
        if sm.is_null() { return 0; }
        let prog = self.save.progression.read(sm);
        if prog.is_null() { return 0; }
        self.progression.silver.read(prog)
    }

    fn set_silver(self, value: i32) {
        let sm = self.save.instance.read_static();
        if sm.is_null() { return; }
        let prog = self.save.progression.read(sm);
        if prog.is_null() { return; }
        self.progression.silver.write(prog, value);
    }

    // --- Gold (direct field write to avoid ChangeGold event crash) ---

    fn get_gold(self) -> i32 {
        let inv = self.inventory_obj();
        if inv.is_null() { return 0; }
        self.inventory.gold_int.read(inv)
    }

    fn set_gold(self, amount: i32) {
        let inv = self.inventory_obj();
        if inv.is_null() { return; }
        self.inventory.gold_int.write(inv, amount);
        self.inventory.gold_float.write(inv, amount);
    }

    // --- Items ---

    fn add_item(self, value: i32) {
        let ii = self.item_inv_obj();
        if ii.is_null() { return; }
        self.item_inv.add_item.invoke_on_main(ii, value);
    }

    fn add_item_n(self, value: i32, n: i32) {
        let ii = self.item_inv_obj();
        if ii.is_null() { return; }
        self.item_inv.add_item_n.invoke_on_main(ii, value, n);
    }

    fn remove_item(self, value: i32) {
        let ii = self.item_inv_obj();
        if ii.is_null() { return; }
        self.item_inv.remove_item.invoke_on_main(ii, value, false);
    }

    fn get_item_count(self, value: i32) -> i32 {
        let ii = self.item_inv_obj();
        if ii.is_null() { return 0; }
        self.item_inv.get_amount.invoke(ii, value)
    }

    // --- Weapons ---

    fn unlock_weapon_cap(self) {
        let wi = self.weapon_inv_obj();
        if wi.is_null() { return; }
        self.weapon_inv.is_maxed.write(wi, false);
    }

    fn add_weapon_by_enum(self, value: i32) {
        let dm = self.data_manager();
        if dm.is_null() { return; }
        let weapon_data = self.data.get_weapon.invoke(dm, value);
        if weapon_data.is_null() { return; }
        let wi = self.weapon_inv_obj();
        if wi.is_null() { return; }
        self.weapon_inv.add_weapon.invoke_on_main(wi, weapon_data, il2cpp::null());
    }

    fn get_weapon_lvl(self, value: i32) -> i32 {
        let wi = self.weapon_inv_obj();
        if wi.is_null() { return 0; }
        self.weapon_inv.get_weapon_level.invoke(wi, value)
    }

    fn add_weapon_n(self, value: i32, n: i32) {
        let i = 0;
        while i < n {
            self.add_weapon_by_enum(value);
            i = i + 1;
        }
    }

    fn add_weapon_max(self, value: i32) {
        self.add_weapon_n(value, 100);
    }

    // --- Tomes ---

    fn add_tome_by_enum(self, value: i32) {
        let dm = self.data_manager();
        if dm.is_null() { return; }
        let tome_data = self.data.get_tome.invoke(dm, value);
        if tome_data.is_null() { return; }
        let ti = self.tome_inv_obj();
        if ti.is_null() { return; }
        self.tome_inv.add_tome.invoke_on_main(ti, tome_data, il2cpp::null(), 0);
    }

    fn add_tome_n(self, value: i32, n: i32) {
        let i = 0;
        while i < n {
            self.add_tome_by_enum(value);
            i = i + 1;
        }
    }

    fn add_maxed_tome_by_enum(self, value: i32) {
        let dm = self.data_manager();
        if dm.is_null() { return; }
        let tome_data = self.data.get_tome.invoke(dm, value);
        if tome_data.is_null() { return; }
        let ti = self.tome_inv_obj();
        if ti.is_null() { return; }
        self.tome_inv.add_maxed_tome.invoke_on_main(ti, tome_data);
    }

    fn get_tome_lvl(self, value: i32) -> i32 {
        let ti = self.tome_inv_obj();
        if ti.is_null() { return 0; }
        self.tome_inv.get_tome_level.invoke(ti, value)
    }
}

// ---------------------------------------------------------------------------
// UI draw helpers
// ---------------------------------------------------------------------------

fn draw_combat(ui: egui::Ui, game: GameRuntime) {
    ui.heading("Combat");
    let godmode = game.is_godmode();
    let new_godmode = ui.checkbox(godmode, "Godmode");
    if new_godmode != godmode {
        game.set_godmode(new_godmode);
    }

    let no_push = game.no_push.get();
    let new_no_push = ui.checkbox(no_push, "No push / knockback");
    if new_no_push != no_push {
        game.no_push.set(new_no_push);
        game.push_apply_frames.set(150);
    }

    let skip = game.skip_loading.enabled.get();
    let new_skip = ui.checkbox(skip, "Skip loading animation");
    if new_skip != skip {
        game.skip_loading.enabled.set(new_skip);
    }

    let no_max = game.no_max_level.enabled.get();
    let new_no_max = ui.checkbox(no_max, "No max level cap");
    if new_no_max != no_max {
        game.no_max_level.enabled.set(new_no_max);
    }

    let skip_levelup = game.skip_offers.get();
    let new_skip_levelup = ui.checkbox(skip_levelup, "Skip upgrade offers");
    if new_skip_levelup != skip_levelup {
        game.skip_offers.set(new_skip_levelup);
    }

    match game.read_health() {
        Some(h) => {
            ui.small(fmt::format("HP: {}/{}  Shield: {}/{}",
                h.hp, h.max_hp, h.shield, h.max_shield));
            ui.horizontal(|row| {
                if row.button("Full heal") { game.full_heal(); }
                if row.button("Max shield") { game.max_shield(); }
            });
        }
        None => {}
    }
}

fn draw_timer(ui: egui::Ui, game: GameRuntime, state: UiState) {
    let remaining = game.get_round_remaining();
    let total_secs = remaining.to_int();
    let mins = total_secs / 60;
    let secs = total_secs - mins * 60;
    ui.heading(fmt::format("Round: {}m {}s", mins, secs));

    let frozen = game.gm.timer_block.is_blocked();
    let new_frozen = ui.checkbox(frozen, "Freeze timer");
    if new_frozen != frozen {
        game.gm.timer_block.set_blocked(new_frozen);
        game.freeze_timer.set(new_frozen);
        if new_frozen {
            state.timer_value.set(remaining);
        }
    }

    let new_val = ui.slider_float("Set to (seconds)", state.timer_value.get(), 0.0, 1200.0);
    state.timer_value.set(new_val);
    ui.horizontal(|row| {
        if row.button("Set") { game.set_round_remaining(state.timer_value.get()); }
        if row.button("+60s") {
            let t = game.get_round_remaining() + 60.0;
            game.set_round_remaining(t);
            state.timer_value.set(t);
        }
        if row.button("+300s") {
            let t = game.get_round_remaining() + 300.0;
            game.set_round_remaining(t);
            state.timer_value.set(t);
        }
        if row.button("Reset (10m)") {
            game.set_round_remaining(600.0);
            state.timer_value.set(600.0);
        }
    });
}

fn draw_camera(ui: egui::Ui, game: GameRuntime) {
    ui.heading("Camera");

    let ext = game.extended_zoom.get();
    let new_ext = ui.checkbox(ext, "Extended zoom range");
    if new_ext != ext {
        game.extended_zoom.set(new_ext);
        if new_ext {
            game.set_max_zoom(50.0);
        } else {
            game.set_max_zoom(0.0);
        }
    }

    let blocked = game.camera.zoom_block.is_blocked();
    let new_blocked = ui.checkbox(blocked, "Manual zoom (blocks game zoom)");
    if new_blocked != blocked {
        game.camera.zoom_block.set_blocked(new_blocked);
    }

    let pc = game.player_camera();
    if !pc.is_null() {
        let cur_z = game.camera.current_z.read(pc);
        let new_z = ui.slider_float("Zoom", cur_z, -5.0, 60.0);
        if new_z != cur_z {
            game.camera.zoom_block.set_blocked(true);
            game.set_camera_z(new_z);
        } else if game.camera.zoom_block.is_blocked() {
            game.set_camera_z(cur_z);
        }
    }

    let detach = game.detach_camera.enabled.get();
    let new_detach = ui.checkbox(detach, "Detach camera from player");
    if new_detach != detach {
        game.detach_camera.enabled.set(new_detach);
    }

    let noclip = game.noclip.get();
    let new_noclip = ui.checkbox(noclip, "Noclip (fly mode, moves player)");
    if new_noclip != noclip {
        game.noclip.set(new_noclip);
        game.set_noclip(new_noclip);
    }
    if game.noclip.get() {
        game.set_noclip(true);
    }

    if ui.button("Reset camera") {
        game.reset_camera();
    }
}

fn draw_speed(ui: egui::Ui) {
    ui.heading("Speed");
    let speed = ui.slider_float("Time scale", time::scale(), 0.0, 20.0);
    time::set_scale(speed);
    ui.horizontal(|row| {
        if row.button("pause") { time::set_scale(0.0); }
        if row.button("0.5x")  { time::set_scale(0.5); }
        if row.button("1x")    { time::set_scale(1.0); }
        if row.button("2x")    { time::set_scale(2.0); }
        if row.button("5x")    { time::set_scale(5.0); }
        if row.button("10x")   { time::set_scale(10.0); }
        if row.button("20x")   { time::set_scale(20.0); }
    });
}

fn draw_gold(ui: egui::Ui, game: GameRuntime, state: UiState) {
    ui.heading(fmt::format("Gold: {}", game.get_gold()));
    let new_amount = ui.slider_int("Amount", state.gold_amount.get(), 0, 99999);
    state.gold_amount.set(new_amount);
    ui.horizontal(|row| {
        if row.button("Set") { game.set_gold(state.gold_amount.get()); }
        if row.button("+1k") { game.set_gold(game.get_gold() + 1000); }
        if row.button("+10k") { game.set_gold(game.get_gold() + 10000); }
    });
}

fn draw_silver(ui: egui::Ui, game: GameRuntime, state: UiState) {
    ui.heading(fmt::format("Silver: {}", game.get_silver()));
    let new_amount = ui.slider_int("Amount", state.silver_amount.get(), 0, 99999);
    state.silver_amount.set(new_amount);
    ui.horizontal(|row| {
        if row.button("Set") { game.set_silver(state.silver_amount.get()); }
        if row.button("+1k") { game.set_silver(game.get_silver() + 1000); }
        if row.button("+10k") { game.set_silver(game.get_silver() + 10000); }
    });
}

fn draw_weapons(ui: egui::Ui, game: GameRuntime, state: UiState) {
    let owned = [];
    for entry in game.weapons {
        if entry.name == "None" || entry.name == "Test" { continue; }
        let lvl = game.get_weapon_lvl(entry.value);
        if lvl > 0 {
            owned.push(entry);
        }
    }

    ui.horizontal(|row| {
        if row.button("Add all") {
            for entry in game.weapons {
                if entry.name == "None" || entry.name == "Test" { continue; }
                if game.get_weapon_lvl(entry.value) == 0 {
                    game.unlock_weapon_cap();
                    game.add_weapon_by_enum(entry.value);
                }
            }
        }
        if row.button("+100 all") {
            for entry in owned {
                game.unlock_weapon_cap();
                game.add_weapon_n(entry.value, 100);
            }
        }
    });

    if owned.len() > 0 {
        ui.collapsing(fmt::format("Owned ({})", owned.len()), |section| {
            section.grid("weapons_owned", 4, |g| {
                for entry in owned {
                    let lvl = game.get_weapon_lvl(entry.value);
                    g.label(fmt::format("{} lv{}", entry.name, lvl));
                    if g.button("+") {
                        game.unlock_weapon_cap();
                        game.add_weapon_by_enum(entry.value);
                    }
                    if g.button("+10") {
                        game.unlock_weapon_cap();
                        game.add_weapon_n(entry.value, 10);
                    }
                    if g.button("+100") {
                        game.unlock_weapon_cap();
                        game.add_weapon_max(entry.value);
                    }
                    g.end_row();
                }
            });
        });
    } else {
        ui.small("no weapons");
    }

    ui.separator();
    ui.small("Add weapon:");
    let new_search = ui.text_edit(state.weapon_search.get());
    state.weapon_search.set(new_search);
    let query = new_search.to_lower();
    ui.scroll(150.0, |scroll| {
        for entry in game.weapons {
            if entry.name == "None" || entry.name == "Test" { continue; }
            if game.get_weapon_lvl(entry.value) > 0 { continue; }
            if query != "" && !entry.name.to_lower().contains(query) {
                continue;
            }
            scroll.horizontal(|row| {
                if row.button("+") {
                    game.unlock_weapon_cap();
                    game.add_weapon_by_enum(entry.value);
                }
                row.label(entry.name);
            });
        }
    });
}

fn draw_tomes(ui: egui::Ui, game: GameRuntime, state: UiState) {
    let owned = [];
    for entry in game.tomes {
        let lvl = game.get_tome_lvl(entry.value);
        if lvl > 0 {
            owned.push(entry);
        }
    }

    ui.horizontal(|row| {
        if row.button("Add all") {
            let pass = 0;
            while pass < 2 {
                for entry in game.tomes {
                    if game.get_tome_lvl(entry.value) == 0 {
                        game.add_tome_by_enum(entry.value);
                    }
                }
                pass = pass + 1;
            }
        }
        if row.button("+100 all") {
            for entry in owned {
                game.add_tome_n(entry.value, 100);
            }
        }
        if row.button("Max all") {
            for entry in owned {
                game.add_maxed_tome_by_enum(entry.value);
            }
        }
    });

    if owned.len() > 0 {
        ui.collapsing(fmt::format("Owned ({})", owned.len()), |section| {
            section.grid("tomes_owned", 5, |g| {
                for entry in owned {
                    let lvl = game.get_tome_lvl(entry.value);
                    g.label(fmt::format("{} lv{}", entry.name, lvl));
                    if g.button("+") { game.add_tome_by_enum(entry.value); }
                    if g.button("+10") { game.add_tome_n(entry.value, 10); }
                    if g.button("+100") { game.add_tome_n(entry.value, 100); }
                    if g.button("max") { game.add_maxed_tome_by_enum(entry.value); }
                    g.end_row();
                }
            });
        });
    } else {
        ui.small("no tomes");
    }

    ui.separator();
    ui.small("Add tome:");
    let new_search = ui.text_edit(state.tome_search.get());
    state.tome_search.set(new_search);
    let query = new_search.to_lower();
    ui.scroll(150.0, |scroll| {
        for entry in game.tomes {
            if game.get_tome_lvl(entry.value) > 0 { continue; }
            if query != "" && !entry.name.to_lower().contains(query) {
                continue;
            }
            scroll.horizontal(|row| {
                if row.button("+") { game.add_tome_by_enum(entry.value); }
                row.label(entry.name);
            });
        }
    });
}

fn draw_items(ui: egui::Ui, game: GameRuntime, state: UiState) {
    let owned = [];
    for entry in game.items {
        let count = game.get_item_count(entry.value);
        if count > 0 {
            owned.push(entry);
        }
    }

    ui.horizontal(|row| {
        if row.button("Add all") {
            let pass = 0;
            while pass < 2 {
                for entry in game.items {
                    if game.get_item_count(entry.value) == 0 {
                        game.add_item(entry.value);
                    }
                }
                pass = pass + 1;
            }
        }
        if row.button("+100 all") {
            for entry in owned {
                game.add_item_n(entry.value, 100);
            }
        }
    });

    if owned.len() > 0 {
        ui.collapsing(fmt::format("Owned ({})", owned.len()), |section| {
            section.grid("items_owned", 5, |g| {
                for entry in owned {
                    let count = game.get_item_count(entry.value);
                    g.label(fmt::format("{} x{}", entry.name, count));
                    if g.button("+") { game.add_item(entry.value); }
                    if g.button("+10") { game.add_item_n(entry.value, 10); }
                    if g.button("+100") { game.add_item_n(entry.value, 100); }
                    if g.button("-") { game.remove_item(entry.value); }
                    g.end_row();
                }
            });
        });
    } else {
        ui.small("no items");
    }

    ui.separator();
    ui.small("Add item:");
    let new_search = ui.text_edit(state.item_search.get());
    state.item_search.set(new_search);
    let query = new_search.to_lower();
    ui.scroll(150.0, |scroll| {
        for entry in game.items {
            if game.get_item_count(entry.value) > 0 { continue; }
            if query != "" && !entry.name.to_lower().contains(query) {
                continue;
            }
            scroll.horizontal(|row| {
                if row.button("+") { game.add_item(entry.value); }
                if row.button("+10") { game.add_item_n(entry.value, 10); }
                row.label(entry.name);
            });
        }
    });
}

// ---------------------------------------------------------------------------
// Entry points
// ---------------------------------------------------------------------------

fn ctor() {
    log::subscriber().to_file("/tmp/megabonk.log").truncate().with_max_level("debug").init();
    egui::init();
    egui::set_scale(0.75);
}

fn stub_main() {
    log::info("megabonk trainer starting");

    let visible = true;
    let f1_down = false;

    let state = UiState::new();

    let rt: Option<GameRuntime> = None;
    let rt_error: Option<str> = None;

    egui::run(|ctx| {
        let f1 = ctx.key("f1");
        if f1 && !f1_down {
            visible = !visible;
        }
        f1_down = f1;

        if !visible { return; }

        if rt.is_none() && rt_error.is_none() {
            match GameRuntime::init() {
                Ok(game) => { rt = Some(game); }
                Err(e) => {
                    log::info("init error: {}", e);
                    rt_error = Some(e);
                }
            }
        }

        ctx.window_sized("Megabonk Trainer", 360.0, |ui| {
            ui.small(fmt::format("frame {} | xur-stub", egui::frame_count()));

            match rt_error {
                Some(msg) => {
                    ui.separator();
                    ui.colored_label(255, 80, 80, fmt::format("init error: {}", msg));
                    return;
                }
                None => {}
            }

            let game = match rt {
                Some(g) => g,
                None => {
                    ui.separator();
                    ui.small("waiting for Il2Cpp runtime...");
                    return;
                }
            };

            if !game.in_game() {
                ui.separator();
                ui.small("not in game (main menu)");
                ui.separator();
                draw_silver(ui, game, state);
                return;
            }

            ui.separator();
            draw_combat(ui, game);
            ui.separator();
            draw_timer(ui, game, state);
            ui.separator();
            draw_camera(ui, game);
            ui.separator();
            draw_speed(ui);
            ui.separator();
            draw_gold(ui, game, state);
            ui.separator();
            draw_silver(ui, game, state);
            ui.separator();

            ui.collapsing("Weapons", |section| {
                draw_weapons(section, game, state);
            });
            ui.collapsing("Tomes", |section| {
                draw_tomes(section, game, state);
            });
            ui.collapsing("Items", |section| {
                draw_items(section, game, state);
            });
        });
    });
}
