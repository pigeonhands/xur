// Megabonk trainer — Unity Il2Cpp game mod with egui overlay.
//
// Loads into the game via LD_PRELOAD. Press F1 to toggle the mod
// menu, which provides godmode (via DamagePlayer hook), speed
// control, gold, and inventory management with a grid slot UI.
//
//     cargo build --release -p xur-stub --features egui
//     # Steam > Megabonk > Properties > Launch options:
//     XUR_STUB_PATH=xur-stub/example/megabonk.xur \
//         LD_PRELOAD=target/release/libxur_stub.so %command%

use std::cell;
use std::fmt;
use std::stub::il2cpp;
use std::stub::re::unity::egui;
use std::stub::re::unity::time;
use std::log;

// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------

struct HealthInfo {
    hp: i32
    max_hp: i32
    shield: f32
    max_shield: f32
}

struct EnumEntry {
    name: str
    value: i32
}

struct UiState {
    gold_amount: cell::Cell<i32>
    weapon_search: cell::Cell<str>
    tome_search: cell::Cell<str>
    item_search: cell::Cell<str>
}

fn new_ui_state() -> UiState {
    UiState {
        gold_amount: cell::new(10000),
        weapon_search: cell::new(""),
        tome_search: cell::new(""),
        item_search: cell::new(""),
    }
}

struct GameRuntime {
    rt: il2cpp::Runtime
    // MyPlayer
    player_instance: il2cpp::Field
    inventory_field: il2cpp::Field
    // PlayerHealth
    hp_field: il2cpp::Field
    max_hp_field: il2cpp::Field
    shield_field: il2cpp::Field
    max_shield_field: il2cpp::Field
    // PlayerInventory
    player_health_field: il2cpp::Field
    weapon_inv_field: il2cpp::Field
    item_inv_field: il2cpp::Field
    tome_inv_field: il2cpp::Field
    gold_int_field: il2cpp::Field
    gold_float_field: il2cpp::Field
    // ItemInventory
    add_item_method: il2cpp::Method
    add_item_n_method: il2cpp::Method
    remove_item_method: il2cpp::Method
    get_item_amount: il2cpp::Method
    // WeaponInventory
    add_weapon: il2cpp::Method
    get_weapon_level: il2cpp::Method
    // TomeInventory
    add_maxed_tome: il2cpp::Method
    get_tome_level: il2cpp::Method
    has_tome: il2cpp::Method
    // DataManager
    dm_instance: il2cpp::Field
    dm_get_weapon: il2cpp::Method
    dm_get_item: il2cpp::Method
    dm_get_tome: il2cpp::Method
    // Godmode state — cell is shared so the hook closure and UI
    // both see mutations.
    godmode: cell::Cell<bool>
    // Enum entries
    weapons: [EnumEntry]
    items: [EnumEntry]
    tomes: [EnumEntry]
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

fn enum_entries(cls: il2cpp::Class) -> _ {
    let entries = [];
    for field in cls.fields() {
        if field.is_static() && field.name() != "value__" {
            entries.push(EnumEntry {
                name: field.name(),
                value: field.read_static(),
            });
        }
    }
    entries
}

// ---------------------------------------------------------------------------
// GameRuntime
// ---------------------------------------------------------------------------

impl GameRuntime {
    fn init() -> Result<GameRuntime> {
        let rt = il2cpp::loaded()?;
        log::info("il2cpp runtime loaded");

        let asm = "Assembly-CSharp";
        let player_cls = rt.class(asm, "Assets.Scripts.Actors.Player", "MyPlayer")?;
        log::debug("  MyPlayer class found");
        let health_cls = rt.class(asm, "Assets.Scripts.Inventory__Items__Pickups", "PlayerHealth")?;
        log::debug("  PlayerHealth class found");
        let inv_cls = rt.class(asm, "", "PlayerInventory")?;
        log::debug("  PlayerInventory class found");
        let item_inv_cls = rt.class(asm, "Assets.Scripts.Inventory__Items__Pickups.Items", "ItemInventory")?;
        log::debug("  ItemInventory class found");
        let weapon_inv_cls = rt.class(asm, "Assets.Scripts.Inventory__Items__Pickups.Weapons", "WeaponInventory")?;
        log::debug("  WeaponInventory class found");
        let tome_inv_cls = rt.class(asm, "Assets.Scripts.Inventory__Items__Pickups", "TomeInventory")?;
        log::debug("  TomeInventory class found");
        let dm_cls = rt.class(asm, "", "DataManager")?;
        log::debug("  DataManager class found");
        let weapon_enum = rt.class(asm, "", "EWeapon")?;
        let item_enum = rt.class(asm, "Assets.Scripts.Inventory__Items__Pickups.Items", "EItem")?;
        let tome_enum = rt.class(asm, "Assets.Scripts._Data.Tomes", "ETome")?;
        log::info("all classes found");

        let player_instance = player_cls.field("Instance")?;
        let inventory_field = player_cls.field("inventory")?;
        log::debug("  MyPlayer.Instance, inventory fields found");

        let hp_field = health_cls.field("hp")?;
        let max_hp_field = health_cls.field("maxHp")?;
        let shield_field = health_cls.field("shield")?;
        let max_shield_field = health_cls.field("maxShield")?;
        log::debug("  PlayerHealth fields found (hp, maxHp, shield, maxShield)");

        let player_health_field = inv_cls.field("playerHealth")?;
        let weapon_inv_field = inv_cls.field("weaponInventory")?;
        let item_inv_field = inv_cls.field("itemInventory")?;
        let tome_inv_field = inv_cls.field("tomeInventory")?;
        let gold_int_field = inv_cls.field("<goldInt>k__BackingField")?;
        let gold_float_field = inv_cls.field("<gold>k__BackingField")?;
        log::debug("  PlayerInventory fields found (health, weapons, items, tomes, gold)");

        let add_item_method = item_inv_cls.method("AddItem", 1)?;
        log::debug("  ItemInventory.AddItem(1) found");
        let add_item_n_method = item_inv_cls.method("AddItem", 2)?;
        log::debug("  ItemInventory.AddItem(2) found");
        let remove_item_method = item_inv_cls.method("RemoveItem", 2)?;
        log::debug("  ItemInventory.RemoveItem(2) found");
        let get_item_amount = item_inv_cls.method("GetAmount", 1)?;
        log::debug("  ItemInventory.GetAmount(1) found");

        let add_weapon = weapon_inv_cls.method("AddWeapon", 2)?;
        log::debug("  WeaponInventory.AddWeapon(2) found");
        let get_weapon_level = weapon_inv_cls.method("GetWeaponLevel", 1)?;
        log::debug("  WeaponInventory.GetWeaponLevel(1) found");

        let add_maxed_tome = tome_inv_cls.method("AddMaxedTome", 1)?;
        log::debug("  TomeInventory.AddMaxedTome(1) found");
        let get_tome_level = tome_inv_cls.method("GetTomeLevel", 1)?;
        log::debug("  TomeInventory.GetTomeLevel(1) found");
        let has_tome = tome_inv_cls.method("HasTome", 1)?;
        log::debug("  TomeInventory.HasTome(1) found");

        let dm_instance = dm_cls.field("Instance")?;
        let dm_get_weapon = dm_cls.method("GetWeapon", 1)?;
        let dm_get_item = dm_cls.method("GetItem", 1)?;
        let dm_get_tome = dm_cls.method("GetTome", 1)?;
        log::debug("  DataManager fields and methods found");

        // Hook DamagePlayer(Enemy, Vector3, DcFlags) — when godmode is
        // on the hook returns 0 (skip original), otherwise passes through.
        let godmode = cell::new(false);
        let damage_method = health_cls.method("DamagePlayer", 3)?;
        log::info("DamagePlayer found, hooking...");
        damage_method.hook(|ctx| {
            if godmode.get() { Some(0) } else { None }
        });
        log::info("DamagePlayer hooked for godmode");

        let weapons = enum_entries(weapon_enum);
        let items = enum_entries(item_enum);
        let tomes = enum_entries(tome_enum);
        log::info("discovered {} weapons, {} items, {} tomes",
            weapons.len(), items.len(), tomes.len());

        Ok(GameRuntime {
            rt,
            player_instance,
            inventory_field,
            hp_field,
            max_hp_field,
            shield_field,
            max_shield_field,
            player_health_field,
            weapon_inv_field,
            item_inv_field,
            tome_inv_field,
            gold_int_field,
            gold_float_field,
            add_item_method,
            add_item_n_method,
            remove_item_method,
            get_item_amount,
            add_weapon,
            get_weapon_level,
            add_maxed_tome,
            get_tome_level,
            has_tome,
            dm_instance,
            dm_get_weapon,
            dm_get_item,
            dm_get_tome,
            godmode,
            weapons,
            items,
            tomes,
        })
    }

    fn player(self) -> il2cpp::Object {
        self.player_instance.read_static()
    }

    fn in_game(self) -> bool {
        !self.player().is_null()
    }

    fn inventory(self) -> il2cpp::Object {
        let p = self.player();
        if p.is_null() { return il2cpp::null(); }
        self.inventory_field.read(p)
    }

    fn health_obj(self) -> il2cpp::Object {
        let inv = self.inventory();
        if inv.is_null() { return il2cpp::null(); }
        self.player_health_field.read(inv)
    }

    fn item_inv(self) -> il2cpp::Object {
        let inv = self.inventory();
        if inv.is_null() { return il2cpp::null(); }
        self.item_inv_field.read(inv)
    }

    fn weapon_inv(self) -> il2cpp::Object {
        let inv = self.inventory();
        if inv.is_null() { return il2cpp::null(); }
        self.weapon_inv_field.read(inv)
    }

    fn tome_inv(self) -> il2cpp::Object {
        let inv = self.inventory();
        if inv.is_null() { return il2cpp::null(); }
        self.tome_inv_field.read(inv)
    }

    fn data_manager(self) -> il2cpp::Object {
        self.dm_instance.read_static()
    }

    // --- Combat ---

    fn set_godmode(self, enabled: bool) {
        self.godmode.set(enabled);
    }

    fn is_godmode(self) -> bool {
        self.godmode.get()
    }

    fn read_health(self) -> Option<HealthInfo> {
        let h = self.health_obj();
        if h.is_null() { return None; }
        Some(HealthInfo {
            hp: self.hp_field.read(h),
            max_hp: self.max_hp_field.read(h),
            shield: self.shield_field.read(h),
            max_shield: self.max_shield_field.read(h),
        })
    }

    fn full_heal(self) {
        let h = self.health_obj();
        if h.is_null() { return; }
        let max = self.max_hp_field.read(h);
        self.hp_field.write(h, max);
    }

    fn max_shield(self) {
        let h = self.health_obj();
        if h.is_null() { return; }
        let max = self.max_shield_field.read(h);
        self.shield_field.write(h, max);
    }

    // --- Gold (direct field write to avoid ChangeGold event crash) ---

    fn get_gold(self) -> i32 {
        let inv = self.inventory();
        if inv.is_null() { return 0; }
        self.gold_int_field.read(inv)
    }

    fn set_gold(self, amount: i32) {
        let inv = self.inventory();
        if inv.is_null() { return; }
        self.gold_int_field.write(inv, amount);
        self.gold_float_field.write(inv, amount);
    }

    // --- Items ---

    fn add_item(self, value: i32) {
        let ii = self.item_inv();
        if ii.is_null() { return; }
        self.add_item_method.invoke(ii, value);
    }

    fn add_item_n(self, value: i32, n: i32) {
        let ii = self.item_inv();
        if ii.is_null() { return; }
        self.add_item_n_method.invoke(ii, value, n);
    }

    fn remove_item(self, value: i32) {
        let ii = self.item_inv();
        if ii.is_null() { return; }
        self.remove_item_method.invoke(ii, value, false);
    }

    fn get_item_count(self, value: i32) -> i32 {
        let ii = self.item_inv();
        if ii.is_null() { return 0; }
        self.get_item_amount.invoke(ii, value)
    }

    // --- Weapons ---

    fn add_weapon_by_enum(self, value: i32) {
        let dm = self.data_manager();
        if dm.is_null() { return; }
        let weapon_data = self.dm_get_weapon.invoke(dm, value);
        if weapon_data.is_null() { return; }
        let wi = self.weapon_inv();
        if wi.is_null() { return; }
        self.add_weapon.invoke(wi, weapon_data, il2cpp::null());
    }

    fn get_weapon_lvl(self, value: i32) -> i32 {
        let wi = self.weapon_inv();
        if wi.is_null() { return 0; }
        self.get_weapon_level.invoke(wi, value)
    }

    fn add_weapon_n(self, value: i32, n: i32) {
        let i = 0;
        while i < n {
            self.add_weapon_by_enum(value);
            i = i + 1;
        }
    }

    fn add_weapon_max(self, value: i32) {
        self.add_weapon_n(value, 100);
    }

    // --- Tomes (only AddMaxedTome is available — AddTome requires 3 params) ---

    fn add_maxed_tome_by_enum(self, value: i32) {
        let dm = self.data_manager();
        if dm.is_null() { return; }
        let tome_data = self.dm_get_tome.invoke(dm, value);
        if tome_data.is_null() { return; }
        let ti = self.tome_inv();
        if ti.is_null() { return; }
        self.add_maxed_tome.invoke(ti, tome_data);
    }

    fn get_tome_lvl(self, value: i32) -> i32 {
        let ti = self.tome_inv();
        if ti.is_null() { return 0; }
        self.get_tome_level.invoke(ti, value)
    }
}

// ---------------------------------------------------------------------------
// UI draw helpers
// ---------------------------------------------------------------------------

fn draw_combat(ui: egui::Ui, game: GameRuntime) {
    ui.heading("Combat");
    let godmode = game.is_godmode();
    let new_godmode = ui.checkbox(godmode, "Godmode (hook DamagePlayer)");
    if new_godmode != godmode {
        game.set_godmode(new_godmode);
    }

    match game.read_health() {
        Some(h) => {
            ui.small(fmt::format("HP: {}/{}  Shield: {}/{}",
                h.hp, h.max_hp, h.shield, h.max_shield));
            ui.horizontal(|row| {
                if row.button("Full heal") { game.full_heal(); }
                if row.button("Max shield") { game.max_shield(); }
            });
        }
        None => {}
    }
}

fn draw_speed(ui: egui::Ui) {
    ui.heading("Speed");
    let speed = ui.slider_float("Time scale", time::scale(), 0.0, 5.0);
    time::set_scale(speed);
    ui.horizontal(|row| {
        if row.button("pause") { time::set_scale(0.0); }
        if row.button("0.5x")  { time::set_scale(0.5); }
        if row.button("1x")    { time::set_scale(1.0); }
        if row.button("2x")    { time::set_scale(2.0); }
        if row.button("5x")    { time::set_scale(5.0); }
    });
}

fn draw_gold(ui: egui::Ui, game: GameRuntime, state: UiState) {
    ui.heading(fmt::format("Gold: {}", game.get_gold()));
    let new_amount = ui.slider_int("Amount", state.gold_amount.get(), 0, 99999);
    state.gold_amount.set(new_amount);
    ui.horizontal(|row| {
        if row.button("Set") { game.set_gold(state.gold_amount.get()); }
        if row.button("+1k") { game.set_gold(game.get_gold() + 1000); }
        if row.button("+10k") { game.set_gold(game.get_gold() + 10000); }
    });
}

fn draw_weapons(ui: egui::Ui, game: GameRuntime, state: UiState) {
    // Grid of owned weapons
    let owned = [];
    for entry in game.weapons {
        if entry.name == "None" || entry.name == "Test" { continue; }
        let lvl = game.get_weapon_lvl(entry.value);
        if lvl > 0 {
            owned.push(entry);
        }
    }

    if owned.len() > 0 {
        ui.grid("weapons_owned", 4, |g| {
            for entry in owned {
                let lvl = game.get_weapon_lvl(entry.value);
                g.label(fmt::format("{} lv{}", entry.name, lvl));
                if g.button("+") { game.add_weapon_by_enum(entry.value); }
                if g.button("+10") { game.add_weapon_n(entry.value, 10); }
                if g.button("max") { game.add_weapon_max(entry.value); }
                g.end_row();
            }
        });
    } else {
        ui.small("no weapons");
    }

    // Search + add
    ui.separator();
    ui.small("Add weapon:");
    let new_search = ui.text_edit(state.weapon_search.get());
    state.weapon_search.set(new_search);
    let query = new_search.to_lower();
    ui.scroll(150.0, |scroll| {
        for entry in game.weapons {
            if entry.name == "None" || entry.name == "Test" { continue; }
            if game.get_weapon_lvl(entry.value) > 0 { continue; }
            if query != "" && !entry.name.to_lower().contains(query) {
                continue;
            }
            scroll.horizontal(|row| {
                if row.button("+") { game.add_weapon_by_enum(entry.value); }
                row.label(entry.name);
            });
        }
    });
}

fn draw_tomes(ui: egui::Ui, game: GameRuntime, state: UiState) {
    // Grid of owned tomes (only AddMaxedTome available, no incremental add)
    let owned = [];
    for entry in game.tomes {
        let lvl = game.get_tome_lvl(entry.value);
        if lvl > 0 {
            owned.push(entry);
        }
    }

    if owned.len() > 0 {
        ui.grid("tomes_owned", 2, |g| {
            for entry in owned {
                let lvl = game.get_tome_lvl(entry.value);
                g.label(fmt::format("{} lv{}", entry.name, lvl));
                if g.button("max") { game.add_maxed_tome_by_enum(entry.value); }
                g.end_row();
            }
        });
    } else {
        ui.small("no tomes");
    }

    // Search + add
    ui.separator();
    ui.small("Add tome (maxed):");
    let new_search = ui.text_edit(state.tome_search.get());
    state.tome_search.set(new_search);
    let query = new_search.to_lower();
    ui.scroll(150.0, |scroll| {
        for entry in game.tomes {
            if game.get_tome_lvl(entry.value) > 0 { continue; }
            if query != "" && !entry.name.to_lower().contains(query) {
                continue;
            }
            scroll.horizontal(|row| {
                if row.button("max") { game.add_maxed_tome_by_enum(entry.value); }
                row.label(entry.name);
            });
        }
    });
}

fn draw_items(ui: egui::Ui, game: GameRuntime, state: UiState) {
    // Grid of owned items
    let owned = [];
    for entry in game.items {
        let count = game.get_item_count(entry.value);
        if count > 0 {
            owned.push(entry);
        }
    }

    if owned.len() > 0 {
        ui.grid("items_owned", 5, |g| {
            for entry in owned {
                let count = game.get_item_count(entry.value);
                g.label(fmt::format("{} x{}", entry.name, count));
                if g.button("+") { game.add_item(entry.value); }
                if g.button("+10") { game.add_item_n(entry.value, 10); }
                if g.button("max") { game.add_item_n(entry.value, 100); }
                if g.button("-") { game.remove_item(entry.value); }
                g.end_row();
            }
        });
    } else {
        ui.small("no items");
    }

    // Search + add
    ui.separator();
    ui.small("Add item:");
    let new_search = ui.text_edit(state.item_search.get());
    state.item_search.set(new_search);
    let query = new_search.to_lower();
    ui.scroll(150.0, |scroll| {
        for entry in game.items {
            if game.get_item_count(entry.value) > 0 { continue; }
            if query != "" && !entry.name.to_lower().contains(query) {
                continue;
            }
            scroll.horizontal(|row| {
                if row.button("+") { game.add_item(entry.value); }
                if row.button("+10") { game.add_item_n(entry.value, 10); }
                row.label(entry.name);
            });
        }
    });
}

// ---------------------------------------------------------------------------
// Entry points
// ---------------------------------------------------------------------------

fn ctor() {
    log::subscriber().to_file("/tmp/megabonk.log").truncate().with_max_level("debug").init();
    egui::init();
}

fn stub_main() {
    log::info("megabonk trainer starting");

    let visible = true;
    let f1_down = false;

    // Mutable UI state in a list — list elements are Arc-shared, so
    // writes propagate through nested closures (window_sized, etc).
    let state = new_ui_state();

    // Runtime (lazy init)
    let rt: Option<GameRuntime> = None;
    let rt_error: Option<str> = None;

    egui::run(|ctx| {
        let f1 = ctx.key("f1");
        if f1 && !f1_down {
            visible = !visible;
        }
        f1_down = f1;

        if !visible { return; }

        // Lazy-init after Il2Cpp is ready
        if rt.is_none() && rt_error.is_none() {
            match GameRuntime::init() {
                Ok(game) => { rt = Some(game); }
                Err(e) => {
                    log::info("init error: {}", e);
                    rt_error = Some(e);
                }
            }
        }

        ctx.window_sized("Megabonk Trainer", 360.0, |ui| {
            ui.small(fmt::format("frame {} | xur-stub", egui::frame_count()));

            match rt_error {
                Some(msg) => {
                    ui.separator();
                    ui.colored_label(255, 80, 80, fmt::format("init error: {}", msg));
                    return;
                }
                None => {}
            }

            let game = match rt {
                Some(g) => g,
                None => {
                    ui.separator();
                    ui.small("waiting for Il2Cpp runtime...");
                    return;
                }
            };

            if !game.in_game() {
                ui.separator();
                ui.small("not in game (main menu)");
                return;
            }

            ui.separator();
            draw_combat(ui, game);
            ui.separator();
            draw_speed(ui);
            ui.separator();
            draw_gold(ui, game, state);
            ui.separator();

            ui.collapsing("Weapons", |section| {
                draw_weapons(section, game, state);
            });
            ui.collapsing("Tomes", |section| {
                draw_tomes(section, game, state);
            });
            ui.collapsing("Items", |section| {
                draw_items(section, game, state);
            });
        });
    });
}
