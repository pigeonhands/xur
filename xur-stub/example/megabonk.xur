// Megabonk trainer — Unity Il2Cpp game mod with egui overlay.
//
// Loads into the game via LD_PRELOAD. Press F1 to toggle the mod
// menu, which provides godmode, speed control, and inventory cheats
// with searchable weapon/item lists.
//
//     cargo build --release -p xur-stub --features egui
//     # Steam > Megabonk > Properties > Launch options:
//     XUR_STUB_PATH=xur-stub/example/megabonk.xur \
//         LD_PRELOAD=target/release/libxur_stub.so %command%

use std::fmt;
use std::io;
use std::xur;
use std::stub::il2cpp;
use std::stub::re::unity::egui;
use std::stub::re::unity::time;
use std::stub::tracing;

// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------

struct HealthInfo {
    hp: i32
    max_hp: i32
    shield: f32
}

struct EnumEntry {
    name: str
    value: i32
}

struct GameRuntime {
    il2cpp: il2cpp::Runtime
    player_cls: il2cpp::Class
    health_cls: il2cpp::Class
    instance_field: il2cpp::Field
    invincible_field: il2cpp::Field
    health_field: il2cpp::Field
    hp_field: il2cpp::Field
    max_hp_field: il2cpp::Field
    shield_field: il2cpp::Field
    inventory_field: il2cpp::Field
    weapon_inv_field: il2cpp::Field
    item_inv_field: il2cpp::Field
    gold_field: il2cpp::Field
    add_weapon_method: il2cpp::Method
    add_item_method: il2cpp::Method
    weapons: _
    items: _
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

fn enum_entries(cls: il2cpp::Class) -> _ {
    let entries = [];
    for field in cls.fields() {
        if field.is_static() && field.name() != "value__" {
            entries.push(EnumEntry {
                name: field.name(),
                value: field.read_static(),
            });
        }
    }
    entries
}

fn log(msg: str) {
    tracing::info(msg);
}

// ---------------------------------------------------------------------------
// GameRuntime
// ---------------------------------------------------------------------------

impl GameRuntime {
    fn init() -> Result<GameRuntime> {
        let rt = il2cpp::loaded()?;
        log("il2cpp runtime loaded");

        let player_cls = rt.class("Assembly-CSharp", "Assets.Scripts.Actors.Player", "MyPlayer")?;
        let health_cls = rt.class("Assembly-CSharp", "Assets.Scripts.Actors.Player", "PlayerHealth")?;
        let weapon_inv_cls = rt.class("Assembly-CSharp", "Assets.Scripts.Actors.Player", "WeaponInventory")?;
        let item_inv_cls = rt.class("Assembly-CSharp", "Assets.Scripts.Actors.Player", "ItemInventory")?;
        let inventory_cls = rt.class("Assembly-CSharp", "Assets.Scripts.Actors.Player", "PlayerInventory")?;
        let weapon_enum_cls = rt.class("Assembly-CSharp", "Assets.Scripts.Items", "EWeapon")?;
        let item_enum_cls = rt.class("Assembly-CSharp", "Assets.Scripts.Items", "EItem")?;
        log("all classes found");

        let instance_field = player_cls.field("Instance")?;
        let invincible_field = player_cls.field("isInvincible")?;
        let health_field = player_cls.field("health")?;
        let hp_field = health_cls.field("hp")?;
        let max_hp_field = health_cls.field("maxHp")?;
        let shield_field = health_cls.field("shield")?;
        let inventory_field = player_cls.field("inventory")?;
        let weapon_inv_field = inventory_cls.field("weapons")?;
        let item_inv_field = inventory_cls.field("items")?;
        let gold_field = inventory_cls.field("gold")?;
        log("all fields found");

        let add_weapon_method = weapon_inv_cls.method("AddWeapon", 1)?;
        let add_item_method = item_inv_cls.method("AddItem", 1)?;
        log("all methods found");

        // Enumerate every weapon and item from their Il2Cpp enum classes.
        let weapons = enum_entries(weapon_enum_cls);
        let items = enum_entries(item_enum_cls);

        log(fmt::format("discovered {} weapons, {} items", weapons.len(), items.len()));
        for w in weapons {
            log(fmt::format("  weapon: {} = {}", w.name, w.value));
        }
        for i in items {
            log(fmt::format("  item: {} = {}", i.name, i.value));
        }

        // Log player class structure for diagnostics.
        log("--- MyPlayer fields ---");
        for f in player_cls.fields() {
            let tag = if f.is_static() { " (static)" } else { "" };
            log(fmt::format("  {}: {}{}", f.name(), f.type_name(), tag));
        }
        log("--- MyPlayer methods ---");
        for m in player_cls.methods() {
            log(fmt::format("  {}", m.signature()));
        }

        Ok(GameRuntime {
            il2cpp: rt,
            player_cls,
            health_cls,
            instance_field,
            invincible_field,
            health_field,
            hp_field,
            max_hp_field,
            shield_field,
            inventory_field,
            weapon_inv_field,
            item_inv_field,
            gold_field,
            add_weapon_method,
            add_item_method,
            weapons,
            items,
        })
    }

    fn player(self) -> il2cpp::Object {
        self.instance_field.read_static()
    }

    fn apply_godmode(self, enabled: bool) {
        let player = self.player();
        if player.is_null() { return; }
        self.invincible_field.write(player, enabled);
    }

    fn read_health(self) -> Option<HealthInfo> {
        let player = self.player();
        if player.is_null() { return None; }

        let health_obj = self.health_field.read(player);
        if health_obj.is_null() { return None; }

        Some(HealthInfo {
            hp: self.hp_field.read(health_obj),
            max_hp: self.max_hp_field.read(health_obj),
            shield: self.shield_field.read(health_obj),
        })
    }

    fn write_health(self, hp: i32, max_hp: i32) {
        let player = self.player();
        if player.is_null() { return; }

        let health_obj = self.health_field.read(player);
        if health_obj.is_null() { return; }

        self.hp_field.write(health_obj, hp);
        self.max_hp_field.write(health_obj, max_hp);
    }

    fn set_gold(self, amount: i32) {
        let player = self.player();
        if player.is_null() { return; }

        let inv = self.inventory_field.read(player);
        if inv.is_null() { return; }

        self.gold_field.write(inv, amount);
    }

    fn add_weapon(self, value: i32) {
        let player = self.player();
        if player.is_null() { return; }

        let inv = self.inventory_field.read(player);
        if inv.is_null() { return; }

        let weapons = self.weapon_inv_field.read(inv);
        if weapons.is_null() { return; }

        self.add_weapon_method.invoke(weapons, value);
    }

    fn add_item(self, value: i32) {
        let player = self.player();
        if player.is_null() { return; }

        let inv = self.inventory_field.read(player);
        if inv.is_null() { return; }

        let items = self.item_inv_field.read(inv);
        if items.is_null() { return; }

        self.add_item_method.invoke(items, value);
    }

    fn give_all_weapons(self) {
        for entry in self.weapons {
            self.add_weapon(entry.value);
        }
    }

    fn give_all_items(self) {
        for entry in self.items {
            self.add_item(entry.value);
        }
    }
}

// ---------------------------------------------------------------------------
// Entry points
// ---------------------------------------------------------------------------

fn ctor() {
    tracing::register("file", "/tmp/megabonk.log", "debug");
    egui::init();
}

fn stub_main() {
    log("megabonk trainer starting");

    let visible = true;
    let f1_down = false;

    // UI state.
    let godmode = false;
    let speed = 1.0;
    let gold_amount = 1000;
    let weapon_search = "";
    let item_search = "";

    // Runtime state (initialised lazily after the game loads).
    let rt: Option<GameRuntime> = None;
    let rt_error: Option<str> = None;

    egui::run(|ctx| {
        let f1 = ctx.key("f1");
        if f1 && !f1_down {
            visible = !visible;
        }
        f1_down = f1;

        if !visible {
            return;
        }

        // Lazy-init: wait until Il2Cpp is up.
        if rt.is_none() && rt_error.is_none() {
            match GameRuntime::init() {
                Ok(game) => { rt = Some(game); }
                Err(e) => {
                    log(fmt::format("init error: {}", e));
                    rt_error = Some(e);
                }
            }
        }

        ctx.window("Megabonk Trainer", |ui| {
            ui.small(fmt::format("frame {} | invoked by: {}",
                egui::frame_count(), xur::invoked_by()));

            match rt_error {
                Some(msg) => {
                    ui.separator();
                    ui.small(fmt::format("il2cpp error: {}", msg));
                    return;
                }
                None => {}
            }

            let game = match rt {
                Some(g) => g,
                None => {
                    ui.separator();
                    ui.small("waiting for Il2Cpp runtime...");
                    return;
                }
            };

            ui.separator();

            // --- Godmode ---
            ui.heading("Combat");
            let prev_godmode = godmode;
            godmode = ui.checkbox(godmode, "Godmode (invincible)");
            if godmode != prev_godmode {
                game.apply_godmode(godmode);
            }

            match game.read_health() {
                Some(health) => {
                    ui.small(fmt::format("  HP: {}/{} | Shield: {}",
                        health.hp, health.max_hp, health.shield));
                    if ui.button("Full heal") {
                        game.write_health(health.max_hp, health.max_hp);
                    }
                }
                None => {}
            }
            ui.separator();

            // --- Speed ---
            ui.heading("Speed");
            let scale = time::scale();
            speed = ui.slider_float("Time scale", scale, 0.0, 5.0);
            time::set_scale(speed);
            ui.horizontal(|row| {
                if row.button("pause") { time::set_scale(0.0); }
                if row.button("0.5x")  { time::set_scale(0.5); }
                if row.button("1x")    { time::set_scale(1.0); }
                if row.button("2x")    { time::set_scale(2.0); }
                if row.button("5x")    { time::set_scale(5.0); }
            });
            ui.separator();

            // --- Inventory ---
            ui.heading("Inventory");
            gold_amount = ui.slider_int("Gold", gold_amount, 0, 99999);
            if ui.button("Set gold") {
                game.set_gold(gold_amount);
            }
            ui.horizontal(|row| {
                if row.button("All weapons") { game.give_all_weapons(); }
                if row.button("All items")   { game.give_all_items(); }
            });
            ui.separator();

            // --- Weapon search ---
            ui.collapsing("Add weapon", |section| {
                weapon_search = section.text_edit(weapon_search);
                let query = weapon_search.to_lower();
                section.scroll(200.0, |scroll| {
                    for entry in game.weapons {
                        if query == "" || entry.name.to_lower().contains(query) {
                            scroll.horizontal(|row| {
                                if row.button("+") {
                                    game.add_weapon(entry.value);
                                    log(fmt::format("added weapon: {}", entry.name));
                                }
                                row.label(entry.name);
                            });
                        }
                    }
                });
            });

            // --- Item search ---
            ui.collapsing("Add item", |section| {
                item_search = section.text_edit(item_search);
                let query = item_search.to_lower();
                section.scroll(200.0, |scroll| {
                    for entry in game.items {
                        if query == "" || entry.name.to_lower().contains(query) {
                            scroll.horizontal(|row| {
                                if row.button("+") {
                                    game.add_item(entry.value);
                                    log(fmt::format("added item: {}", entry.name));
                                }
                                row.label(entry.name);
                            });
                        }
                    }
                });
            });
        });
    });
}
