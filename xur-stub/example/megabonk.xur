// Megabonk trainer — Unity Il2Cpp game mod with egui overlay.
//
// Loads into the game via LD_PRELOAD. Press F1 to toggle the mod
// menu, which provides godmode (via DamagePlayer hook), speed
// control, gold, silver, inventory management, timer control,
// no-push, camera zoom, noclip, and more.
//
//     cargo build --release -p xur-stub
//     # Steam > Megabonk > Properties > Launch options:
//     XUR_STUB_PATH=xur-stub/example/megabonk.xur \
//         LD_PRELOAD=target/release/libxur_stub.so %command%

use std::cell;
use std::bytes;
use std::fmt;
use std::mem;
use std::ptr;
use std::stub::il2cpp;
use std::stub::il2cpp::il2cpp_proxy;
use std::stub::re::unity::egui;
use std::stub::re::unity::time;
use std::log;

// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------

struct HealthInfo {
    hp: i32
    max_hp: i32
    shield: f32
    max_shield: f32
}

struct EnumEntry {
    name: str
    value: i32
}

struct UiState {
    gold_amount: cell::Cell<i32>
    weapon_search: cell::Cell<str>
    tome_search: cell::Cell<str>
    item_search: cell::Cell<str>
    timer_value: cell::Cell<f32>
    silver_amount: cell::Cell<i32>
}

fn new_ui_state() -> UiState {
    UiState {
        gold_amount: cell::new(10000),
        weapon_search: cell::new(""),
        tome_search: cell::new(""),
        item_search: cell::new(""),
        timer_value: cell::new(0.0),
        silver_amount: cell::new(10000),
    }
}

struct GameRuntime {
    rt: il2cpp::Runtime
    // MyPlayer
    player_instance: il2cpp::Field
    inventory_field: il2cpp::Field
    // PlayerHealth
    hp_field: il2cpp::Field
    max_hp_field: il2cpp::Field
    shield_field: il2cpp::Field
    max_shield_field: il2cpp::Field
    // PlayerInventory
    player_health_field: il2cpp::Field
    weapon_inv_field: il2cpp::Field
    item_inv_field: il2cpp::Field
    tome_inv_field: il2cpp::Field
    gold_int_field: il2cpp::Field
    gold_float_field: il2cpp::Field
    // ItemInventory
    add_item_method: il2cpp::Method
    add_item_n_method: il2cpp::Method
    remove_item_method: il2cpp::Method
    get_item_amount: il2cpp::Method
    // WeaponInventory
    add_weapon: il2cpp::Method
    get_weapon_level: il2cpp::Method
    weapon_is_maxed: il2cpp::Field
    // TomeInventory
    add_tome: il2cpp::Method
    add_maxed_tome: il2cpp::Method
    get_tome_level: il2cpp::Method
    has_tome: il2cpp::Method
    // DataManager
    dm_instance: il2cpp::Field
    dm_get_weapon: il2cpp::Method
    dm_get_item: il2cpp::Method
    dm_get_tome: il2cpp::Method
    // GameManager
    gm_instance: il2cpp::Field
    gm_timer: il2cpp::Field
    gm_stage_time: il2cpp::Field
    gm_next_stage_time: il2cpp::Field
    gm_dungeon_time: il2cpp::Field
    // PlayerMovement
    pm_instance: il2cpp::Field
    pm_noclip: il2cpp::Field
    // PlayerCamera
    pc_instance: il2cpp::Field
    pc_max_zoom: il2cpp::Field
    pc_current_z: il2cpp::Field
    pc_offset3rd_z_off: i64
    pc_camera_state: il2cpp::Field
    // SaveManager -> ProgressionSaveFile
    sm_instance: il2cpp::Field
    sm_progression: il2cpp::Field
    prog_silver: il2cpp::Field
    // Hook state
    godmode: cell::Cell<bool>
    skip_loading: cell::Cell<bool>
    no_max_level: cell::Cell<bool>
    no_push: cell::Cell<bool>
    freeze_timer: cell::Cell<bool>
    noclip: cell::Cell<bool>
    extended_zoom: cell::Cell<bool>
    zoom_block: il2cpp::VoidBlockHook
    timer_block: il2cpp::VoidBlockHook
    levelup_block: il2cpp::VoidBlockHook
    chest_block: il2cpp::VoidBlockHook
    encounter_block: il2cpp::VoidBlockHook
    detach_camera: cell::Cell<bool>
    // Enum entries
    weapons: [EnumEntry]
    items: [EnumEntry]
    tomes: [EnumEntry]
}

// ---------------------------------------------------------------------------
// IL2CPP proxy structs — auto-generate constructors via #[il2cpp_proxy]
// ---------------------------------------------------------------------------

#[il2cpp_proxy(asm="Assembly-CSharp", ns="Assets.Scripts.Inventory__Items__Pickups", class="PlayerHealth")]
struct HealthProxy {
    #[il2cpp_field="hp"]
    hp: il2cpp::Field
    #[il2cpp_field="maxHp"]
    max_hp: il2cpp::Field
    #[il2cpp_field="shield"]
    shield: il2cpp::Field
    #[il2cpp_field="maxShield"]
    max_shield: il2cpp::Field
    #[il2cpp_method(name="DamagePlayer", params=3)]
    damage: il2cpp::Method
}

#[il2cpp_proxy(asm="Assembly-CSharp", ns="", class="DataManager")]
struct DataProxy {
    #[il2cpp_field="Instance"]
    instance: il2cpp::Field
    #[il2cpp_method(name="GetWeapon", params=1)]
    get_weapon: il2cpp::Method
    #[il2cpp_method(name="GetItem", params=1)]
    get_item: il2cpp::Method
    #[il2cpp_method(name="GetTome", params=1)]
    get_tome: il2cpp::Method
}

#[il2cpp_proxy(asm="Assembly-CSharp", ns="", class="GameManager")]
struct GameManagerProxy {
    #[il2cpp_field="Instance"]
    instance: il2cpp::Field
    #[il2cpp_field="gameTimer"]
    timer: il2cpp::Field
    #[il2cpp_field="lastFoundStageTime"]
    stage_time: il2cpp::Field
    #[il2cpp_field="nextGetStageTime"]
    next_stage_time: il2cpp::Field
    #[il2cpp_field="<dungeonTimeToComplete>k__BackingField"]
    dungeon_time: il2cpp::Field
    #[il2cpp_method(name="Update", params=0)]
    update: il2cpp::Method
}

fn write_f32_raw(addr: i64, value: f32) {
    let buf = bytes::zeroed(4);
    buf.write_f32_le(0, value);
    mem::write_bytes(ptr::from_int(addr), buf);
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

fn enum_entries(cls: il2cpp::Class) -> _ {
    let entries = [];
    for field in cls.fields() {
        if field.is_static() && field.name() != "value__" {
            entries.push(EnumEntry {
                name: field.name(),
                value: field.read_static(),
            });
        }
    }
    entries
}

// ---------------------------------------------------------------------------
// GameRuntime
// ---------------------------------------------------------------------------

impl GameRuntime {
    fn init() -> Result<GameRuntime> {
        let rt = il2cpp::loaded()?;
        log::info("il2cpp runtime loaded");

        let asm = "Assembly-CSharp";
        let player_cls = rt.class(asm, "Assets.Scripts.Actors.Player", "MyPlayer")?;
        log::debug("  MyPlayer class found");
        let health_cls = rt.class(asm, "Assets.Scripts.Inventory__Items__Pickups", "PlayerHealth")?;
        log::debug("  PlayerHealth class found");
        let inv_cls = rt.class(asm, "", "PlayerInventory")?;
        log::debug("  PlayerInventory class found");
        let item_inv_cls = rt.class(asm, "Assets.Scripts.Inventory__Items__Pickups.Items", "ItemInventory")?;
        log::debug("  ItemInventory class found");
        let weapon_inv_cls = rt.class(asm, "Assets.Scripts.Inventory__Items__Pickups.Weapons", "WeaponInventory")?;
        log::debug("  WeaponInventory class found");
        let tome_inv_cls = rt.class(asm, "Assets.Scripts.Inventory__Items__Pickups", "TomeInventory")?;
        log::debug("  TomeInventory class found");
        let dm_cls = rt.class(asm, "", "DataManager")?;
        log::debug("  DataManager class found");
        let gm_cls = rt.class(asm, "", "GameManager")?;
        log::debug("  GameManager class found");
        let pm_cls = rt.class(asm, "", "PlayerMovement")?;
        log::debug("  PlayerMovement class found");
        let pc_cls = rt.class(asm, "", "PlayerCamera")?;
        log::debug("  PlayerCamera class found");
        let sm_cls = rt.class(asm, "", "SaveManager")?;
        log::debug("  SaveManager class found");
        let prog_cls = rt.class(asm, "Assets.Scripts.Saves___Serialization.SaveFiles", "ProgressionSaveFile")?;
        log::debug("  ProgressionSaveFile class found");
        let levelup_cls = rt.class(asm, "", "LevelupScreen")?;
        let chest_ui_cls = rt.class(asm, "", "ChestWindowUi")?;
        let encounter_ui_cls = rt.class(asm, "", "EncounterUi")?;
        log::debug("  LevelupScreen, ChestWindowUi, EncounterUi classes found");
        let weapon_enum = rt.class(asm, "", "EWeapon")?;
        let item_enum = rt.class(asm, "Assets.Scripts.Inventory__Items__Pickups.Items", "EItem")?;
        let tome_enum = rt.class(asm, "Assets.Scripts._Data.Tomes", "ETome")?;
        log::info("all classes found");

        let player_instance = player_cls.field("Instance")?;
        let inventory_field = player_cls.field("inventory")?;
        log::debug("  MyPlayer.Instance, inventory fields found");

        let hp_field = health_cls.field("hp")?;
        let max_hp_field = health_cls.field("maxHp")?;
        let shield_field = health_cls.field("shield")?;
        let max_shield_field = health_cls.field("maxShield")?;
        log::debug("  PlayerHealth fields found (hp, maxHp, shield, maxShield)");

        let player_health_field = inv_cls.field("playerHealth")?;
        let weapon_inv_field = inv_cls.field("weaponInventory")?;
        let item_inv_field = inv_cls.field("itemInventory")?;
        let tome_inv_field = inv_cls.field("tomeInventory")?;
        let gold_int_field = inv_cls.field("<goldInt>k__BackingField")?;
        let gold_float_field = inv_cls.field("<gold>k__BackingField")?;
        log::debug("  PlayerInventory fields found (health, weapons, items, tomes, gold)");

        let add_item_method = item_inv_cls.method("AddItem", 1)?;
        log::debug("  ItemInventory.AddItem(1) found");
        let add_item_n_method = item_inv_cls.method("AddItem", 2)?;
        log::debug("  ItemInventory.AddItem(2) found");
        let remove_item_method = item_inv_cls.method("RemoveItem", 2)?;
        log::debug("  ItemInventory.RemoveItem(2) found");
        let get_item_amount = item_inv_cls.method("GetAmount", 1)?;
        log::debug("  ItemInventory.GetAmount(1) found");

        let add_weapon = weapon_inv_cls.method("AddWeapon", 2)?;
        log::debug("  WeaponInventory.AddWeapon(2) found");
        let get_weapon_level = weapon_inv_cls.method("GetWeaponLevel", 1)?;
        log::debug("  WeaponInventory.GetWeaponLevel(1) found");
        let weapon_is_maxed = weapon_inv_cls.field("isMaxed")?;
        log::debug("  WeaponInventory.isMaxed field found");

        let add_tome = tome_inv_cls.method("AddTome", 3)?;
        log::debug("  TomeInventory.AddTome(3) found");
        let add_maxed_tome = tome_inv_cls.method("AddMaxedTome", 1)?;
        log::debug("  TomeInventory.AddMaxedTome(1) found");
        let get_tome_level = tome_inv_cls.method("GetTomeLevel", 1)?;
        log::debug("  TomeInventory.GetTomeLevel(1) found");
        let has_tome = tome_inv_cls.method("HasTome", 1)?;
        log::debug("  TomeInventory.HasTome(1) found");

        let dm_instance = dm_cls.field("Instance")?;
        let dm_get_weapon = dm_cls.method("GetWeapon", 1)?;
        let dm_get_item = dm_cls.method("GetItem", 1)?;
        let dm_get_tome = dm_cls.method("GetTome", 1)?;
        log::debug("  DataManager fields and methods found");

        let gm_instance = gm_cls.field("Instance")?;
        let gm_timer = gm_cls.field("gameTimer")?;
        let gm_stage_time = gm_cls.field("lastFoundStageTime")?;
        let gm_next_stage_time = gm_cls.field("nextGetStageTime")?;
        let gm_dungeon_time = gm_cls.field("<dungeonTimeToComplete>k__BackingField")?;
        log::debug("  GameManager fields found");

        let pm_instance = pm_cls.field("Instance")?;
        let pm_noclip = pm_cls.field("isNoclipping")?;
        log::debug("  PlayerMovement.Instance, isNoclipping found");

        let pc_instance = pc_cls.field("Instance")?;
        let pc_max_zoom = pc_cls.field("maxExtraZoomoutDistance")?;
        let pc_current_z = pc_cls.field("currentZ")?;
        let pc_offset3rd = pc_cls.field("offset3rdPerson")?;
        let pc_offset3rd_z_off = pc_offset3rd.offset() + 8;
        let pc_camera_state = pc_cls.field("cameraState")?;
        log::debug("  PlayerCamera fields found (offset3rd.z raw offset = {})", pc_offset3rd_z_off);

        let sm_instance = sm_cls.field("<Instance>k__BackingField")?;
        let sm_progression = sm_cls.field("progression")?;
        let prog_silver = prog_cls.field("silver")?;
        log::debug("  SaveManager -> ProgressionSaveFile.silver found");

        // Hook DamagePlayer(Enemy, Vector3, DcFlags) — when godmode is
        // on the hook returns 0 (skip original), otherwise passes through.
        let godmode = cell::new(false);
        let damage_method = health_cls.method("DamagePlayer", 3)?;
        log::info("DamagePlayer found, hooking...");
        damage_method.hook(|ctx| {
            if godmode.get() { Some(0) } else { None }
        });
        log::info("DamagePlayer hooked for godmode");

        // Hook LoadingScreen.LoadSceneAsync to skip loading animation
        let skip_loading = cell::new(false);
        let loading_cls = rt.class(asm, "", "LoadingScreen")?;
        let load_async = loading_cls.method("LoadSceneAsync", 0)?;
        load_async.hook(|ctx| {
            if skip_loading.get() {
                log::debug("skipping load animation");
                Some(il2cpp::null())
            } else {
                None
            }
        });
        log::info("LoadSceneAsync hooked for skip loading");

        // Hook IsMaxLevel on weapons and tomes to remove level cap
        let no_max_level = cell::new(false);
        let weapon_is_max = weapon_inv_cls.method("IsMaxLevel", 1)?;
        weapon_is_max.hook(|ctx| {
            if no_max_level.get() { Some(0) } else { None }
        });
        let tome_is_max = tome_inv_cls.method("IsMaxLevel", 1)?;
        tome_is_max.hook(|ctx| {
            if no_max_level.get() { Some(0) } else { None }
        });
        let inv_util_cls = rt.class(asm, "Assets.Scripts.Inventory__Items__Pickups", "InventoryUtility")?;
        let get_weapon_max = inv_util_cls.method("GetWeaponMaxLevel", 0)?;
        get_weapon_max.hook(|ctx| {
            if no_max_level.get() { Some(999) } else { None }
        });
        let get_tome_max = inv_util_cls.method("GetTomeMaxLevel", 0)?;
        get_tome_max.hook(|ctx| {
            if no_max_level.get() { Some(999) } else { None }
        });
        log::info("IsMaxLevel/GetMaxLevel hooked for no max level");

        // Hook PushPlayer/BouncePlayer on PlayerMovement for no-push
        let no_push = cell::new(false);
        let push_method = pm_cls.method("PushPlayer", 1)?;
        push_method.hook(|ctx| {
            if no_push.get() { Some(0) } else { None }
        });
        let bounce_method = pm_cls.method("BouncePlayer", 1)?;
        bounce_method.hook(|ctx| {
            if no_push.get() { Some(0) } else { None }
        });
        let push_keep_method = pm_cls.method("PushPlayerButKeepMovement", 0)?;
        push_keep_method.hook(|ctx| {
            if no_push.get() { Some(0) } else { None }
        });
        log::info("PushPlayer/BouncePlayer hooked for no push");

        let detach_camera = cell::new(false);
        let player_cam_method = pc_cls.method("PlayerCam", 1)?;
        player_cam_method.hook(|ctx| {
            if detach_camera.get() { Some(0) } else { None }
        });
        log::info("PlayerCamera.PlayerCam hooked for detach camera");

        let freeze_timer = cell::new(false);
        let gm_update = gm_cls.method("Update", 0)?;
        let timer_block = gm_update.hook_void_block();
        log::info("GameManager.Update void-blocked for freeze timer");

        let show_levelup = levelup_cls.method("ShowLevelupScreen", 0)?;
        let levelup_block = show_levelup.hook_void_block();
        log::info("LevelupScreen.ShowLevelupScreen void-blocked");

        let chest_open = chest_ui_cls.method("Open", 1)?;
        let chest_block = chest_open.hook_void_block();
        log::info("ChestWindowUi.Open void-blocked");

        let encounter_open = encounter_ui_cls.method("Open", 1)?;
        let encounter_block = encounter_open.hook_void_block();
        log::info("EncounterUi.Open void-blocked");

        let noclip = cell::new(false);
        let extended_zoom = cell::new(false);
        let update_zoom = pc_cls.method("UpdateZoom", 0)?;
        let zoom_block = update_zoom.hook_void_block();
        log::info("PlayerCamera.UpdateZoom void-blocked for manual zoom");

        let weapons = enum_entries(weapon_enum);
        let items = enum_entries(item_enum);
        let tomes = enum_entries(tome_enum);
        log::info("discovered {} weapons, {} items, {} tomes",
            weapons.len(), items.len(), tomes.len());

        Ok(GameRuntime {
            rt,
            player_instance,
            inventory_field,
            hp_field,
            max_hp_field,
            shield_field,
            max_shield_field,
            player_health_field,
            weapon_inv_field,
            item_inv_field,
            tome_inv_field,
            gold_int_field,
            gold_float_field,
            add_item_method,
            add_item_n_method,
            remove_item_method,
            get_item_amount,
            add_weapon,
            get_weapon_level,
            weapon_is_maxed,
            add_tome,
            add_maxed_tome,
            get_tome_level,
            has_tome,
            dm_instance,
            dm_get_weapon,
            dm_get_item,
            dm_get_tome,
            gm_instance,
            gm_timer,
            gm_stage_time,
            gm_next_stage_time,
            gm_dungeon_time,
            pm_instance,
            pm_noclip,
            pc_instance,
            pc_max_zoom,
            pc_current_z,
            pc_offset3rd_z_off,
            pc_camera_state,
            sm_instance,
            sm_progression,
            prog_silver,
            godmode,
            skip_loading,
            no_max_level,
            no_push,
            freeze_timer,
            noclip,
            extended_zoom,
            zoom_block,
            timer_block,
            levelup_block,
            chest_block,
            encounter_block,
            detach_camera,
            weapons,
            items,
            tomes,
        })
    }

    fn player(self) -> il2cpp::Object {
        self.player_instance.read_static()
    }

    fn in_game(self) -> bool {
        !self.player().is_null()
    }

    fn inventory(self) -> il2cpp::Object {
        let p = self.player();
        if p.is_null() { return il2cpp::null(); }
        self.inventory_field.read(p)
    }

    fn health_obj(self) -> il2cpp::Object {
        let inv = self.inventory();
        if inv.is_null() { return il2cpp::null(); }
        self.player_health_field.read(inv)
    }

    fn item_inv(self) -> il2cpp::Object {
        let inv = self.inventory();
        if inv.is_null() { return il2cpp::null(); }
        self.item_inv_field.read(inv)
    }

    fn weapon_inv(self) -> il2cpp::Object {
        let inv = self.inventory();
        if inv.is_null() { return il2cpp::null(); }
        self.weapon_inv_field.read(inv)
    }

    fn tome_inv(self) -> il2cpp::Object {
        let inv = self.inventory();
        if inv.is_null() { return il2cpp::null(); }
        self.tome_inv_field.read(inv)
    }

    fn data_manager(self) -> il2cpp::Object {
        self.dm_instance.read_static()
    }

    fn game_manager(self) -> il2cpp::Object {
        self.gm_instance.read_static()
    }

    fn player_movement(self) -> il2cpp::Object {
        self.pm_instance.read_static()
    }

    fn player_camera(self) -> il2cpp::Object {
        self.pc_instance.read_static()
    }

    // --- Combat ---

    fn set_godmode(self, enabled: bool) {
        self.godmode.set(enabled);
    }

    fn is_godmode(self) -> bool {
        self.godmode.get()
    }

    fn read_health(self) -> Option<HealthInfo> {
        let h = self.health_obj();
        if h.is_null() { return None; }
        Some(HealthInfo {
            hp: self.hp_field.read(h),
            max_hp: self.max_hp_field.read(h),
            shield: self.shield_field.read(h),
            max_shield: self.max_shield_field.read(h),
        })
    }

    fn full_heal(self) {
        let h = self.health_obj();
        if h.is_null() { return; }
        let max = self.max_hp_field.read(h);
        self.hp_field.write(h, max);
    }

    fn max_shield(self) {
        let h = self.health_obj();
        if h.is_null() { return; }
        let max = self.max_shield_field.read(h);
        self.shield_field.write(h, max);
    }

    // --- Timer ---

    fn get_timer(self) -> f32 {
        let gm = self.game_manager();
        if gm.is_null() { return 0.0; }
        self.gm_timer.read(gm)
    }

    fn set_timer(self, value: f32) {
        let gm = self.game_manager();
        if gm.is_null() { return; }
        self.gm_timer.write(gm, value);
    }

    fn get_stage_time_max(self) -> f32 {
        let gm = self.game_manager();
        if gm.is_null() { return 0.0; }
        self.gm_stage_time.read(gm)
    }

    fn get_round_remaining(self) -> f32 {
        let max = self.get_stage_time_max();
        let current = self.get_timer();
        let rem = max - current;
        if rem < 0.0 { 0.0 } else { rem }
    }

    fn set_round_remaining(self, seconds: f32) {
        let gm = self.game_manager();
        if gm.is_null() { return; }
        let current = self.gm_timer.read(gm);
        let old_stage = self.gm_stage_time.read(gm);
        let new_stage = current + seconds;
        let delta = new_stage - old_stage;
        self.gm_stage_time.write(gm, new_stage);
        self.gm_next_stage_time.write(gm, current + 99999.0);
        let old_dungeon = self.gm_dungeon_time.read(gm);
        self.gm_dungeon_time.write(gm, old_dungeon + delta);
    }

    // --- Camera ---

    fn set_max_zoom(self, value: f32) {
        let pc = self.player_camera();
        if pc.is_null() { return; }
        self.pc_max_zoom.write(pc, value);
    }

    fn set_camera_z(self, value: f32) {
        let pc = self.player_camera();
        if pc.is_null() { return; }
        self.pc_current_z.write(pc, value);
        write_f32_raw(pc.address() + self.pc_offset3rd_z_off, value);
    }

    fn set_noclip(self, enabled: bool) {
        let pm = self.player_movement();
        if pm.is_null() { return; }
        self.pm_noclip.write(pm, enabled);
    }

    fn reset_camera(self) {
        self.noclip.set(false);
        self.set_noclip(false);
        self.detach_camera.set(false);
        self.extended_zoom.set(false);
        self.zoom_block.set_blocked(false);
        self.set_max_zoom(0.0);
        let pc = self.player_camera();
        if !pc.is_null() {
            self.pc_camera_state.write(pc, 1);
        }
    }

    // --- Silver ---

    fn get_silver(self) -> i32 {
        let sm = self.sm_instance.read_static();
        if sm.is_null() { return 0; }
        let prog = self.sm_progression.read(sm);
        if prog.is_null() { return 0; }
        self.prog_silver.read(prog)
    }

    fn set_silver(self, value: i32) {
        let sm = self.sm_instance.read_static();
        if sm.is_null() { return; }
        let prog = self.sm_progression.read(sm);
        if prog.is_null() { return; }
        self.prog_silver.write(prog, value);
    }

    // --- Gold (direct field write to avoid ChangeGold event crash) ---

    fn get_gold(self) -> i32 {
        let inv = self.inventory();
        if inv.is_null() { return 0; }
        self.gold_int_field.read(inv)
    }

    fn set_gold(self, amount: i32) {
        let inv = self.inventory();
        if inv.is_null() { return; }
        self.gold_int_field.write(inv, amount);
        self.gold_float_field.write(inv, amount);
    }

    // --- Items ---

    fn add_item(self, value: i32) {
        let ii = self.item_inv();
        if ii.is_null() { return; }
        self.add_item_method.invoke_on_main(ii, value);
    }

    fn add_item_n(self, value: i32, n: i32) {
        let ii = self.item_inv();
        if ii.is_null() { return; }
        self.add_item_n_method.invoke_on_main(ii, value, n);
    }

    fn remove_item(self, value: i32) {
        let ii = self.item_inv();
        if ii.is_null() { return; }
        self.remove_item_method.invoke_on_main(ii, value, false);
    }

    fn get_item_count(self, value: i32) -> i32 {
        let ii = self.item_inv();
        if ii.is_null() { return 0; }
        self.get_item_amount.invoke(ii, value)
    }

    // --- Weapons ---

    fn unlock_weapon_cap(self) {
        let wi = self.weapon_inv();
        if wi.is_null() { return; }
        self.weapon_is_maxed.write(wi, false);
    }

    fn add_weapon_by_enum(self, value: i32) {
        let dm = self.data_manager();
        if dm.is_null() { return; }
        let weapon_data = self.dm_get_weapon.invoke(dm, value);
        if weapon_data.is_null() { return; }
        let wi = self.weapon_inv();
        if wi.is_null() { return; }
        self.add_weapon.invoke_on_main(wi, weapon_data, il2cpp::null());
    }

    fn get_weapon_lvl(self, value: i32) -> i32 {
        let wi = self.weapon_inv();
        if wi.is_null() { return 0; }
        self.get_weapon_level.invoke(wi, value)
    }

    fn add_weapon_n(self, value: i32, n: i32) {
        let i = 0;
        while i < n {
            self.add_weapon_by_enum(value);
            i = i + 1;
        }
    }

    fn add_weapon_max(self, value: i32) {
        self.add_weapon_n(value, 100);
    }

    // --- Tomes ---
    // AddTome(TomeData, List<StatModifier>, ERarity) — pass null modifiers, rarity 0
    // AddMaxedTome(TomeData) — adds at max level

    fn add_tome_by_enum(self, value: i32) {
        let dm = self.data_manager();
        if dm.is_null() { return; }
        let tome_data = self.dm_get_tome.invoke(dm, value);
        if tome_data.is_null() { return; }
        let ti = self.tome_inv();
        if ti.is_null() { return; }
        self.add_tome.invoke_on_main(ti, tome_data, il2cpp::null(), 0);
    }

    fn add_tome_n(self, value: i32, n: i32) {
        let i = 0;
        while i < n {
            self.add_tome_by_enum(value);
            i = i + 1;
        }
    }

    fn add_maxed_tome_by_enum(self, value: i32) {
        let dm = self.data_manager();
        if dm.is_null() { return; }
        let tome_data = self.dm_get_tome.invoke(dm, value);
        if tome_data.is_null() { return; }
        let ti = self.tome_inv();
        if ti.is_null() { return; }
        self.add_maxed_tome.invoke_on_main(ti, tome_data);
    }

    fn get_tome_lvl(self, value: i32) -> i32 {
        let ti = self.tome_inv();
        if ti.is_null() { return 0; }
        self.get_tome_level.invoke(ti, value)
    }
}

// ---------------------------------------------------------------------------
// UI draw helpers
// ---------------------------------------------------------------------------

fn draw_combat(ui: egui::Ui, game: GameRuntime) {
    ui.heading("Combat");
    let godmode = game.is_godmode();
    let new_godmode = ui.checkbox(godmode, "Godmode");
    if new_godmode != godmode {
        game.set_godmode(new_godmode);
    }

    let no_push = game.no_push.get();
    let new_no_push = ui.checkbox(no_push, "No push / knockback");
    if new_no_push != no_push {
        game.no_push.set(new_no_push);
    }

    let skip = game.skip_loading.get();
    let new_skip = ui.checkbox(skip, "Skip loading animation");
    if new_skip != skip {
        game.skip_loading.set(new_skip);
    }

    let no_max = game.no_max_level.get();
    let new_no_max = ui.checkbox(no_max, "No max level cap");
    if new_no_max != no_max {
        game.no_max_level.set(new_no_max);
    }

    let skip_levelup = game.levelup_block.is_blocked();
    let new_skip_levelup = ui.checkbox(skip_levelup, "Skip upgrade offers");
    if new_skip_levelup != skip_levelup {
        game.levelup_block.set_blocked(new_skip_levelup);
        game.chest_block.set_blocked(new_skip_levelup);
        game.encounter_block.set_blocked(new_skip_levelup);
    }

    match game.read_health() {
        Some(h) => {
            ui.small(fmt::format("HP: {}/{}  Shield: {}/{}",
                h.hp, h.max_hp, h.shield, h.max_shield));
            ui.horizontal(|row| {
                if row.button("Full heal") { game.full_heal(); }
                if row.button("Max shield") { game.max_shield(); }
            });
        }
        None => {}
    }
}

fn draw_timer(ui: egui::Ui, game: GameRuntime, state: UiState) {
    let remaining = game.get_round_remaining();
    let total_secs = remaining.to_int();
    let mins = total_secs / 60;
    let secs = total_secs - mins * 60;
    ui.heading(fmt::format("Round: {}m {}s", mins, secs));

    let frozen = game.timer_block.is_blocked();
    let new_frozen = ui.checkbox(frozen, "Freeze timer");
    if new_frozen != frozen {
        game.timer_block.set_blocked(new_frozen);
        game.freeze_timer.set(new_frozen);
        if new_frozen {
            state.timer_value.set(remaining);
        }
    }

    let new_val = ui.slider_float("Set to (seconds)", state.timer_value.get(), 0.0, 1200.0);
    state.timer_value.set(new_val);
    ui.horizontal(|row| {
        if row.button("Set") { game.set_round_remaining(state.timer_value.get()); }
        if row.button("+60s") {
            let t = game.get_round_remaining() + 60.0;
            game.set_round_remaining(t);
            state.timer_value.set(t);
        }
        if row.button("+300s") {
            let t = game.get_round_remaining() + 300.0;
            game.set_round_remaining(t);
            state.timer_value.set(t);
        }
        if row.button("Reset (10m)") {
            game.set_round_remaining(600.0);
            state.timer_value.set(600.0);
        }
    });
}

fn draw_camera(ui: egui::Ui, game: GameRuntime) {
    ui.heading("Camera");

    let ext = game.extended_zoom.get();
    let new_ext = ui.checkbox(ext, "Extended zoom range");
    if new_ext != ext {
        game.extended_zoom.set(new_ext);
        if new_ext {
            game.set_max_zoom(50.0);
        } else {
            game.set_max_zoom(0.0);
        }
    }

    let blocked = game.zoom_block.is_blocked();
    let new_blocked = ui.checkbox(blocked, "Manual zoom (blocks game zoom)");
    if new_blocked != blocked {
        game.zoom_block.set_blocked(new_blocked);
    }

    let pc = game.player_camera();
    if !pc.is_null() {
        let cur_z = game.pc_current_z.read(pc);
        let new_z = ui.slider_float("Zoom", cur_z, -5.0, 60.0);
        if new_z != cur_z {
            game.zoom_block.set_blocked(true);
            game.set_camera_z(new_z);
        }
        if game.zoom_block.is_blocked() {
            game.set_camera_z(cur_z);
        }
    }

    let detach = game.detach_camera.get();
    let new_detach = ui.checkbox(detach, "Detach camera from player");
    if new_detach != detach {
        game.detach_camera.set(new_detach);
    }

    let noclip = game.noclip.get();
    let new_noclip = ui.checkbox(noclip, "Noclip (fly mode, moves player)");
    if new_noclip != noclip {
        game.noclip.set(new_noclip);
        game.set_noclip(new_noclip);
    }
    if game.noclip.get() {
        game.set_noclip(true);
    }

    if ui.button("Reset camera") {
        game.reset_camera();
    }
}

fn draw_speed(ui: egui::Ui) {
    ui.heading("Speed");
    let speed = ui.slider_float("Time scale", time::scale(), 0.0, 5.0);
    time::set_scale(speed);
    ui.horizontal(|row| {
        if row.button("pause") { time::set_scale(0.0); }
        if row.button("0.5x")  { time::set_scale(0.5); }
        if row.button("1x")    { time::set_scale(1.0); }
        if row.button("2x")    { time::set_scale(2.0); }
        if row.button("5x")    { time::set_scale(5.0); }
    });
}

fn draw_gold(ui: egui::Ui, game: GameRuntime, state: UiState) {
    ui.heading(fmt::format("Gold: {}", game.get_gold()));
    let new_amount = ui.slider_int("Amount", state.gold_amount.get(), 0, 99999);
    state.gold_amount.set(new_amount);
    ui.horizontal(|row| {
        if row.button("Set") { game.set_gold(state.gold_amount.get()); }
        if row.button("+1k") { game.set_gold(game.get_gold() + 1000); }
        if row.button("+10k") { game.set_gold(game.get_gold() + 10000); }
    });
}

fn draw_silver(ui: egui::Ui, game: GameRuntime, state: UiState) {
    ui.heading(fmt::format("Silver: {}", game.get_silver()));
    let new_amount = ui.slider_int("Amount", state.silver_amount.get(), 0, 99999);
    state.silver_amount.set(new_amount);
    ui.horizontal(|row| {
        if row.button("Set") { game.set_silver(state.silver_amount.get()); }
        if row.button("+1k") { game.set_silver(game.get_silver() + 1000); }
        if row.button("+10k") { game.set_silver(game.get_silver() + 10000); }
    });
}

fn draw_weapons(ui: egui::Ui, game: GameRuntime, state: UiState) {
    let owned = [];
    for entry in game.weapons {
        if entry.name == "None" || entry.name == "Test" { continue; }
        let lvl = game.get_weapon_lvl(entry.value);
        if lvl > 0 {
            owned.push(entry);
        }
    }

    ui.horizontal(|row| {
        if row.button("Add all") {
            for entry in game.weapons {
                if entry.name == "None" || entry.name == "Test" { continue; }
                if game.get_weapon_lvl(entry.value) == 0 {
                    game.unlock_weapon_cap();
                    game.add_weapon_by_enum(entry.value);
                }
            }
        }
        if row.button("+100 all") {
            for entry in owned {
                game.unlock_weapon_cap();
                game.add_weapon_n(entry.value, 100);
            }
        }
    });

    if owned.len() > 0 {
        ui.collapsing(fmt::format("Owned ({})", owned.len()), |section| {
            section.grid("weapons_owned", 4, |g| {
                for entry in owned {
                    let lvl = game.get_weapon_lvl(entry.value);
                    g.label(fmt::format("{} lv{}", entry.name, lvl));
                    if g.button("+") {
                        game.unlock_weapon_cap();
                        game.add_weapon_by_enum(entry.value);
                    }
                    if g.button("+10") {
                        game.unlock_weapon_cap();
                        game.add_weapon_n(entry.value, 10);
                    }
                    if g.button("+100") {
                        game.unlock_weapon_cap();
                        game.add_weapon_max(entry.value);
                    }
                    g.end_row();
                }
            });
        });
    } else {
        ui.small("no weapons");
    }

    ui.separator();
    ui.small("Add weapon:");
    let new_search = ui.text_edit(state.weapon_search.get());
    state.weapon_search.set(new_search);
    let query = new_search.to_lower();
    ui.scroll(150.0, |scroll| {
        for entry in game.weapons {
            if entry.name == "None" || entry.name == "Test" { continue; }
            if game.get_weapon_lvl(entry.value) > 0 { continue; }
            if query != "" && !entry.name.to_lower().contains(query) {
                continue;
            }
            scroll.horizontal(|row| {
                if row.button("+") {
                    game.unlock_weapon_cap();
                    game.add_weapon_by_enum(entry.value);
                }
                row.label(entry.name);
            });
        }
    });
}

fn draw_tomes(ui: egui::Ui, game: GameRuntime, state: UiState) {
    let owned = [];
    for entry in game.tomes {
        let lvl = game.get_tome_lvl(entry.value);
        if lvl > 0 {
            owned.push(entry);
        }
    }

    ui.horizontal(|row| {
        if row.button("Add all") {
            let pass = 0;
            while pass < 2 {
                for entry in game.tomes {
                    if game.get_tome_lvl(entry.value) == 0 {
                        game.add_tome_by_enum(entry.value);
                    }
                }
                pass = pass + 1;
            }
        }
        if row.button("+100 all") {
            for entry in owned {
                game.add_tome_n(entry.value, 100);
            }
        }
        if row.button("Max all") {
            for entry in owned {
                game.add_maxed_tome_by_enum(entry.value);
            }
        }
    });

    if owned.len() > 0 {
        ui.collapsing(fmt::format("Owned ({})", owned.len()), |section| {
            section.grid("tomes_owned", 5, |g| {
                for entry in owned {
                    let lvl = game.get_tome_lvl(entry.value);
                    g.label(fmt::format("{} lv{}", entry.name, lvl));
                    if g.button("+") { game.add_tome_by_enum(entry.value); }
                    if g.button("+10") { game.add_tome_n(entry.value, 10); }
                    if g.button("+100") { game.add_tome_n(entry.value, 100); }
                    if g.button("max") { game.add_maxed_tome_by_enum(entry.value); }
                    g.end_row();
                }
            });
        });
    } else {
        ui.small("no tomes");
    }

    ui.separator();
    ui.small("Add tome:");
    let new_search = ui.text_edit(state.tome_search.get());
    state.tome_search.set(new_search);
    let query = new_search.to_lower();
    ui.scroll(150.0, |scroll| {
        for entry in game.tomes {
            if game.get_tome_lvl(entry.value) > 0 { continue; }
            if query != "" && !entry.name.to_lower().contains(query) {
                continue;
            }
            scroll.horizontal(|row| {
                if row.button("+") { game.add_tome_by_enum(entry.value); }
                row.label(entry.name);
            });
        }
    });
}

fn draw_items(ui: egui::Ui, game: GameRuntime, state: UiState) {
    let owned = [];
    for entry in game.items {
        let count = game.get_item_count(entry.value);
        if count > 0 {
            owned.push(entry);
        }
    }

    ui.horizontal(|row| {
        if row.button("Add all") {
            let pass = 0;
            while pass < 2 {
                for entry in game.items {
                    if game.get_item_count(entry.value) == 0 {
                        game.add_item(entry.value);
                    }
                }
                pass = pass + 1;
            }
        }
        if row.button("+100 all") {
            for entry in owned {
                game.add_item_n(entry.value, 100);
            }
        }
    });

    if owned.len() > 0 {
        ui.collapsing(fmt::format("Owned ({})", owned.len()), |section| {
            section.grid("items_owned", 5, |g| {
                for entry in owned {
                    let count = game.get_item_count(entry.value);
                    g.label(fmt::format("{} x{}", entry.name, count));
                    if g.button("+") { game.add_item(entry.value); }
                    if g.button("+10") { game.add_item_n(entry.value, 10); }
                    if g.button("+100") { game.add_item_n(entry.value, 100); }
                    if g.button("-") { game.remove_item(entry.value); }
                    g.end_row();
                }
            });
        });
    } else {
        ui.small("no items");
    }

    ui.separator();
    ui.small("Add item:");
    let new_search = ui.text_edit(state.item_search.get());
    state.item_search.set(new_search);
    let query = new_search.to_lower();
    ui.scroll(150.0, |scroll| {
        for entry in game.items {
            if game.get_item_count(entry.value) > 0 { continue; }
            if query != "" && !entry.name.to_lower().contains(query) {
                continue;
            }
            scroll.horizontal(|row| {
                if row.button("+") { game.add_item(entry.value); }
                if row.button("+10") { game.add_item_n(entry.value, 10); }
                row.label(entry.name);
            });
        }
    });
}

// ---------------------------------------------------------------------------
// Entry points
// ---------------------------------------------------------------------------

fn ctor() {
    log::subscriber().to_file("/tmp/megabonk.log").truncate().with_max_level("debug").init();
    egui::init();
    egui::set_scale(0.75);
}

fn stub_main() {
    log::info("megabonk trainer starting");

    let visible = true;
    let f1_down = false;

    // Mutable UI state in a list — list elements are Arc-shared, so
    // writes propagate through nested closures (window_sized, etc).
    let state = new_ui_state();

    // Runtime (lazy init)
    let rt: Option<GameRuntime> = None;
    let rt_error: Option<str> = None;

    egui::run(|ctx| {
        let f1 = ctx.key("f1");
        if f1 && !f1_down {
            visible = !visible;
        }
        f1_down = f1;

        if !visible { return; }

        // Lazy-init after Il2Cpp is ready
        if rt.is_none() && rt_error.is_none() {
            match GameRuntime::init() {
                Ok(game) => { rt = Some(game); }
                Err(e) => {
                    log::info("init error: {}", e);
                    rt_error = Some(e);
                }
            }
        }

        ctx.window_sized("Megabonk Trainer", 360.0, |ui| {
            ui.small(fmt::format("frame {} | xur-stub", egui::frame_count()));

            match rt_error {
                Some(msg) => {
                    ui.separator();
                    ui.colored_label(255, 80, 80, fmt::format("init error: {}", msg));
                    return;
                }
                None => {}
            }

            let game = match rt {
                Some(g) => g,
                None => {
                    ui.separator();
                    ui.small("waiting for Il2Cpp runtime...");
                    return;
                }
            };

            if !game.in_game() {
                ui.separator();
                ui.small("not in game (main menu)");
                ui.separator();
                draw_silver(ui, game, state);
                return;
            }

            ui.separator();
            draw_combat(ui, game);
            ui.separator();
            draw_timer(ui, game, state);
            ui.separator();
            draw_camera(ui, game);
            ui.separator();
            draw_speed(ui);
            ui.separator();
            draw_gold(ui, game, state);
            ui.separator();
            draw_silver(ui, game, state);
            ui.separator();

            ui.collapsing("Weapons", |section| {
                draw_weapons(section, game, state);
            });
            ui.collapsing("Tomes", |section| {
                draw_tomes(section, game, state);
            });
            ui.collapsing("Items", |section| {
                draw_items(section, game, state);
            });
        });
    });
}
