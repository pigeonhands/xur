// Slay the Spire 2 trainer — Godot + CoreCLR (.NET 9) game mod with
// standalone egui window.
//
// Loads into the game via LD_PRELOAD, captures the CoreCLR runtime,
// resolves game methods, and spawns a trainer window for modifying
// gold, energy, HP, and other stats.
//
//     cargo build --release -p xur-stub --features godot
//     # Steam > Slay the Spire 2 > Properties > Launch options:
//     XUR_STUB_PATH=xur-stub/example/sts2.xur \
//         LD_PRELOAD=target/release/libxur_stub.so %command%

use std::cell;
use std::fmt;
use std::gui;
use std::log;
use std::stub::godot;

// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------

struct GameMethods {
    rt: godot::Runtime
    // RunManager
    get_rm_instance: godot::MethodPtr
    // RunManager → RunState (private getter, resolved via NonPublic binding)
    get_state: godot::MethodPtr
    // Player properties
    get_gold: godot::MethodPtr
    set_gold: godot::MethodPtr
    get_max_energy: godot::MethodPtr
    set_max_energy: godot::MethodPtr
    get_combat_state: godot::MethodPtr
    // PlayerCombatState
    get_energy: godot::MethodPtr
    set_energy: godot::MethodPtr
    get_max_energy_combat: godot::MethodPtr
    gain_energy: godot::MethodPtr
    get_stars: godot::MethodPtr
    gain_stars: godot::MethodPtr
    // Creature (HP/Block)
    get_current_hp: godot::MethodPtr
    get_max_hp: godot::MethodPtr
    get_block: godot::MethodPtr
    heal_internal: godot::MethodPtr
    set_max_hp_internal: godot::MethodPtr
    gain_block_internal: godot::MethodPtr
    // Player → Creature
    get_creature: godot::MethodPtr
    // Captured references
    player_ref: godot::CapturedRef
    // Godmode toggle (affects all creatures — blocks LoseHpInternal globally)
    godmode: cell::Cell<bool>
}

struct UiState {
    gold_amount: cell::Cell<i32>
    energy_amount: cell::Cell<i32>
}

fn new_ui_state() -> UiState {
    UiState {
        gold_amount: cell::new(9999),
        energy_amount: cell::new(10),
    }
}

// ---------------------------------------------------------------------------
// GameMethods — resolve all method pointers
// ---------------------------------------------------------------------------

impl GameMethods {
    fn init(rt: godot::Runtime) -> Result<GameMethods> {
        let asm = "sts2";
        let player_t = "MegaCrit.Sts2.Core.Entities.Players.Player";
        let pcs_t = "MegaCrit.Sts2.Core.Entities.Players.PlayerCombatState";
        let creature_t = "MegaCrit.Sts2.Core.Entities.Creatures.Creature";
        let rm_t = "MegaCrit.Sts2.Core.Runs.RunManager";

        log::info("resolving RunManager...");
        let get_rm_instance = rt.method(asm, rm_t, "get_Instance")?;
        let get_state = rt.method(asm, rm_t, "get_State")?;

        log::info("resolving Player methods...");
        let get_gold = rt.method(asm, player_t, "get_Gold")?;
        let set_gold = rt.method(asm, player_t, "set_Gold")?;
        let get_max_energy = rt.method(asm, player_t, "get_MaxEnergy")?;
        let set_max_energy = rt.method(asm, player_t, "set_MaxEnergy")?;
        let get_combat_state = rt.method(asm, player_t, "get_PlayerCombatState")?;
        let get_creature = rt.method(asm, player_t, "get_Creature")?;

        log::info("resolving PlayerCombatState methods...");
        let get_energy = rt.method(asm, pcs_t, "get_Energy")?;
        let set_energy = rt.method(asm, pcs_t, "set_Energy")?;
        let get_max_energy_combat = rt.method(asm, pcs_t, "get_MaxEnergy")?;
        let gain_energy = rt.method(asm, pcs_t, "GainEnergy")?;
        let get_stars = rt.method(asm, pcs_t, "get_Stars")?;
        let gain_stars = rt.method(asm, pcs_t, "GainStars")?;

        log::info("resolving Creature methods...");
        let get_current_hp = rt.method(asm, creature_t, "get_CurrentHp")?;
        let get_max_hp = rt.method(asm, creature_t, "get_MaxHp")?;
        let get_block = rt.method(asm, creature_t, "get_Block")?;
        let heal_internal = rt.method(asm, creature_t, "HealInternal")?;
        let set_max_hp_internal = rt.method(asm, creature_t, "SetMaxHpInternal")?;
        let gain_block_internal = rt.method(asm, creature_t, "GainBlockInternal")?;

        log::info("setting up capture hooks...");
        let player_ref = get_creature.capture_this();
        log::info("player capture hook installed");

        // Godmode — hook LoseHpInternal and DamageBlockInternal on
        // Creature. When godmode is on, returns Some(0) to skip the
        // method for all creatures.
        let godmode = cell::new(false);
        let lose_hp_ptr = rt.method(asm, creature_t, "LoseHpInternal")?;
        let damage_block_ptr = rt.method(asm, creature_t, "DamageBlockInternal")?;
        lose_hp_ptr.hook(|| {
            if godmode.get() { Some(0) } else { None }
        });
        damage_block_ptr.hook(|| {
            if godmode.get() { Some(0) } else { None }
        });
        log::info("godmode hooks installed");

        Ok(GameMethods {
            rt,
            get_rm_instance,
            get_state,
            get_gold,
            set_gold,
            get_max_energy,
            set_max_energy,
            get_combat_state,
            get_energy,
            set_energy,
            get_max_energy_combat,
            gain_energy,
            get_stars,
            gain_stars,
            get_current_hp,
            get_max_hp,
            get_block,
            heal_internal,
            set_max_hp_internal,
            gain_block_internal,
            get_creature,
            player_ref,
            godmode,
        })
    }

    fn player(self) -> godot::ManagedObject {
        self.player_ref.get()
    }

    fn in_game(self) -> bool {
        !self.player().is_null()
    }

    fn creature(self) -> godot::ManagedObject {
        let p = self.player();
        if p.is_null() { return godot::null(); }
        self.get_creature.call_ptr(p)
    }

    fn combat_state(self) -> godot::ManagedObject {
        let p = self.player();
        if p.is_null() { return godot::null(); }
        self.get_combat_state.call_ptr(p)
    }

    // --- Gold ---

    fn gold(self) -> i32 {
        let p = self.player();
        if p.is_null() { return -1; }
        self.get_gold.call(p)
    }

    fn set_gold_to(self, amount: i32) {
        let p = self.player();
        if p.is_null() { return; }
        self.set_gold.call(p, amount);
    }

    // --- Energy ---

    fn max_energy(self) -> i32 {
        let p = self.player();
        if p.is_null() { return -1; }
        self.get_max_energy.call(p)
    }

    fn set_max_energy_to(self, amount: i32) {
        let p = self.player();
        if p.is_null() { return; }
        self.set_max_energy.call(p, amount);
    }

    fn combat_energy(self) -> i32 {
        let pcs = self.combat_state();
        if pcs.is_null() { return -1; }
        self.get_energy.call(pcs)
    }

    fn set_combat_energy(self, amount: i32) {
        let pcs = self.combat_state();
        if pcs.is_null() { return; }
        self.set_energy.call(pcs, amount);
    }

    fn combat_max_energy(self) -> i32 {
        let pcs = self.combat_state();
        if pcs.is_null() { return -1; }
        self.get_max_energy_combat.call(pcs)
    }

    fn add_energy(self, amount: i32) {
        let pcs = self.combat_state();
        if pcs.is_null() { return; }
        self.gain_energy.call(pcs, amount);
    }

    // --- Stars ---

    fn stars(self) -> i32 {
        let pcs = self.combat_state();
        if pcs.is_null() { return -1; }
        self.get_stars.call(pcs)
    }

    fn add_stars(self, amount: i32) {
        let pcs = self.combat_state();
        if pcs.is_null() { return; }
        self.gain_stars.call(pcs, amount);
    }

    // --- HP ---

    fn hp(self) -> i32 {
        let c = self.creature();
        if c.is_null() { return -1; }
        self.get_current_hp.call(c)
    }

    fn max_hp(self) -> i32 {
        let c = self.creature();
        if c.is_null() { return -1; }
        self.get_max_hp.call(c)
    }

    fn block(self) -> i32 {
        let c = self.creature();
        if c.is_null() { return -1; }
        self.get_block.call(c)
    }

    fn full_heal(self) {
        let c = self.creature();
        if c.is_null() { return; }
        let max = self.get_max_hp.call(c);
        self.heal_internal.call(c, max);
    }

    fn add_block(self, amount: i32) {
        let c = self.creature();
        if c.is_null() { return; }
        self.gain_block_internal.call(c, amount);
    }

    // --- Godmode ---

    fn set_godmode(self, enabled: bool) {
        self.godmode.set(enabled);
    }

    fn is_godmode(self) -> bool {
        self.godmode.get()
    }
}

// ---------------------------------------------------------------------------
// UI drawing
// ---------------------------------------------------------------------------

fn draw_status(ui: gui::Ui, game: GameMethods) {
    let hp = game.hp();
    let max = game.max_hp();
    let blk = game.block();
    if hp >= 0 {
        ui.label(fmt::format("HP: {}/{} | Block: {}", hp, max, blk));
    }

    let energy = game.combat_energy();
    let max_e = game.combat_max_energy();
    if energy >= 0 {
        ui.label(fmt::format("Energy: {}/{}", energy, max_e));
    }

    let stars = game.stars();
    if stars >= 0 {
        ui.label(fmt::format("Stars: {}", stars));
    }

    ui.label(fmt::format("Gold: {}", game.gold()));
}

fn draw_combat(ui: gui::Ui, game: GameMethods) {
    ui.heading("Combat");

    let godmode = game.is_godmode();
    let new_godmode = ui.checkbox(godmode, "Godmode (all creatures)");
    if new_godmode != godmode {
        game.set_godmode(new_godmode);
    }

    ui.horizontal(|row| {
        if row.button("Full heal") { game.full_heal(); }
        if row.button("+50 Block") { game.add_block(50); }
        if row.button("+999 Block") { game.add_block(999); }
    });

    ui.horizontal(|row| {
        if row.button("Max energy") {
            let max = game.combat_max_energy();
            if max > 0 { game.set_combat_energy(max); }
        }
        if row.button("+5 Energy") { game.add_energy(5); }
        if row.button("+99 Energy") { game.add_energy(99); }
    });

    ui.horizontal(|row| {
        if row.button("+10 Stars") { game.add_stars(10); }
        if row.button("+100 Stars") { game.add_stars(100); }
    });
}

fn draw_gold(ui: gui::Ui, game: GameMethods, state: UiState) {
    ui.heading(fmt::format("Gold: {}", game.gold()));
    let new_amount = ui.slider_int("Amount", state.gold_amount.get(), 0, 99999);
    state.gold_amount.set(new_amount);
    ui.horizontal(|row| {
        if row.button("Set") { game.set_gold_to(state.gold_amount.get()); }
        if row.button("+1k") { game.set_gold_to(game.gold() + 1000); }
        if row.button("+10k") { game.set_gold_to(game.gold() + 10000); }
    });
}

fn draw_player(ui: gui::Ui, game: GameMethods) {
    ui.heading("Player Stats");

    let me = game.max_energy();
    ui.label(fmt::format("Max Energy: {}", me));
    ui.horizontal(|row| {
        if row.button("Set 5") { game.set_max_energy_to(5); }
        if row.button("Set 10") { game.set_max_energy_to(10); }
        if row.button("Set 99") { game.set_max_energy_to(99); }
    });
}

// ---------------------------------------------------------------------------
// Entry points
// ---------------------------------------------------------------------------

fn ctor() {
    log::subscriber().to_file("/tmp/sts2-trainer.log").truncate().with_max_level("debug").init();
}

fn stub_main() {
    log::info("STS2 trainer starting — waiting for CoreCLR...");

    let rt = match godot::init(9) {
        Ok(r) => r,
        Err(e) => {
            log::info("CLR init failed: {}", e);
            return;
        }
    };
    log::info("CoreCLR attached (.NET 9)");

    let game: Option<GameMethods> = None;
    let game_error: Option<str> = None;
    let state = new_ui_state();

    gui::run("STS2 Trainer", |ui| {
        // Lazy init — resolve methods after CLR is ready.
        if game.is_none() && game_error.is_none() {
            match GameMethods::init(rt) {
                Ok(g) => { game = Some(g); }
                Err(e) => {
                    log::info("init error: {}", e);
                    game_error = Some(e);
                }
            }
        }

        match game_error {
            Some(msg) => {
                ui.heading("STS2 Trainer");
                ui.separator();
                ui.label(fmt::format("Init error: {}", msg));
                ui.small("Check /tmp/sts2-trainer.log for details");
                return;
            }
            None => {}
        }

        let g = match game {
            Some(g) => g,
            None => {
                ui.heading("STS2 Trainer");
                ui.separator();
                ui.label("Initializing...");
                return;
            }
        };

        if !g.in_game() {
            ui.heading("STS2 Trainer");
            ui.separator();
            ui.small("Waiting for player (start a run)...");
            return;
        }

        ui.heading("STS2 Trainer");
        ui.separator();
        draw_status(ui, g);
        ui.separator();
        draw_combat(ui, g);
        ui.separator();
        draw_gold(ui, g, state);
        ui.separator();
        draw_player(ui, g);
    });
}
