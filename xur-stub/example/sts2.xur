// Slay the Spire 2 inspector — Godot + CoreCLR (.NET 9) game analysis.
//
// Loads into the game via LD_PRELOAD, lists loaded modules, finds
// CoreCLR and the game's managed assemblies, and prints process info.
//
//     cargo build --release -p xur-stub --features godot
//     # Steam > Slay the Spire 2 > Properties > Launch options:
//     XUR_STUB_PATH=xur-stub/example/sts2.xur \
//         LD_PRELOAD=target/release/libxur_stub.so %command%

use std::io;
use std::fmt;
use std::fs;
use std::re::proc;
use std::stub::tracing;

fn ctor() {
    tracing::register("file", "/tmp/sts2-xur.log", "debug");
}

fn main() -> Result<()> {
    let pid = proc::current_pid();
    io::println("[sts2] pid {}", pid);

    let handle = proc::open_current()?;
    let modules = handle.modules()?;
    io::println("[sts2] {} modules loaded", modules.len());

    // Find CoreCLR, the game binary, and GodotSharp.
    let coreclr_base = 0;
    let game_base = 0;
    let game_name = "";
    for m in modules {
        if m.name == "libcoreclr.so" {
            coreclr_base = m.base;
            io::println("[sts2] CoreCLR at 0x{} ({} bytes)", m.base.to_hex(), m.size);
        }
        if m.name == "SlayTheSpire2" || m.name.starts_with("SlayTheSpire2") {
            game_base = m.base;
            game_name = m.name;
            io::println("[sts2] game binary: {} at 0x{} ({} bytes)",
                m.name, m.base.to_hex(), m.size);
        }
    }

    // List game-related shared libs.
    io::println("[sts2] game-related modules:");
    for m in modules {
        if m.name.contains("Godot") || m.name.contains("coreclr")
            || m.name.contains("hostfxr") || m.name.contains("hostpolicy")
            || m.name.contains("fmod") || m.name.contains("spine")
            || m.name.contains("sentry") || m.name.contains("steam") {
            io::println("  {} 0x{} ({} bytes)", m.name, m.base.to_hex(), m.size);
        }
    }

    // The data directory holds .NET assemblies and the game DLL.
    let data_dir = "/games/SteamLibrary/steamapps/common/Slay the Spire 2/data_sts2_linuxbsd_x86_64";

    // List managed assemblies (.dll files).
    let files = fs::read_dir(data_dir)?;
    let dlls = files.filter(|f| f.ends_with(".dll"));
    io::println("[sts2] {} managed assemblies in data dir:", dlls.len());
    for dll in dlls {
        io::println("  {}", dll);
    }

    // Read sts2.runtimeconfig.json if available.
    let config_path = data_dir + "/sts2.runtimeconfig.json";
    if fs::exists(config_path) {
        let config = fs::read_to_string(config_path)?;
        io::println("[sts2] runtime config:");
        io::println("{}", config);
    }

    // Read the game binary's ELF header.
    if game_base != 0 {
        let header = handle.read(game_base, 16)?;
        io::println("[sts2] {} header: {}", game_name, header.to_hex());
    }

    if coreclr_base == 0 {
        io::println("[sts2] CoreCLR not found — game may not have started managed code yet");
    }

    // Memory map summary.
    io::println("[sts2] full module list:");
    for m in modules {
        io::println("  {} 0x{} ({} bytes)", m.name, m.base.to_hex(), m.size);
    }

    Ok(())
}
