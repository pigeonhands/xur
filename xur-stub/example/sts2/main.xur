// Slay the Spire 2 trainer — Godot + CoreCLR (.NET 9) game mod with
// in-game egui overlay.
//
//     cargo build --release -p xur-stub
//     # Steam > Slay the Spire 2 > Properties > Launch options:
//     XUR_STUB_PATH=xur-stub/example/sts2/main.xur \
//         LD_PRELOAD=target/release/libxur_stub.so %command%

use std::gui;
use std::stub::overlay::egui;
use std::stub::godot;
use std::stub::coreclr;
use std::log;
use std::fmt;

const proxies = std::import("./proxies.xur");
const draw = std::import("./ui.xur");
const catalog = std::import("./catalog.xur");
use proxies::Tab;

// The resolved game proxies, built once the CoreCLR runtime and game models
// are ready. GameState/Combat are required; the helpers are optional (a
// resolution failure logs and leaves that feature unavailable).
struct Trainer {
    game: proxies::GameState
    combat: proxies::Combat
    cards: Option<proxies::CardHelper>
    catalog: Option<catalog::CardCatalog>
    relics: Option<proxies::RelicHelper>
    relic_catalog: Option<catalog::RelicCatalog>
}

impl Trainer {
    fn init(rt: coreclr::Runtime, state: proxies::UiState) -> Result<Trainer> {
        let game = proxies::GameState::init(rt)?;
        let combat = proxies::Combat::init(rt)?;
        combat.install_auto_draw_hook(rt, state);
        // JIT-compile the IEnumerable helper now, off the game thread, so the
        // catalog builds (which call coreclr::enumerate on the game thread) can
        // use it. Best-effort: on failure catalogs just stay empty.
        match coreclr::warm_enumerate() {
            Ok(()) => {}
            Err(e) => { log::info(fmt::format("warm_enumerate error: {}", e)); }
        }
        let cards = match proxies::CardHelper::init(rt) {
            Ok(c) => Some(c),
            Err(e) => { log::info(fmt::format("CardHelper init error: {}", e)); None }
        };
        let card_catalog = match catalog::CardCatalog::init(rt) {
            Ok(c) => Some(c),
            Err(e) => { log::info(fmt::format("CardCatalog init error: {}", e)); None }
        };
        let relics = match proxies::RelicHelper::init(rt) {
            Ok(r) => Some(r),
            Err(e) => { log::info(fmt::format("RelicHelper init error: {}", e)); None }
        };
        let relic_catalog = match catalog::RelicCatalog::init(rt) {
            Ok(r) => Some(r),
            Err(e) => { log::info(fmt::format("RelicCatalog init error: {}", e)); None }
        };
        Ok(Trainer {
            game: game, combat: combat, cards: cards, catalog: card_catalog,
            relics: relics, relic_catalog: relic_catalog,
        })
    }
}

fn ctor() {
    log::subscriber().to_file("/tmp/sts2-trainer.log").truncate().with_max_level(log::Level::Debug).init();
    egui::init();
    egui::set_scale(0.75);
    godot::intercept_process("sts2.dll", "MegaCrit.Sts2.Core.Nodes.NRun", "_Process");
}

fn stub_main() {
    log::info("STS2 trainer starting — waiting for CoreCLR...");

    let rt = match godot::init(9) {
        Ok(r) => r,
        Err(e) => {
            log::info(fmt::format("CLR init failed: {}", e));
            return;
        }
    };

    let visible = true;
    let f1_down = false;
    let trainer: Option<Trainer> = None;
    let init_error: Option<str> = None;
    let state = proxies::UiState::new();

    egui::run(|ctx| {
        let f1 = ctx.key("f1");
        if f1 && !f1_down {
            visible = !visible;
        }
        f1_down = f1;

        if !visible { return; }

        // Process pending portrait uploads outside window_sized to avoid
        // re-entrant native object Mutex deadlock.
        draw::process_pending_portraits(ctx, state);
        draw::process_pending_relic_icons(ctx, state);

        if trainer.is_none() && init_error.is_none() {
            match Trainer::init(rt, state) {
                Ok(t) => { trainer = Some(t); }
                Err(e) => {
                    log::info(fmt::format("trainer init error: {}", e));
                    init_error = Some(e);
                }
            }
        }

        // Preload card portraits in the background once a run is active (not
        // during startup — readback needs the renderer and card models up),
        // a few per frame so the Cards tab is ready without a freeze.
        match trainer {
            Some(t) => {
                let in_run = match t.game.in_game() { Ok(v) => v, Err(_) => false };
                if in_run {
                    match t.catalog {
                        Some(cat) => {
                            catalog::seed_preload(cat, state);
                            catalog::drive_preload(cat, state, 8);
                        }
                        None => {}
                    }
                }
            }
            None => {}
        }

        ctx.window_sized("STS2 Trainer", 380.0, |win| {
            match init_error {
                Some(msg) => {
                    win.colored_label(255, 80, 80, "init error:");
                    win.small(msg);
                    return;
                }
                None => {}
            }

            let t = match trainer {
                Some(t) => t,
                None => {
                    win.small("waiting for CoreCLR runtime...");
                    return;
                }
            };
            let g = t.game;
            let c = t.combat;

            let in_game = match g.in_game() { Ok(v) => v, Err(_) => false };
            if !in_game {
                win.small("not in game (start a run)");
                state.player_addr.set(0);
                return;
            }

            match g.player() {
                Ok(p) => { state.player_addr.set(p.address()); }
                Err(_) => { state.player_addr.set(0); }
            }
            draw::draw_status(win, g, c);
            win.separator();

            let tab = state.tab.get();
            win.horizontal(|row| {
                if row.selectable(tab == Tab::Combat, "Combat") { state.tab.set(Tab::Combat); }
                if row.selectable(tab == Tab::Cards,  "Cards")  { state.tab.set(Tab::Cards); }
                if row.selectable(tab == Tab::Gold,   "Gold")   { state.tab.set(Tab::Gold); }
                if row.selectable(tab == Tab::Player, "Player") { state.tab.set(Tab::Player); }
                if row.selectable(tab == Tab::Relics, "Relics") { state.tab.set(Tab::Relics); }
            });
            win.separator();

            match state.tab.get() {
                Tab::Combat => { draw::draw_combat(win, g, c, state); }
                Tab::Cards  => {
                    match t.cards {
                        Some(ch) => {
                            match t.catalog {
                                Some(cat) => { draw::draw_cards(win, g, c, ch, cat, state); }
                                None => { win.small("card catalog not available (check log)"); }
                            }
                        }
                        None => { win.small("card helper not available (check log)"); }
                    }
                }
                Tab::Gold   => { draw::draw_gold(win, g, state); }
                Tab::Player => { draw::draw_player(win, g); }
                Tab::Relics => {
                    match t.relics {
                        Some(rh) => {
                            match t.relic_catalog {
                                Some(rc) => { draw::draw_relics(win, rh, rc, state); }
                                None => { win.small("relic catalog not available (check log)"); }
                            }
                        }
                        None => { win.small("relic helper not available (check log)"); }
                    }
                }
            }
        });
    });
}
