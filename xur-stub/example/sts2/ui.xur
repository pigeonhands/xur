use std::fmt;
use std::gui;
use std::log;
use std::stub::coreclr;
use std::stub::overlay::egui;
use std::stub::godot;

const proxies = std::import("./proxies.xur");
const catalog = std::import("./catalog.xur");

pub fn draw_status(ui: gui::Ui, game: proxies::GameState, combat: proxies::Combat) {
    match game.creature() {
        Ok(c) => {
            if !c.is_null() {
                combat.player_creature_addr.set(c.address());
            }
            let hp = combat.hp(c);
            let max = combat.max_hp(c);
            let blk = combat.block(c);
            if hp >= 0 {
                ui.label(fmt::format("HP: {}/{} | Block: {}", hp, max, blk));
            }
        }
        Err(e) => { ui.small(fmt::format("creature error: {}", e)); }
    }

    match game.combat_state() {
        Ok(pcs) => {
            let energy = combat.energy(pcs);
            let max_e = combat.max_energy(pcs);
            if energy >= 0 {
                ui.label(fmt::format("Energy: {}/{} | Stars: {}", energy, max_e, combat.stars(pcs)));
            }

            let hand = match combat.hand_count(pcs) { Ok(c) => c, Err(_) => -1 };
            let draw = match combat.draw_pile_count(pcs) { Ok(c) => c, Err(_) => -1 };
            let disc = match combat.discard_count(pcs) { Ok(c) => c, Err(_) => -1 };
            if hand >= 0 {
                ui.label(fmt::format("Hand: {} | Draw: {} | Discard: {}", hand, draw, disc));
            }
        }
        Err(e) => { ui.small(fmt::format("combat_state error: {}", e)); }
    }

    match game.gold() {
        Ok(g) => { ui.label(fmt::format("Gold: {}", g)); }
        Err(e) => { ui.small(fmt::format("gold error: {}", e)); }
    }
}

pub fn draw_combat(ui: gui::Ui, game: proxies::GameState, combat: proxies::Combat, state: proxies::UiState) {
    let godmode = combat.is_godmode();
    let new_godmode = ui.checkbox(godmode, "Godmode");
    if new_godmode != godmode {
        combat.set_godmode(new_godmode);
    }

    let auto_draw = state.auto_draw.get();
    let new_auto_draw = ui.checkbox(auto_draw, "Draw card on play");
    if new_auto_draw != auto_draw {
        state.auto_draw.set(new_auto_draw);
    }

    match game.creature() {
        Ok(c) => {
            ui.horizontal(|row| {
                if row.button("Full heal") { combat.full_heal(c); }
                if row.button("+50 Block") { combat.add_block(c, 50); }
                if row.button("+999 Block") { combat.add_block(c, 999); }
            });
        }
        Err(e) => { ui.small(fmt::format("creature error: {}", e)); }
    }

    match game.combat_state() {
        Ok(pcs) => {
            ui.horizontal(|row| {
                if row.button("Max energy") {
                    match combat.max_energy(pcs) {
                        Ok(m) => { if m > 0 { combat.set_energy(pcs, m); } }
                        Err(_) => {}
                    }
                }
                if row.button("+5 Energy") { combat.add_energy(pcs, 5); }
                if row.button("+99 Energy") { combat.add_energy(pcs, 99); }
            });

            ui.horizontal(|row| {
                if row.button("+10 Stars") { combat.add_stars(pcs, 10); }
                if row.button("+100 Stars") { combat.add_stars(pcs, 100); }
            });
        }
        Err(e) => { ui.small(fmt::format("combat_state error: {}", e)); }
    }
}

pub fn process_pending_portraits(ctx: gui::Ctx, state: proxies::UiState) {
    let pending = state.take_pending_portraits();
    // Each upload submits to the GPU and waits on a fence, so cap per-frame to
    // avoid a hard hitch (smaller = smoother but slower to fill); 4 keeps the
    // combat-enter frame responsive while still draining over a few seconds.
    let max = 4;
    let i = 0;
    let deferred = [];
    for p in pending {
        if i >= max {
            deferred.push(p);
        } else {
            let name = fmt::format("card_{}", p.id);
            match ctx.load_texture_rgba(name, p.width, p.height, p.data) {
                Ok(id) => {
                    state.cache_portrait(p.id, id, p.width, p.height);
                }
                Err(e) => {
                    log::info(fmt::format("portrait upload err: {}", e));
                }
            }
            i += 1;
        }
    }
    if deferred.len() > 0 {
        for d in deferred {
            state.push_pending_portrait(d);
        }
    }
}

fn draw_pile_cards(ui: gui::Ui, ch: proxies::CardHelper, cat: catalog::CardCatalog, state: proxies::UiState, cards: [proxies::CardInfo], label: str, grid_id: str) {
    if cards.len() == 0 {
        ui.small(fmt::format("{}: empty", label));
        return;
    }
    ui.label(fmt::format("{} ({})", label, cards.len()));
    ui.scroll(label, 200.0, |scroll| {
        scroll.grid(grid_id, 2, |g| {
            for card in cards {
                // Portraits are preloaded from the stable catalog and keyed by
                // the card's stable id; a combat card maps to it via get_Id.
                let id = cat.card_id(card.obj);
                match state.find_portrait(id) {
                    Some(cached) => {
                        g.image(cached.tex_id, 63.0, 48.0);
                    }
                    None => {
                        g.label("...");
                    }
                }
                g.label(card.title);
                g.end_row();
            }
        });
    });
}

pub fn draw_cards(ui: gui::Ui, game: proxies::GameState, combat: proxies::Combat, ch: proxies::CardHelper, cat: catalog::CardCatalog, state: proxies::UiState) {

    let pcs = match game.combat_state() { Ok(v) => v, Err(e) => { ui.small(fmt::format("error: {}", e)); return; } };
    if pcs.is_null() {
        ui.small("not in combat");
        return;
    }
    let p = match game.player() { Ok(v) => v, Err(_) => { return; } };

    ui.horizontal(|row| {
        if row.button("Draw 1") { combat.draw_cards(p, 1); }
        if row.button("Draw 3") { combat.draw_cards(p, 3); }
        if row.button("Draw 5") { combat.draw_cards(p, 5); }
    });
    // Opens the game's own card-removal picker (same flow as a shop/reward purge).
    if ui.button("Remove Card") { ch.open_card_removal(p); }
    ui.separator();

    let hand_cards = match ch.pile_cards(combat.hand_pile(pcs)) { Ok(v) => v, Err(_) => [] };
    draw_pile_cards(ui, ch, cat, state, hand_cards, "Hand", "hand_grid");

    ui.separator();

    let draw_cards = match ch.pile_cards(combat.draw_pile(pcs)) { Ok(v) => v, Err(_) => [] };
    draw_pile_cards(ui, ch, cat, state, draw_cards, "Draw Pile", "drawpile_grid");

    ui.separator();

    let disc_cards = match ch.pile_cards(combat.discard_pile(pcs)) { Ok(v) => v, Err(_) => [] };
    draw_pile_cards(ui, ch, cat, state, disc_cards, "Discard", "discard_grid");
}

pub fn draw_gold(ui: gui::Ui, game: proxies::GameState, state: proxies::UiState) {
    match game.gold() {
        Ok(gold) => {
            ui.heading(fmt::format("Gold: {}", gold));
            let new_amount = ui.slider_int("Amount", state.gold_amount.get(), 0, 99999);
            state.gold_amount.set(new_amount);
            ui.horizontal(|row| {
                if row.button("Set") { game.set_gold_to(state.gold_amount.get()); }
                if row.button("+1k") { game.set_gold_to(gold + 1000); }
                if row.button("+10k") { game.set_gold_to(gold + 10000); }
            });
        }
        Err(e) => { ui.small(fmt::format("gold error: {}", e)); }
    }
}

pub fn draw_player(ui: gui::Ui, game: proxies::GameState) {
    match game.max_energy() {
        Ok(me) => {
            ui.label(fmt::format("Max Energy: {}", me));
            ui.horizontal(|row| {
                if row.button("Set 5") { game.set_max_energy_to(5); }
                if row.button("Set 10") { game.set_max_energy_to(10); }
                if row.button("Set 99") { game.set_max_energy_to(99); }
            });
        }
        Err(e) => { ui.small(fmt::format("energy error: {}", e)); }
    }
}

fn request_relic_icon(rc: catalog::RelicCatalog, relic: proxies::CatalogRelic, state: proxies::UiState) {
    if state.is_relic_icon_requested(relic.id) { return; }
    state.mark_relic_icon_requested(relic.id);
    let pool_idx = relic.pool_idx;
    let elem_idx = relic.elem_idx;
    let id = relic.id;
    godot::dispatch(|| {
        match rc.relic_icon_at(pool_idx, elem_idx, id) {
            Some(pending) => { state.push_pending_relic_icon(pending); }
            None => {}
        }
    });
}

pub fn process_pending_relic_icons(ctx: gui::Ctx, state: proxies::UiState) {
    let pending = state.take_pending_relic_icons();
    let max = 3;
    let i = 0;
    let deferred = [];
    for p in pending {
        if i >= max {
            deferred.push(p);
        } else {
            let name = fmt::format("relic_{}", p.id);
            match ctx.load_texture_rgba(name, p.width, p.height, p.data) {
                Ok(tex_id) => {
                    state.cache_relic_icon(p.id, tex_id, p.width, p.height);
                }
                Err(e) => {
                    log::info(fmt::format("relic icon upload err: {}", e));
                }
            }
            i += 1;
        }
    }
    if deferred.len() > 0 {
        for d in deferred {
            state.push_pending_relic_icon(d);
        }
    }
}

pub fn draw_relics(ui: gui::Ui, rh: proxies::RelicHelper, rc: catalog::RelicCatalog, state: proxies::UiState) {
    let current = rh.current_relics();
    ui.label(fmt::format("Current Relics ({})", current.len()));
    if current.len() == 0 {
        ui.small("no relics");
    } else {
        ui.scroll("current_relics", 150.0, |scroll| {
            scroll.grid("cur_relics_grid", 2, |g| {
                for relic in current {
                    match state.find_relic_icon(relic.id) {
                        Some(cached) => {
                            g.image(cached.tex_id, 32.0, 32.0);
                        }
                        None => {
                            g.label("...");
                        }
                    }
                    // Description comes from the catalog's id->desc map (resolved
                    // on the game thread); "" until the catalog has built.
                    let tip = match state.relic_descs.get(relic.id) { Some(d) => d, None => "" };
                    g.hover_text(tip, |h| { h.label(relic.name); });
                    g.end_row();
                }
            });
        });
    }

    ui.separator();
    ui.label("Add Relic");
    let filter = ui.text_edit(state.relic_filter.get());
    state.relic_filter.set(filter);
    let filter_lower = filter.to_lower();

    let all = state.relic_catalog.get();
    if all.len() == 0 {
        if !state.relic_catalog_built.get() {
            state.relic_catalog_built.set(true);
            godot::dispatch(|| {
                let relics = rc.all_relics();
                if relics.len() > 0 {
                    for r in relics {
                        state.relic_descs.insert(r.id, r.desc);
                    }
                    state.relic_catalog.set(relics);
                    log::info(fmt::format("catalog: {} relics", relics.len()));
                    let r0 = relics[0];
                    log::info(fmt::format("sample relic desc: id={} desc=\"{}\"", r0.id, r0.desc));
                }
            });
        }
        ui.small("Loading relic catalog...");
        return;
    }
    ui.scroll("all_relics", 250.0, |scroll| {
        scroll.grid("all_relics_grid", 3, |g| {
            for relic in all {
                if filter != "" && !relic.name.to_lower().contains(filter_lower) {
                    continue;
                }
                match state.find_relic_icon(relic.id) {
                    Some(cached) => {
                        g.image(cached.tex_id, 32.0, 32.0);
                    }
                    None => {
                        request_relic_icon(rc, relic, state);
                        g.label("...");
                    }
                }
                g.hover_text(relic.desc, |h| { h.label(relic.name); });
                if g.button("Add") {
                    rc.add_relic(rh, relic.id);
                }
                g.end_row();
            }
        });
    });
}
