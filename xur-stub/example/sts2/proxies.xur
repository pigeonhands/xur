}

pub struct RelicHelper {
    get_player_relics: coreclr::MethodPtr
    get_title: coreclr::MethodPtr
    get_formatted_text: coreclr::MethodPtr
    get_id: coreclr::MethodPtr
    get_entry: coreclr::MethodPtr
    to_mutable: coreclr::MethodPtr
    relic_obtain: coreclr::MethodPtr
    task_run_safely: coreclr::MethodPtr
    get_rm_instance: coreclr::MethodPtr
    get_state: coreclr::MethodPtr
    get_players: coreclr::MethodPtr
}

pub struct RelicInfo {
    pub obj: coreclr::ManagedObject
    pub name: str
    pub id: str
}

pub enum Tab {
    Combat
    Cards
    Gold
    Player
    Relics
}

struct CachedPortrait {
    id: str
    tex_id: gui::Texture
    width: i32
    height: i32
}

struct CachedRelicIcon {
    id: str
    tex_id: gui::Texture
    width: i32
    height: i32
}

pub struct PendingPortrait {
    pub id: str
    pub width: i32
    pub height: i32
    pub data: bytes
}

// A catalog card with a portrait: its stable id and index into get_AllCards.
pub struct CardEntry {
    pub id: str
    pub index: i32
}

pub struct PendingRelicIcon {
    pub id: str
    pub width: i32
    pub height: i32
    pub data: bytes
}

pub struct CatalogRelic {
    pub name: str
    pub id: str
    pub pool_idx: i32
    pub elem_idx: i32
}

pub struct UiState {
    tab: cell::Cell<Tab>
    gold_amount: cell::Cell<i32>
    energy_amount: cell::Cell<i32>
    auto_draw: cell::Cell<bool>
    player_addr: cell::Cell<i64>
    portraits: cell::Cell<[CachedPortrait]>
    pending: cell::Cell<[PendingPortrait]>
    requested: cell::Cell<[str]>
    card_preload_queue: cell::Cell<[CardEntry]>
    card_preload_seeded: cell::Cell<bool>
    relic_filter: cell::Cell<str>
    relic_catalog: cell::Cell<[CatalogRelic]>
    relic_catalog_built: cell::Cell<bool>
    relic_icons_requested: cell::Cell<[str]>
    relic_icons: cell::Cell<[CachedRelicIcon]>
    relic_icons_pending: cell::Cell<[PendingRelicIcon]>
}

impl GameState {
    pub fn init(rt: coreclr::Runtime) -> Result<GameState> {
        let asm = "sts2";
        let rm_t = "MegaCrit.Sts2.Core.Runs.RunManager";
        let rs_t = "MegaCrit.Sts2.Core.Runs.RunState";
        let player_t = "MegaCrit.Sts2.Core.Entities.Players.Player";

        log::info("resolving GameState...");
        let get_rm_instance = rt.method(asm, rm_t, "get_Instance")?;
        log::info(fmt::format("  get_Instance @ {}", get_rm_instance.address()));
        let get_state = rt.method(asm, rm_t, "get_State")?;
        let get_players = rt.method(asm, rs_t, "get_Players")?;
        let get_combat_state = rt.method(asm, player_t, "get_PlayerCombatState")?;
        let get_creature = rt.method(asm, player_t, "get_Creature")?;
        let get_gold = rt.method(asm, player_t, "get_Gold")?;
        let set_gold = rt.method(asm, player_t, "set_Gold")?;
        let get_max_energy = rt.method(asm, player_t, "get_MaxEnergy")?;
        let set_max_energy = rt.method(asm, player_t, "set_MaxEnergy")?;

        Ok(GameState {
            get_rm_instance, get_state, get_players,
            get_combat_state, get_creature,
            get_gold, set_gold, get_max_energy, set_max_energy,
        })
    }

    pub fn player(self) -> Result<coreclr::ManagedObject> {
        let rm = self.get_rm_instance.call_ptr();
        if rm.is_null() { return Ok(coreclr::null()); }
        let state = self.get_state.call_ptr(rm);
        if state.is_null() { return Ok(coreclr::null()); }
        let players_list = self.get_players.call_ptr(state);
        if players_list.is_null() { return Ok(coreclr::null()); }
        let count = players_list.read_i64(16)?;
        if count <= 0 { return Ok(coreclr::null()); }
        let items_array = players_list.deref(8);
        if items_array.is_null() { return Ok(coreclr::null()); }
        Ok(items_array.deref(16))
    }

    pub fn in_game(self) -> Result<bool> {
        Ok(!self.player()?.is_null())
    }

    pub fn creature(self) -> Result<coreclr::ManagedObject> {
        let p = self.player()?;
        if p.is_null() { return Ok(coreclr::null()); }
        Ok(self.get_creature.call_ptr(p))
    }

    pub fn combat_state(self) -> Result<coreclr::ManagedObject> {
        let p = self.player()?;
        if p.is_null() { return Ok(coreclr::null()); }
        Ok(self.get_combat_state.call_ptr(p))
    }

    pub fn gold(self) -> Result<i32> {
        let p = self.player()?;
        if p.is_null() { return Ok(-1); }
        Ok(self.get_gold.call(p))
    }

    pub fn set_gold_to(self, amount: i32) -> Result<()> {
        let p = self.player()?;
        if p.is_null() { return Ok(()); }
        let setter = self.set_gold;
        godot::dispatch(|| { setter.call(p, amount); });
        Ok(())
    }

    pub fn max_energy(self) -> Result<i32> {
        let p = self.player()?;
        if p.is_null() { return Ok(-1); }
        Ok(self.get_max_energy.call(p))
    }

    pub fn set_max_energy_to(self, amount: i32) -> Result<()> {
        let p = self.player()?;
        if p.is_null() { return Ok(()); }
        let setter = self.set_max_energy;
        godot::dispatch(|| { setter.call(p, amount); });
        Ok(())
    }
}

impl Combat {
    pub fn init(rt: coreclr::Runtime) -> Result<Combat> {
        let asm = "sts2";
        let pcs_t = "MegaCrit.Sts2.Core.Entities.Players.PlayerCombatState";
        let creature_t = "MegaCrit.Sts2.Core.Entities.Creatures.Creature";

        log::info("resolving Combat...");
        let get_energy = rt.method(asm, pcs_t, "get_Energy")?;
        let get_pcs_max_energy = rt.method(asm, pcs_t, "get_MaxEnergy")?;
        let get_stars = rt.method(asm, pcs_t, "get_Stars")?;
        let get_block = rt.method(asm, creature_t, "get_Block")?;
        let get_hp = rt.method(asm, creature_t, "get_CurrentHp")?;
        let get_max_hp = rt.method(asm, creature_t, "get_MaxHp")?;
        let set_energy = rt.method(asm, pcs_t, "set_Energy")?;
        let set_stars = rt.method(asm, pcs_t, "set_Stars")?;
        let set_block = rt.method(asm, creature_t, "set_Block")?;
        let set_hp = rt.method(asm, creature_t, "set_CurrentHp")?;
        let set_max_hp = rt.method(asm, creature_t, "set_MaxHp")?;
        let get_hand = rt.method(asm, pcs_t, "get_Hand")?;
        let get_draw_pile = rt.method(asm, pcs_t, "get_DrawPile")?;
        let get_discard_pile = rt.method(asm, pcs_t, "get_DiscardPile")?;
        let get_exhaust_pile = rt.method(asm, pcs_t, "get_ExhaustPile")?;
        let draw_card_cmd = rt.find_method(asm, "MegaCrit.Sts2.Core.Commands.CardPileCmd", "Draw", 2)?;

        log::info("installing godmode hooks...");
        let godmode = cell::new(false);
        let player_creature_addr = cell::new(0);
        let lose_hp_raw = rt.method(asm, creature_t, "LoseHpInternal")?;
        let damage_block_raw = rt.method(asm, creature_t, "DamageBlockInternal")?;
        let lose_hp_ptr = lose_hp_raw.resolve_jit();
        let damage_block_ptr = damage_block_raw.resolve_jit();
        log::info(fmt::format("LoseHpInternal: precode={} jit={}", lose_hp_raw.address(), lose_hp_ptr.address()));
        log::info(fmt::format("DamageBlockInternal: precode={} jit={}", damage_block_raw.address(), damage_block_ptr.address()));
        lose_hp_ptr.hook(|this_addr| {
            if godmode.get() && this_addr == player_creature_addr.get() { Some(0) } else { None }
        });
        damage_block_ptr.hook(|this_addr| {
            if godmode.get() && this_addr == player_creature_addr.get() { Some(0) } else { None }
        });
        log::info("godmode hooks installed");

        Ok(Combat {
            get_energy, get_pcs_max_energy, get_stars,
            get_block, get_hp, get_max_hp,
            set_energy, set_stars, set_block, set_hp, set_max_hp,
            get_hand, get_draw_pile, get_discard_pile, get_exhaust_pile,
            draw_card_cmd, godmode, player_creature_addr,
        })
    }

    pub fn install_auto_draw_hook(self, rt: coreclr::Runtime, state: UiState) {
        let cm_t = "MegaCrit.Sts2.Core.Combat.CombatManager";
        let check = rt.find_method("sts2", cm_t, "CheckForEmptyHand", 3);
        match check {
            Ok(method) => {
                let ptr = method.resolve_jit();
                log::info(fmt::format("CheckForEmptyHand: precode={} jit={}", method.address(), ptr.address()));
                let auto_draw = state.auto_draw;
                let player_addr = state.player_addr;
                let draw_cmd = self.draw_card_cmd;
                ptr.hook(|_this| {
                    if auto_draw.get() {
                        let addr = player_addr.get();
                        if addr != 0 {
                            let player = coreclr::from_address(addr);
                            godot::dispatch(|| {
                                draw_cmd.call(coreclr::null(), player);
                            });
                        }
                    }
                    None
                });
                log::info("auto-draw hook installed on CheckForEmptyHand");
            }
            Err(e) => {
                log::info(fmt::format("auto-draw hook failed: {}", e));
            }
        }
    }

    pub fn hp(self, c: coreclr::ManagedObject) -> i32 {
        if c.is_null() { return -1; }
        self.get_hp.call(c)
    }

    pub fn max_hp(self, c: coreclr::ManagedObject) -> i32 {
        if c.is_null() { return -1; }
        self.get_max_hp.call(c)
    }

    pub fn block(self, c: coreclr::ManagedObject) -> i32 {
        if c.is_null() { return -1; }
        self.get_block.call(c)
    }

    pub fn full_heal(self, c: coreclr::ManagedObject) {
        if c.is_null() { return; }
        let max = self.get_max_hp.call(c);
        let setter = self.set_hp;
        godot::dispatch(|| { setter.call(c, max); });
    }

    pub fn add_block(self, c: coreclr::ManagedObject, amount: i32) {
        if c.is_null() { return; }
        let cur = self.get_block.call(c);
        let setter = self.set_block;
        godot::dispatch(|| { setter.call(c, cur + amount); });
    }

    pub fn energy(self, pcs: coreclr::ManagedObject) -> i32 {
        if pcs.is_null() { return -1; }
        self.get_energy.call(pcs)
    }

    pub fn max_energy(self, pcs: coreclr::ManagedObject) -> i32 {
        if pcs.is_null() { return -1; }
        self.get_pcs_max_energy.call(pcs)
    }

    pub fn set_energy(self, pcs: coreclr::ManagedObject, amount: i32) {
        if pcs.is_null() { return; }
        let setter = self.set_energy;
        godot::dispatch(|| { setter.call(pcs, amount); });
    }

    pub fn add_energy(self, pcs: coreclr::ManagedObject, amount: i32) {
        if pcs.is_null() { return; }
        let cur = self.get_energy.call(pcs);
        let setter = self.set_energy;
        godot::dispatch(|| { setter.call(pcs, cur + amount); });
    }

    pub fn stars(self, pcs: coreclr::ManagedObject) -> i32 {
        if pcs.is_null() { return -1; }
        self.get_stars.call(pcs)
    }

    pub fn add_stars(self, pcs: coreclr::ManagedObject, amount: i32) {
        if pcs.is_null() { return; }
        let cur = self.get_stars.call(pcs);
        let setter = self.set_stars;
        godot::dispatch(|| { setter.call(pcs, cur + amount); });
    }

    fn pile_count(pile: coreclr::ManagedObject) -> Result<i32> {
        if pile.is_null() { return Ok(0); }
        let cards = pile.deref(8);
        if cards.is_null() { return Ok(0); }
        Ok(cards.read_i32(16)?)
    }

    pub fn hand_count(self, pcs: coreclr::ManagedObject) -> Result<i32> {
        if pcs.is_null() { return Ok(-1); }
        Combat::pile_count(self.get_hand.call_ptr(pcs))
    }

    pub fn draw_pile_count(self, pcs: coreclr::ManagedObject) -> Result<i32> {
        if pcs.is_null() { return Ok(-1); }
        Combat::pile_count(self.get_draw_pile.call_ptr(pcs))
    }

    pub fn discard_count(self, pcs: coreclr::ManagedObject) -> Result<i32> {
        if pcs.is_null() { return Ok(-1); }
        Combat::pile_count(self.get_discard_pile.call_ptr(pcs))
    }

    pub fn exhaust_count(self, pcs: coreclr::ManagedObject) -> Result<i32> {
        if pcs.is_null() { return Ok(-1); }
        Combat::pile_count(self.get_exhaust_pile.call_ptr(pcs))
    }

    pub fn hand_pile(self, pcs: coreclr::ManagedObject) -> coreclr::ManagedObject {
        if pcs.is_null() { return coreclr::null(); }
        self.get_hand.call_ptr(pcs)
    }

    pub fn draw_pile(self, pcs: coreclr::ManagedObject) -> coreclr::ManagedObject {
        if pcs.is_null() { return coreclr::null(); }
        self.get_draw_pile.call_ptr(pcs)
    }

    pub fn discard_pile(self, pcs: coreclr::ManagedObject) -> coreclr::ManagedObject {
        if pcs.is_null() { return coreclr::null(); }
        self.get_discard_pile.call_ptr(pcs)
    }

    pub fn exhaust_pile(self, pcs: coreclr::ManagedObject) -> coreclr::ManagedObject {
        if pcs.is_null() { return coreclr::null(); }
        self.get_exhaust_pile.call_ptr(pcs)
    }

    pub fn draw_cards(self, player: coreclr::ManagedObject, n: i32) {
        if player.is_null() { return; }
        let cmd = self.draw_card_cmd;
        let i = 0;
        while i < n {
            godot::dispatch(|| { cmd.call(coreclr::null(), player); });
            i += 1;
        }
    }

    pub fn set_godmode(self, enabled: bool) {
        self.godmode.set(enabled);
    }

    pub fn is_godmode(self) -> bool {
        self.godmode.get()
    }
}

impl CardHelper {
    pub fn init(rt: coreclr::Runtime) -> Result<CardHelper> {
        let asm = "sts2";
        let card_t = "MegaCrit.Sts2.Core.Models.CardModel";
        let rs_t = "MegaCrit.Sts2.Core.Runs.RunState";
        let rm_t = "MegaCrit.Sts2.Core.Runs.RunManager";

        log::info("resolving CardHelper...");
        let get_title = rt.method(asm, card_t, "get_Title")?;
        let get_portrait = rt.method(asm, card_t, "get_Portrait")?;
        let rs_remove_card = rt.method(asm, rs_t, "RemoveCard")?;
        let get_rm_instance = rt.method(asm, rm_t, "get_Instance")?;
        let get_state = rt.method(asm, rm_t, "get_State")?;

        godot::resolve_image_bindings()?;

        Ok(CardHelper { get_title, get_portrait, rs_remove_card, get_rm_instance, get_state })
    }

    pub fn card_title(self, card: coreclr::ManagedObject) -> Result<str> {
        if card.is_null() { return Ok("?"); }
        let s = self.get_title.call_ptr(card);
        if s.is_null() { return Ok("?"); }
        Ok(s.read_string()?)
    }

    pub fn pile_cards(self, pile: coreclr::ManagedObject) -> Result<[CardInfo]> {
        let result = [];
        if pile.is_null() { return Ok(result); }
        let list = pile.deref(8);
        if list.is_null() { return Ok(result); }
        let count = list.read_i32(16)?;
        if count <= 0 { return Ok(result); }
        let items = list.deref(8);
        if items.is_null() { return Ok(result); }
        let i = 0;
        while i < count {
            let card = items.deref(16 + i * 8);
            if !card.is_null() {
                let title = self.card_title(card)?;
                result.push(CardInfo { obj: card, title: title });
            }
            i += 1;
        }
        Ok(result)
    }

    pub fn inspect_remove(self, card: coreclr::ManagedObject) {
        if card.is_null() { log::info("inspect: card is null"); return; }
        let rm = self.get_rm_instance.call_ptr();
        if rm.is_null() { log::info("inspect: RunManager is null"); return; }
        let rs = self.get_state.call_ptr(rm);
        if rs.is_null() { log::info("inspect: RunState is null"); return; }
        log::info(fmt::format("inspect: rs=0x{:x} card=0x{:x}", rs.address(), card.address()));
        let i = 0;
        while i < 192 {
            match rs.read_i64(i) {
                Ok(v) => { log::info(fmt::format("  rs+0x{:x}: 0x{:x}", i, v)); }
                Err(_) => {}
            }
            i += 8;
        }
        log::info("--- card object ---");
        i = 0;
        while i < 64 {
            match card.read_i64(i) {
                Ok(v) => { log::info(fmt::format("  card+0x{:x}: 0x{:x}", i, v)); }
                Err(_) => {}
            }
            i += 8;
        }
        log::info("inspect done (RemoveCard NOT called)");
    }

    pub fn remove_card(self, card: coreclr::ManagedObject) {
        if card.is_null() { return; }
        let rm = self.get_rm_instance.call_ptr();
        if rm.is_null() { return; }
        let rs = self.get_state.call_ptr(rm);
        if rs.is_null() { return; }
        self.rs_remove_card.call(rs, card);
    }
}

impl RelicHelper {
    pub fn init(rt: coreclr::Runtime) -> Result<RelicHelper> {
        let asm = "sts2";
        let rm_t = "MegaCrit.Sts2.Core.Runs.RunManager";
        let rs_t = "MegaCrit.Sts2.Core.Runs.RunState";
        let player_t = "MegaCrit.Sts2.Core.Entities.Players.Player";
        let relic_t = "MegaCrit.Sts2.Core.Models.RelicModel";
        let model_t = "MegaCrit.Sts2.Core.Models.AbstractModel";
        let model_id_t = "MegaCrit.Sts2.Core.Models.ModelId";
        let model_db_t = "MegaCrit.Sts2.Core.Models.ModelDb";
        let relic_cmd_t = "MegaCrit.Sts2.Core.Commands.RelicCmd";
        let task_t = "MegaCrit.Sts2.Core.Helpers.TaskHelper";
        let loc_t = "MegaCrit.Sts2.Core.Localization.LocString";

        log::info("resolving RelicHelper...");

        let get_player_relics = rt.method(asm, player_t, "get_Relics")?;
        let get_title = rt.method(asm, relic_t, "get_Title")?;
        let get_formatted_text = rt.method(asm, loc_t, "GetFormattedText")?;
        let get_id = rt.method(asm, model_t, "get_Id")?;
        let get_entry = rt.method(asm, model_id_t, "get_Entry")?;
        let to_mutable = rt.method(asm, relic_t, "ToMutable")?;
        let relic_obtain = rt.find_method(asm, relic_cmd_t, "Obtain", 3)?;
        let task_run_safely = rt.method(asm, task_t, "RunSafely")?;
        godot::resolve_image_bindings()?;
        let get_rm_instance = rt.method(asm, rm_t, "get_Instance")?;
        let get_state = rt.method(asm, rm_t, "get_State")?;
        let get_players = rt.method(asm, rs_t, "get_Players")?;

        log::info("RelicHelper resolved");
        Ok(RelicHelper {
            get_player_relics, get_title, get_formatted_text,
            get_id, get_entry,
            to_mutable, relic_obtain, task_run_safely,
            get_rm_instance, get_state, get_players,
        })
    }

    fn player(self) -> coreclr::ManagedObject {
        let rm = self.get_rm_instance.call_ptr();
        if rm.is_null() { return coreclr::null(); }
        let state = self.get_state.call_ptr(rm);
        if state.is_null() { return coreclr::null(); }
        let players_list = self.get_players.call_ptr(state);
        if players_list.is_null() { return coreclr::null(); }
        let items_array = players_list.deref(8);
        if items_array.is_null() { return coreclr::null(); }
        items_array.deref(16)
    }

    fn read_list(list: coreclr::ManagedObject) -> [coreclr::ManagedObject] {
        let result = [];
        if list.is_null() { return result; }
        let count = match list.read_i32(16) { Ok(c) => c, Err(_) => 0 };
        if count <= 0 { return result; }
        let items = list.deref(8);
        if items.is_null() { return result; }
        let i = 0;
        while i < count {
            let obj = items.deref(16 + i * 8);
            if !obj.is_null() { result.push(obj); }
            i += 1;
        }
        result
    }

    pub fn relic_title(self, relic: coreclr::ManagedObject) -> str {
        if relic.is_null() { return "?"; }
        let loc = self.get_title.call_ptr(relic);
        if loc.is_null() { return "?"; }
        let s = self.get_formatted_text.call_ptr(loc);
        if s.is_null() { return "?"; }
        match s.read_string() { Ok(v) => v, Err(_) => "?" }
    }

    pub fn relic_id(self, relic: coreclr::ManagedObject) -> str {
        if relic.is_null() { return ""; }
        let model_id = self.get_id.call_ptr(relic);
        if model_id.is_null() { return ""; }
        let entry = self.get_entry.call_ptr(model_id);
        if entry.is_null() { return ""; }
        match entry.read_string() { Ok(v) => v, Err(_) => "" }
    }

    pub fn current_relics(self) -> [RelicInfo] {
        let p = self.player();
        if p.is_null() { return []; }
        let list = self.get_player_relics.call_ptr(p);
        let result = [];
        for obj in RelicHelper::read_list(list) {
            let id = self.relic_id(obj);
            result.push(RelicInfo { obj: obj, name: self.relic_title(obj), id: id });
        }
        result
    }

    // Grants a catalog relic to the player. The relic catalog lives in
    // catalog.xur (RelicCatalog); it finds the relic on the game thread and
    // calls this gameplay primitive with the fresh object — so no managed
    // pointer is held across a frame. Must run on the game thread.
    pub fn grant_relic(self, relic: coreclr::ManagedObject) {
        if relic.is_null() { return; }
        let p = self.player();
        if p.is_null() { return; }
        let m = self.to_mutable.call_ptr(relic);
        let task = self.relic_obtain.call_ptr(m, p, -1);
        self.task_run_safely.call(task);
    }
}

impl UiState {
    pub fn new() -> UiState {
        UiState {
            tab: cell::new(Tab::Combat),
            gold_amount: cell::new(9999),
            energy_amount: cell::new(10),
            auto_draw: cell::new(false),
            player_addr: cell::new(0),
            portraits: cell::new([]),
            pending: cell::new([]),
            requested: cell::new([]),
            card_preload_queue: cell::new([]),
            card_preload_seeded: cell::new(false),
            relic_filter: cell::new(""),
            relic_catalog: cell::new([]),
            relic_catalog_built: cell::new(false),
            relic_icons_requested: cell::new([]),
            relic_icons: cell::new([]),
            relic_icons_pending: cell::new([]),
        }
    }

    pub fn find_portrait(self, id: str) -> Option<CachedPortrait> {
        for entry in self.portraits.get() {
            if entry.id == id { return Some(entry); }
        }
        None
    }

    pub fn cache_portrait(self, id: str, tex_id: gui::Texture, width: i32, height: i32) {
        let cache = self.portraits.get();
        cache.push(CachedPortrait { id: id, tex_id: tex_id, width: width, height: height });
        self.portraits.set(cache);
    }

    pub fn is_portrait_requested(self, id: str) -> bool {
        for a in self.requested.get() {
            if a == id { return true; }
        }
        false
    }

    pub fn mark_portrait_requested(self, id: str) {
        let r = self.requested.get();
        r.push(id);
        self.requested.set(r);
    }

    // Seeds the preload queue once (when the catalog is first available in a
    // run). Returns true if seeding happened, false if already seeded.
    // Claims the one-time right to build the card catalog. Returns true for the
    // first caller only; set synchronously so the build can be dispatched to the
    // game thread without a second dispatch slipping in before it completes.
    pub fn start_card_preload_seeding(self) -> bool {
        if self.card_preload_seeded.get() { return false; }
        self.card_preload_seeded.set(true);
        true
    }

    pub fn set_card_preload_queue(self, cards: [CardEntry]) {
        self.card_preload_queue.set(cards);
    }

    // Removes and returns up to `budget` cards from the front of the preload
    // queue, to be extracted this frame.
    pub fn take_card_preload_batch(self, budget: i32) -> [CardEntry] {
        let queue = self.card_preload_queue.get();
        let batch = [];
        let rest = [];
        let i = 0;
        for entry in queue {
            if i < budget {
                batch.push(entry);
            } else {
                rest.push(entry);
            }
            i += 1;
        }
        self.card_preload_queue.set(rest);
        batch
    }


    pub fn push_pending_portrait(self, p: PendingPortrait) {
        let cur = self.pending.get();
        cur.push(p);
        self.pending.set(cur);
    }

    pub fn take_pending_portraits(self) -> [PendingPortrait] {
        let cur = self.pending.get();
        self.pending.set([]);
        cur
    }

    pub fn find_relic_icon(self, id: str) -> Option<CachedRelicIcon> {
        for entry in self.relic_icons.get() {
            if entry.id == id { return Some(entry); }
        }
        None
    }

    pub fn cache_relic_icon(self, id: str, tex_id: gui::Texture, width: i32, height: i32) {
        let cache = self.relic_icons.get();
        cache.push(CachedRelicIcon { id: id, tex_id: tex_id, width: width, height: height });
        self.relic_icons.set(cache);
    }

    pub fn push_pending_relic_icon(self, p: PendingRelicIcon) {
        let cur = self.relic_icons_pending.get();
        cur.push(p);
        self.relic_icons_pending.set(cur);
    }

    pub fn pending_relic_icon_count(self) -> i32 {
        self.relic_icons_pending.get().len()
    }

    pub fn take_pending_relic_icons(self) -> [PendingRelicIcon] {
        let cur = self.relic_icons_pending.get();
        self.relic_icons_pending.set([]);
        cur
    }

    pub fn is_relic_icon_requested(self, id: str) -> bool {
        for r in self.relic_icons_requested.get() {
            if r == id { return true; }
        }
        false
    }

    pub fn mark_relic_icon_requested(self, id: str) {
        let r = self.relic_icons_requested.get();
        r.push(id);
        self.relic_icons_requested.set(r);
    }
}
