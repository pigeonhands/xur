.TH XUR.STD.ENV 7 "2026-11-19" "xur 0.1.3" "Xur Manual"
.SH NAME
xur.std.env \- environment variables and process paths
.SH SYNOPSIS
.nf
use std::env;

let home = env::home_dir().unwrap();
.fi
.SH DESCRIPTION
.B std::env
provides access to environment variables and process-related paths.
.SH FUNCTIONS
.TP
.B get(name: str) -> Option<str>
Read an environment variable. Returns
.B None
if not set.
.TP
.B set(name: str, value: str) -> ()
Set an environment variable.
.TP
.B remove(name: str) -> ()
Unset an environment variable.
.TP
.B vars() -> [[str, str]]
Return all environment variables as a list of [key, value] pairs.
.TP
.B current_dir() -> Result<str>
The current working directory.
.TP
.B home_dir() -> Option<str>
The user's home directory (from
.BR $HOME ).
.TP
.B exe_path() -> Option<str>
Absolute path to the current executable.
.SH EXAMPLES
.nf
use std::env;
use std::io;

fn main() {
    env::set("MY_VAR", "hello");
    io::println("MY_VAR = {}", env::get("MY_VAR").unwrap());
    io::println("cwd: {}", env::current_dir().unwrap());
}
.fi
.SH SEE ALSO
.BR xur.std (7),
.BR xur.std.process (7)
